def deep_get(node: Any, parts: Sequence[str]) -> Any:
    current = node
    for part in parts:
        if not isinstance(current, dict) or part not in current:
            return _MISSING
        current = current[part]
    return current


def deep_set(node: dict[str, Any], parts: Sequence[str], value: Any) -> None:
    current = node
    for part in parts[:-1]:
        nxt = current.get(part)
        if not isinstance(nxt, dict):
            nxt = {}
            current[part] = nxt
        current = nxt
    current[parts[-1]] = value


def deep_delete(node: dict[str, Any], parts: Sequence[str]) -> bool:
    current = node
    for part in parts[:-1]:
        nxt = current.get(part)
        if not isinstance(nxt, dict):
            return False
        current = nxt
    return current.pop(parts[-1], _MISSING) is not _MISSING


def flatten_config(node: Any, prefix: str = "") -> dict[str, Any]:
    flat: dict[str, Any] = {}
    if isinstance(node, dict):
        for key, value in node.items():
            child = f"{prefix}.{key}" if prefix else str(key)
            if isinstance(value, dict) and value:
                flat.update(flatten_config(value, child))
            else:
                flat[child] = value
    return flat


def format_setting(value: Any) -> str:
    if value is _MISSING:
        return "(unset)"
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (list, dict)):
        return json.dumps(value, ensure_ascii=False)
    return str(value)


def coerce_setting(key: str, raw: str, default: Any) -> Any:
    text = raw.strip()
    lowered = text.lower()
    if default is None:
        if lowered in {"null", "none", "unset", ""}:
            return None
        return text
    if isinstance(default, bool):
        if lowered in {"1", "true", "yes", "on", "y"}:
            return True
        if lowered in {"0", "false", "no", "off", "n"}:
            return False
        raise ValueError(f"{key}: expected true or false")
    if isinstance(default, int):
        try:
            return int(text)
        except ValueError:
            raise ValueError(f"{key}: expected a whole number") from None
    if isinstance(default, float):
        try:
            return float(text)
        except ValueError:
            raise ValueError(f"{key}: expected a number") from None
    if isinstance(default, list):
        if text.startswith("["):
            try:
                parsed = json.loads(text)
            except json.JSONDecodeError:
                raise ValueError(f"{key}: expected a JSON array") from None
            if not isinstance(parsed, list):
                raise ValueError(f"{key}: expected a JSON array")
            return parsed
        return [part.strip() for part in text.split(",") if part.strip()]
    return text


def validate_setting(key: str, value: Any) -> None:
    if key in {"server.port"}:
        if not isinstance(value, int) or not (1 <= value <= 65535):
            raise ValueError("server.port: must be 1-65535")
    if key.endswith("temperature") and isinstance(value, (int, float)):
        if not (0 <= float(value) <= 2):
            raise ValueError(f"{key}: must be between 0 and 2")
    if key.endswith("max_tokens") and isinstance(value, int) and value < 0:
        raise ValueError(f"{key}: must be 0 or more")
    if key == "chat.history_limit" and isinstance(value, int) and value < 2:
        raise ValueError("chat.history_limit: must be at least 2")
    if key == "routing.strategy" and value not in STRATEGIES:
        raise ValueError(f"routing.strategy: choose one of {', '.join(STRATEGIES)}")
    if key in {"chat.model"} and not str(value).strip():
        raise ValueError("chat.model: must not be empty")


STRATEGIES = ("balanced", "quality", "speed", "cheap", "round-robin", "least-used")


def cmd_settings(args: argparse.Namespace) -> int:
    action = getattr(args, "action", None) or "show"
    config = load_config()
    defaults = copy.deepcopy(DEFAULT_CONFIG)
    flat_defaults = flatten_config(defaults)

    if action == "path":
        print(CONFIG_PATH)
        return 0

    if action == "get":
        if not args.key:
            die("settings get needs a key, e.g. hyperrouter settings get chat.model")
        value = deep_get(config, args.key.split("."))
        if value is _MISSING:
            die(f"unknown setting: {args.key}")
        if args.json or isinstance(value, (dict, list)) or value is None:
            print(json.dumps(value))
        else:
            print(format_setting(value))
        return 0

    if action == "set":
        if not args.key or args.value is None:
            die("usage: hyperrouter settings set <key> <value>")
        parts = args.key.split(".")
        if not parts[0] or not all(parts):
            die(f"invalid setting key: {args.key}")
        if args.key not in flat_defaults and not args.key.startswith(
                ("providers.", "routing.task_models.")):
            close = difflib.get_close_matches(args.key, sorted(flat_defaults), n=3, cutoff=0.55)
            hint = f" Did you mean: {', '.join(close)}?" if close else ""
            die(f"unknown setting: {args.key}.{hint} See `hyperrouter settings keys`.")
        default = flat_defaults.get(args.key, "")
        try:
            value = coerce_setting(args.key, args.value, default)
            validate_setting(args.key, value)
        except ValueError as exc:
            die(str(exc))
        deep_set(config, parts, value)
        save_config(config)
        print(f"{args.key} = {format_setting(value)}")
        return 0

    if action == "unset":
        if not args.key:
            die("usage: hyperrouter settings unset <key>")
        if not deep_delete(config, args.key.split(".")):
            die(f"setting is not set: {args.key}")
        save_config(config)
        current = deep_get(defaults, args.key.split("."))
        print(f"unset {args.key}" + (f" (back to default {format_setting(current)})"
                                     if current is not _MISSING else ""))
        return 0

    if action == "reset":
        if not args.yes:
            die("this resets routing/chat/usage/ui settings (accounts and providers are kept). "
                "Re-run with --yes to confirm.")
        kept = {key: config.get(key) for key in ("accounts", "providers") if key in config}
        reset = copy.deepcopy(DEFAULT_CONFIG)
        reset.update(kept)
        save_config(reset)
        print(f"Reset settings in {CONFIG_PATH} (accounts and providers kept).")
        return 0

    if action == "edit":
        editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
        if not CONFIG_PATH.exists():
            save_config(DEFAULT_CONFIG)
        return subprocess.call([editor, str(CONFIG_PATH)])

    if action == "keys":
        rows = []
        for key, default in sorted(flat_defaults.items()):
            rows.append({"key": key, "value": flatten_config(config).get(key),
                         "default": default, "type": type(default).__name__,
                         "help": SETTINGS_DOCS.get(key, "")})
        if args.json:
            print(json.dumps(rows, indent=2))
            return 0
        for row in rows:
            print(f"{row['key']:<34} {format_setting(row['value']):<24} {row['help']}")
        return 0

    # show (default)
    if args.json:
        print(json.dumps({"path": str(CONFIG_PATH), "config": config}, indent=2))
        return 0
    flat = flatten_config(config)
    section = None
    print(f"{CONFIG_PATH}")
    for key in sorted(flat_defaults):
        top = key.split(".")[0]
        if top != section:
            section = top
            print(f"\n[{section}]")
        value = flat.get(key, _MISSING)
        changed = "*" if value != flat_defaults.get(key) else " "
