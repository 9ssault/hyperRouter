    "aihubmix": "https://aihubmix.com/v1",
    "qiniu-ai": "https://api.qnaigc.com/v1",
}

# models.dev ids that are the same provider as one already in the catalog.
PROVIDER_ALIASES = {"google": "gemini"}

# Official provider APIs whose free tiers do not put your data at unusual risk.
BENIGN_TOS_PROVIDERS = {
    "groq", "gemini", "mistral", "cerebras", "nvidia", "openrouter", "vercel",
    "github-models", "ollama", "llamacpp", "lmstudio", "vllm", "scaleway",
    "ovhcloud", "nebius", "hyperbolic", "sambanova", "fireworks", "deepinfra",
    "dashscope", "moonshot", "minimax", "together", "cloudflare-ai",
}

_SKIP_MODEL_PARTS = ("embed", "embedding", "whisper", "tts", "rerank", "moderation",
                     "guard", "safety", "transcribe", "ocr-free", "image-gen")
_HIGH_TIER = ("pro", "max", "opus", "ultra", "235b", "480b", "405b", "large",
              "sonnet", "o3", "o4", "r1", "reason", "thinking", "-x-", "giant")
_LOW_TIER = ("mini", "flash", "lite", "nano", "small", "tiny", "1b", "3b", "4b",
             "7b", "8b", "9b", "edge", "instant", "air", "free")
_MAX_PER_PROVIDER = 80


def _skip_model_id(model_id: str) -> bool:
    low = model_id.lower()
    return any(part in low for part in _SKIP_MODEL_PARTS)


def _tier_scores(model_id: str, name: str, reasoning: bool) -> tuple[float, float]:
    """Cheap, deterministic quality/speed estimate from a model name."""
    low = f"{name} {model_id}".lower()
    quality = 0.68
    speed = 0.72
    if any(token in low for token in _HIGH_TIER):
        quality += 0.13
        speed -= 0.10
    if any(token in low for token in _LOW_TIER):
        quality -= 0.11
        speed += 0.14
    if reasoning:
        quality += 0.05
        speed -= 0.04
    if any(token in low for token in ("turbo", "flash", "instant", "fast")):
        speed += 0.09
    if any(token in low for token in ("vl", "vision", "multimodal")):
        quality += 0.02
    return round(clamp(quality, 0.3, 0.96), 3), round(clamp(speed, 0.25, 0.98), 3)


def _safe_float(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def _models_dev_rows(md: dict[str, Any], existing_providers: dict[str, Any]) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    """Every provider in models.dev that exposes a free ($0) model."""
    providers: dict[str, Any] = {}
    models: list[dict[str, Any]] = []
    for pid, meta in md.items():
        if not isinstance(meta, dict):
            continue
        provider = PROVIDER_ALIASES.get(pid, pid)
        current = existing_providers.get(provider) or {}
        api = str(current.get("api") or meta.get("api") or PROVIDER_API_BASES.get(pid) or "")
        if not api:
            continue
        free_models = []
        for mid, info in (meta.get("models") or {}).items():
            if not isinstance(info, dict) or _skip_model_id(str(mid)):
                continue
            cost = info.get("cost") or {}
            if _safe_float(cost.get("input"), -1) != 0 or _safe_float(cost.get("output"), -1) != 0:
                continue
            free_models.append((str(mid), info))
        if not free_models:
            continue
        env = [str(x) for x in (current.get("env") or meta.get("env") or []) if x]
        record = {
            "id": provider, "name": str(current.get("name") or meta.get("name") or provider),
            "api": api, "env": env,
            "auth": str(current.get("auth") or ("bearer" if env else "none")),
            "routable": True, "source": "models.dev",
            "free_tier": "$0 per-token pricing listed on models.dev",
            "docs": str(meta.get("doc") or ""),
        }
        merged = dict(current)
        for key, value in record.items():
            merged.setdefault(key, value)
        providers[provider] = merged
        free_models.sort(key=lambda item: (len(item[0]), item[0]))
        for mid, info in free_models[:_MAX_PER_PROVIDER]:
            limits = info.get("limit") or {}
            modalities = (info.get("modalities") or {}).get("input") or []
            tools = bool(info.get("tool_call"))
            vision = "image" in modalities
            reasoning = bool(info.get("reasoning"))
            name = str(info.get("name") or mid)
            quality, speed = _tier_scores(mid, name, reasoning)
            models.append({
                "id": f"{provider}/{mid}", "provider": provider, "model": mid,
                "name": name, "free_type": "zero-cost", "monthly_tokens": 0,
                "credit_tokens": 0,
                "tos": "ok" if provider in BENIGN_TOS_PROVIDERS else "caution",
                "pool_key": provider,
                "context": int(_safe_float(limits.get("context"), 32768) or 32768),
                "max_output": int(_safe_float(limits.get("output"), 8192) or 8192),
                "tools": tools, "vision": vision, "reasoning": reasoning,
                "structured_output": bool(info.get("structured_output", True)),
                "quality": quality, "speed": speed, "routable": True,
                "unavailable_reason": "", "source": "models.dev",
            })
    return providers, models


def _openrouter_rows() -> list[dict[str, Any]]:
    """OpenRouter publishes its price list publicly, so free models can be found
    without an account."""
    status, _, data = http_json("GET", OPENROUTER_MODELS_URL,
                                headers={"User-Agent": f"hyperrouter/{VERSION}"}, timeout=45)
    if status != 200 or not isinstance(data, dict):
        return []
    rows = []
    for item in data.get("data") or []:
        if not isinstance(item, dict):
            continue
        pricing = item.get("pricing") or {}
        if _safe_float(pricing.get("prompt"), -1) != 0 or _safe_float(pricing.get("completion"), -1) != 0:
            continue
        mid = str(item.get("id") or "")
        if not mid or _skip_model_id(mid):
            continue
        params = item.get("supported_parameters") or []
        modalities = (item.get("architecture") or {}).get("input_modalities") or []
        reasoning = "reasoning" in params or "include_reasoning" in params
        name = str(item.get("name") or mid)
        quality, speed = _tier_scores(mid, name, reasoning)
        ctx = int(_safe_float(item.get("context_length"), 32768) or 32768)
        rows.append({
            "id": f"openrouter/{mid}", "provider": "openrouter", "model": mid,
            "name": name, "free_type": "zero-cost", "monthly_tokens": 0,
            "credit_tokens": 0, "tos": "caution", "pool_key": "openrouter",
            "context": ctx, "max_output": int(min(32768, max(4096, ctx // 4))),
            "tools": "tools" in params, "vision": "image" in modalities,
            "reasoning": reasoning, "structured_output": "structured_outputs" in params,
            "quality": quality, "speed": speed, "routable": True,
            "unavailable_reason": "", "source": "openrouter",
        })
    return rows


def _omniroute_rows() -> list[dict[str, Any]]:
    """OmniRoute's curated free-tier table (free_type, quota, ToS risk)."""
    status, _, raw = http_request("GET", OMNIROUTE_CATALOG_URL, timeout=45)
    if status != 200:
        return []
    text = raw.decode("utf-8", "replace")
    field_re = re.compile(r'(\w+):\s*("(?:[^"\\]|\\.)*"|-?\d+(?:\.\d+)?|true|false)')
    rows = []
    for match in re.finditer(r"\{([^{}]+)\}", text):
        body = match.group(1)
        if "provider:" not in body or "modelId:" not in body:
            continue
        item: dict[str, Any] = {}
        for key, value in field_re.findall(body):
            if value.startswith('"'):
                try:
                    item[key] = json.loads(value)
                except json.JSONDecodeError:
                    item[key] = value.strip('"')
            elif value in ("true", "false"):
                item[key] = value == "true"
            else:
                item[key] = float(value) if "." in value else int(value)
        rows.append(item)
    return rows


def _merge_model_rows(models: dict[str, dict[str, Any]], incoming: Iterable[dict[str, Any]],
                      update_free_type: bool = False,
                      update_metadata: bool = True) -> int:
    """Merge incoming models. New ids are added; existing rows only take the
    fields the source actually knows better."""
    added = 0
    metadata_keys = {"quality", "speed", "context", "max_output", "tools", "vision",
                     "reasoning", "structured_output", "name"}
    quota_keys = {"free_type", "tos", "monthly_tokens", "credit_tokens", "pool_key"}
    for row in incoming:
        mid = str(row.get("id") or "")
        if not mid:
            continue
        current = models.get(mid)
        if current is None:
            models[mid] = dict(row)
            added += 1
            continue
        if update_metadata:
            for key in metadata_keys:
                value = row.get(key)
                if value is not None and value != "":
                    current[key] = value
        for key in quota_keys:
            value = row.get(key)
            if value is None or value == "":
                continue
            if update_free_type or current.get(key) in (None, "", "unknown"):
                current[key] = value
    return added


def refresh_catalog(quiet: bool = False) -> int:
    """Rebuild the catalog from every free source this router knows about."""
    def say(message: str) -> None:
        if not quiet:
            print(message)

    old = load_catalog()
    providers: dict[str, Any] = copy.deepcopy(old.get("providers") or {})
    models: dict[str, dict[str, Any]] = {
        str(m.get("id")): dict(m) for m in old.get("models") or [] if isinstance(m, dict)
    }
    report: list[dict[str, Any]] = []

    say("Fetching OmniRoute free-tier table...")
    omni = _omniroute_rows()
    added = _merge_model_rows(models, omni_to_models(omni), update_free_type=True,
                              update_metadata=False)
    report.append({"source": "omniroute", "rows": len(omni), "added": added,
                   "ok": bool(omni), "url": "https://github.com/cheaper-inference/OmniRoute"})
    say(f"  {len(omni)} rows, {added} new models")

    say("Fetching models.dev provider metadata...")
    status, _, md = http_json("GET", MODELS_DEV_URL,
                              headers={"User-Agent": f"hyperrouter/{VERSION}"}, timeout=90)
    dev_models: list[dict[str, Any]] = []
    dev_providers: dict[str, Any] = {}
    if status == 200 and isinstance(md, dict):
        dev_providers, dev_models = _models_dev_rows(md, providers)
        providers.update(dev_providers)
        added = _merge_model_rows(models, dev_models)
        report.append({"source": "models.dev", "rows": len(dev_models), "added": added,
                       "ok": True, "url": MODELS_DEV_URL,
                       "providers": len(dev_providers)})
        say(f"  {len(dev_providers)} providers, {len(dev_models)} free models, {added} new")
    else:
        report.append({"source": "models.dev", "rows": 0, "added": 0, "ok": False,
                       "url": MODELS_DEV_URL})
        say(f"  skipped (HTTP {status})")

    say("Fetching OpenRouter free models...")
    or_rows = _openrouter_rows()
    added = _merge_model_rows(models, or_rows)
    report.append({"source": "openrouter", "rows": len(or_rows), "added": added,
                   "ok": bool(or_rows), "url": OPENROUTER_MODELS_URL})
    say(f"  {len(or_rows)} free models, {added} new")

    curated_added = _merge_model_rows(models, CURATED_MODELS, update_free_type=True)
    for pid, meta in CURATED_PROVIDERS.items():
        providers.setdefault(pid, copy.deepcopy(meta))
    report.append({"source": "curated", "rows": len(CURATED_MODELS), "added": curated_added,
                   "ok": True, "url": "built-in registry"})
    say(f"  {len(CURATED_MODELS)} curated models, {curated_added} new")

    data = {
        "schema": 2, "generated_at": utc_now(),
        "sources": [
            {"name": "models.dev", "url": MODELS_DEV_URL, "license": "MIT",
             "note": "providers and models with $0 per-token pricing"},
            {"name": "OpenRouter public model list", "url": OPENROUTER_MODELS_URL,
             "note": "models priced at $0"},
            {"name": "OmniRoute freeModelCatalog.data.ts",
             "url": "https://github.com/cheaper-inference/OmniRoute", "license": "MIT",
             "note": "free-tier type, quota and ToS risk"},
            {"name": "hyperrouter curated registry", "note": "providers missing from models.dev"},
            {"name": "local endpoints", "note": "Ollama, llama.cpp, LM Studio, vLLM"},
        ],
        "refresh": report,
        "providers": providers, "models": list(models.values()),
    }
    if not any(item["ok"] for item in report if item["source"] in {"models.dev", "openrouter", "omniroute"}):
        die("every online catalog source failed; keeping the existing catalog")
    save_catalog(data)
    routable = sum(1 for m in data["models"] if m.get("routable"))
    say(f"Saved {len(data['models'])} models ({routable} routable) from "
        f"{len(providers)} providers to {CATALOG_PATH}")
    return 0


def omni_to_models(rows: Iterable[dict[str, Any]]) -> list[dict[str, Any]]:
    """Convert OmniRoute rows into catalog models, keeping any existing detail."""
    out: list[dict[str, Any]] = []
    for row in rows:
        provider = str(row.get("provider") or "")
        model_id = str(row.get("modelId") or "")
        if not provider or not model_id:
            continue
        out.append({
            "id": f"{provider}/{model_id}", "provider": provider, "model": model_id,
            "name": str(row.get("displayName") or model_id),
            "free_type": str(row.get("freeType") or "unknown"),
            "monthly_tokens": int(row.get("monthlyTokens") or 0),
            "credit_tokens": int(row.get("creditTokens") or 0),
            "tos": str(row.get("tos") or "unknown"),
            "pool_key": str(row.get("poolKey") or provider),
            "context": int(row.get("contextWindow") or 32768),
            "max_output": int(row.get("maxTokens") or 8192),
            "tools": bool(row.get("tools", False)),
            "vision": bool(row.get("vision", False)),
            "reasoning": bool(row.get("reasoning", False)),
            "structured_output": True,
            "quality": float(row.get("quality") if isinstance(row.get("quality"), (int, float)) else 0.6),
            "speed": float(row.get("speed") if isinstance(row.get("speed"), (int, float)) else 0.6),
            "routable": bool(row.get("routable", True)),
            "unavailable_reason": "", "source": "omniroute",
        })
    return out


def cmd_sources(args: argparse.Namespace) -> int:
    catalog = load_catalog()
    providers = catalog.get("providers") or {}
    models = catalog.get("models") or []
    keys_by_source: dict[str, int] = {}
    routable_by_source: dict[str, int] = {}
    for model in models:
        source = str(model.get("source") or "unknown")
        keys_by_source[source] = keys_by_source.get(source, 0) + 1
        if model.get("routable"):
            routable_by_source[source] = routable_by_source.get(source, 0) + 1
    payload = {
        "catalog": str(CATALOG_PATH), "generated_at": catalog.get("generated_at"),
        "providers": len(providers), "models": len(models),
        "routable": sum(1 for m in models if m.get("routable")),
        "by_source": [{"source": k, "models": v, "routable": routable_by_source.get(k, 0)}
                      for k, v in sorted(keys_by_source.items(), key=lambda kv: -kv[1])],
        "sources": catalog.get("sources") or [],
        "providers_with_free_tier": [
            {"id": pid, "name": meta.get("name"), "free_tier": meta.get("free_tier"),
             "env": meta.get("env") or []}
            for pid, meta in sorted(providers.items()) if meta.get("free_tier")
        ],
        "refresh": catalog.get("refresh") or [],
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    print(f"Catalog: {payload['catalog']}")
    print(f"Generated: {payload['generated_at']}  providers={payload['providers']}  "
          f"models={payload['models']}  routable={payload['routable']}")
    print("\nModels by source:")
    for row in payload["by_source"]:
        print(f"  {row['source']:<16} {row['models']:>5} models  {row['routable']:>5} routable")
    if payload["refresh"]:
        print("\nLast refresh:")
        for item in payload["refresh"]:
            state = "ok" if item.get("ok") else "failed"
            print(f"  {item.get('source'):<16} {state:<7} rows={item.get('rows', 0):<5} "
                  f"new={item.get('added', 0)}")
    print("\nFree tiers (set the env var to enable):")
    for item in payload["providers_with_free_tier"][:60]:
        env = ",".join(item["env"]) or "keyless"
        print(f"  {item['id']:<18} {env:<30} {item['free_tier']}")
    return 0


