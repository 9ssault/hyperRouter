def cmd_run(args: argparse.Namespace) -> int:
    backend = AGENT_BACKENDS.get(args.target)
    if backend is None:
        die(f"unknown agent: {args.target} (choose from {', '.join(AGENT_BACKENDS)})")
    env = backend_env(backend)
    base_command = list(backend.get("command") or [])
    if not base_command:
        base_command = [str(backend.get("binary") or args.target)]
    if args.target == "dsh":
        base_command = ["dsh", "--profile", "headless"]
    elif args.target == "opencode":
        base_command = ["opencode"]
    command = base_command
    extra = list(args.args or [])
    if extra and extra[0] == "--":
        extra = extra[1:]
    dry_run = bool(args.dry_run)
    if "--dry-run" in extra:
        extra = [item for item in extra if item != "--dry-run"]
        dry_run = True
    command = command + extra
    executable = shutil.which(command[0])
    if executable is None and not dry_run:
        die(f"{command[0]} is not installed or not on PATH")
    if executable:
        command[0] = executable
    if args.target == "opencode" and "--standalone" not in extra:
        if opencode_service_env_state() == "missing":
            eprint("hyperrouter: warning: OpenCode's background service was started without "
                   "HYPERROUTER_API_KEY. Pass --standalone or restart OpenCode from a shell "
                   "that sourced ~/.bashrc.")
    if dry_run:
        print(f"HYPERROUTER_BASE_URL={env['HYPERROUTER_BASE_URL']} "
              f"ANTHROPIC_BASE_URL={env.get('ANTHROPIC_BASE_URL', '-')} "
              f"OPENAI_BASE_URL={env.get('OPENAI_BASE_URL', '-')} "
              f"HYPERROUTER_API_KEY=<set:{len(env['HYPERROUTER_API_KEY'])} chars> "
              f"{shlex_join(command)}")
        return 0
    ensure_service()
    os.execvpe(executable, command, env)
    return 0


def shlex_join(parts: Sequence[str]) -> str:
    import shlex
    return shlex.join(parts)


def cmd_config(args: argparse.Namespace) -> int:
    config = load_config()
    if args.action == "path":
        print(CONFIG_PATH)
        return 0
    if args.action == "show":
        print(json.dumps(config, indent=2))
        return 0
    if args.action == "set":
        if not args.key:
            die("key is required")
        value: Any = args.value
        if value is None:
            die("value is required")
        try:
            value = json.loads(value)
        except json.JSONDecodeError:
            pass
        node = config
        parts = args.key.split(".")
        for part in parts[:-1]:
            node = node.setdefault(part, {})
        node[parts[-1]] = value
        save_config(config)
        print(f"set {args.key} = {value!r}")
        return 0
    die(f"unknown config action: {args.action}")


