def cmd_delegate(args: argparse.Namespace) -> int:
    config = load_config()
    text = args.task.strip()
    if not text:
        die("give me a task to delegate")
    context_parts = []
    for path in args.context or []:
        p = Path(path).expanduser()
        if not p.is_file():
            die(f"context file not found: {p}")
        context_parts.append(f"## File: {p}\n\n{p.read_text(encoding='utf-8', errors='replace')}")
    context = "\n\n".join(context_parts)
    steps = split_task(text)[: max(1, int(args.max_steps or 8))]
    plan = []
    for index, step in enumerate(steps, 1):
        task = normalize_task(args.task_hint or step)
        limit = 1
        candidates = pick_models(task, limit=limit, strategy=args.strategy or None,
                                 need_context=estimate_tokens(step + context))
        chosen = candidates[0] if candidates else None
        plan.append({"index": index, "task": task, "step": step,
                     "model": chosen["model"]["id"] if chosen else None,
                     "score": chosen["score"] if chosen else None})
    if args.json and args.plan_only:
        print(json.dumps({"plan": plan}, indent=2))
        return 0
    if not args.json:
        print(f"Delegation plan ({len(plan)} step{'s' if len(plan) != 1 else ''}):")
        for item in plan:
            model_id = item["model"] or "(no free model available)"
            print(f"  {item['index']}. [{item['task']:<12}] {model_id}")
            print(f"     {item['step'][:110]}")
        if args.plan_only:
            return 0
    results = []
    previous: list[str] = []
    for item in plan:
        if not item["model"]:
            die(f"no free model available for step {item['index']} ({item['task']})")
        system = (chat_system_prompt(None, "You are one worker in a delegated task. "
                                     "Complete only the assigned step, then stop."))
        if getattr(args, "skill", None):
            system = "\n\n".join(x for x in [system, skill_context(args.skill)] if x.strip())
        prompt = f"Overall task:\n{text}\n\nYour step ({item['index']} of {len(plan)}):\n{item['step']}"
        if context:
            prompt += f"\n\n# Context\n{context}"
        if previous:
            prompt += "\n\n# Work already done\n" + "\n\n".join(previous)
        messages = [{"role": "system", "content": system}, {"role": "user", "content": prompt}]
        if not args.json:
            print(f"\n── step {item['index']}/{len(plan)} · {item['task']} · {item['model']} ──")
        try:
            result = route_once(messages, model=item["model"], task_hint=item["task"],
                                max_tokens=args.max_tokens or None)
        except RuntimeError as exc:
            die(f"step {item['index']} failed: {exc}")
        answer = response_text(result)
        router = result.get("x_agent_router") or {}
        results.append({"step": item["step"], "task": item["task"],
                        "model": router.get("model"), "provider": router.get("provider"),
                        "latency_ms": router.get("latency_ms"), "output": answer})
        previous.append(f"Step {item['index']} ({item['task']}):\n{answer}")
        if not args.json:
            print(answer)
            print(f"[{router.get('provider')}/{router.get('model')} · {router.get('latency_ms')}ms]")
    if args.json:
        print(json.dumps({"task": text, "plan": plan, "results": results}, indent=2))
    return 0


