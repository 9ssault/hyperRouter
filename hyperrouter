AGENT_BLOCKED_COMMANDS = (
    "rm -rf /", "rm -rf /*", "mkfs", "dd of=/dev/", ":(){:|:&};:", "> /dev/sda",
    "shutdown", "reboot", "poweroff", "chmod -R 777 /",
)


def agent_tool_specs() -> list[dict[str, Any]]:
    def spec(name: str, description: str, properties: dict[str, Any],
             required: list[str]) -> dict[str, Any]:
        return {"type": "function", "function": {"name": name, "description": description,
                                                 "parameters": {"type": "object",
                                                                "properties": properties,
                                                                "required": required}}}

    path = {"type": "string", "description": "File or directory path, relative to the working directory"}
    return [
        spec("read_file", "Read a text file with line numbers.",
             {"path": path, "start_line": {"type": "integer"},
              "end_line": {"type": "integer"}}, ["path"]),
        spec("write_file", "Create or overwrite a file. Read it first unless you are creating it.",
             {"path": path, "content": {"type": "string"}}, ["path", "content"]),
        spec("edit_file", "Replace one exact string in a file. old_string must match exactly once.",
             {"path": path, "old_string": {"type": "string"},
              "new_string": {"type": "string"},
              "replace_all": {"type": "boolean"}}, ["path", "old_string", "new_string"]),
        spec("list_dir", "List a directory.", {"path": path}, ["path"]),
        spec("search", "Search file contents (ripgrep syntax when available).",
             {"pattern": {"type": "string"}, "path": {"type": "string"},
              "glob": {"type": "string"},
              "max_results": {"type": "integer"}}, ["pattern"]),
        spec("run_command", "Run a shell command in the working directory and return its output.",
             {"command": {"type": "string"}, "timeout_seconds": {"type": "integer"}},
             ["command"]),
        spec("todo", "Replace the task list shown to the user (one entry per step).",
             {"items": {"type": "array", "items": {"type": "object", "properties": {
                 "task": {"type": "string"},
                 "status": {"type": "string", "enum": ["pending", "in_progress", "completed"]}},
                 "required": ["task", "status"]}}}, ["items"]),
    ]


def agent_system_prompt(cwd: Path, skills: Sequence[str] = ()) -> str:
    parts = [
        f"You are {PRODUCT}, a coding agent working in {cwd}.",
        "Use the tools to inspect and change the workspace. Read a file before editing it; "
        "prefer edit_file over rewriting whole files; keep shell commands small and relevant.",
        "Never claim a check passed unless you ran it. When the task is done, summarize what "
        "changed and what you verified.",
        "Track multi-step work with the todo tool.",
    ]
    agents_md = cwd / "AGENTS.md"
    if agents_md.is_file():
        parts.append("\n# Project instructions (AGENTS.md)\n" + agents_md.read_text(
            encoding="utf-8", errors="replace")[:20000])
    if skills:
        parts.append(skill_context(skills))
    return "\n\n".join(parts)


def _tool_path(raw: Any, allow_outside: bool = False) -> Path:
    path = Path(os.path.expanduser(str(raw or "."))).resolve()
    root = Path.cwd().resolve()
    if not allow_outside and path != root and root not in path.parents:
        raise ValueError(f"path is outside the working directory: {path}")
    return path


def _cap(text: str, limit: int = 12000) -> str:
    text = str(text or "")
    if len(text) <= limit:
        return text
    return text[:limit] + f"\n... ({len(text) - limit} more characters)"


def tool_read_file(args: dict[str, Any]) -> str:
    path = _tool_path(args.get("path"))
    text = path.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines()
    start = max(1, int(args.get("start_line") or 1))
    end = int(args.get("end_line") or 0) or min(len(lines), start + 599)
    end = min(end, start + 599)
    body = "\n".join(f"{number:>5}  {lines[number - 1]}" for number in range(start, min(end, len(lines)) + 1))
    return f"{path} ({len(lines)} lines)\n{body}"


def tool_write_file(args: dict[str, Any], allow_outside: bool = False) -> str:
    path = _tool_path(args.get("path"), allow_outside)
    content = str(args.get("content") or "")
    if path.exists():
        backup(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    return f"wrote {len(content)} chars to {path}"


def tool_edit_file(args: dict[str, Any], allow_outside: bool = False) -> str:
    path = _tool_path(args.get("path"), allow_outside)
    old = str(args.get("old_string") or "")
    new = str(args.get("new_string") or "")
    if not old:
        raise ValueError("old_string must not be empty")
    text = path.read_text(encoding="utf-8", errors="replace")
    count = text.count(old)
    if count == 0:
        raise ValueError("old_string was not found in the file")
    if count > 1 and not args.get("replace_all"):
        raise ValueError(f"old_string matches {count} times; add more context or set replace_all")
    backup(path)
    updated = text.replace(old, new) if args.get("replace_all") else text.replace(old, new, 1)
    path.write_text(updated, encoding="utf-8")
    return f"edited {path} ({count} replacement{'s' if count != 1 else ''}, {len(updated)} chars)"


def tool_list_dir(args: dict[str, Any]) -> str:
    path = _tool_path(args.get("path"))
    if not path.is_dir():
        raise ValueError(f"not a directory: {path}")
    entries = sorted(path.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
    rows = [f"{entry.name}{'/' if entry.is_dir() else ''}" for entry in entries[:300]]
    more = f"\n... {len(entries) - 300} more" if len(entries) > 300 else ""
    return f"{path}\n" + "\n".join(rows) + more


def tool_search(args: dict[str, Any]) -> str:
    pattern = str(args.get("pattern") or "")
    if not pattern:
        raise ValueError("pattern is required")
    path = _tool_path(args.get("path") or ".")
    limit = max(1, min(int(args.get("max_results") or 50), 300))
    rg = shutil.which("rg")
    if rg:
        command = [rg, "-n", "--no-heading", "--color", "never", "-m", str(limit), pattern, str(path)]
        if args.get("glob"):
            command[1:1] = ["-g", str(args["glob"])]
        proc = subprocess.run(command, capture_output=True, text=True, timeout=60, check=False)
        if proc.returncode not in (0, 1):
            raise ValueError(proc.stderr.strip()[:400] or "search failed")
        output = proc.stdout.strip()
        return _cap(output or "no matches", 16000)
    import re as _re
    hits: list[str] = []
    regex = _re.compile(pattern)
    for file in path.rglob("*"):
        if len(hits) >= limit or not file.is_file():
            continue
        try:
            for number, line in enumerate(file.read_text(encoding="utf-8", errors="ignore").splitlines(), 1):
                if regex.search(line):
                    hits.append(f"{file}:{number}:{line.strip()[:200]}")
                    if len(hits) >= limit:
                        break
        except OSError:
            continue
    return _cap("\n".join(hits) or "no matches", 16000)


def tool_run_command(args: dict[str, Any]) -> str:
    command = str(args.get("command") or "").strip()
    if not command:
        raise ValueError("command is required")
    lowered = command.lower().replace("  ", " ")
    if any(blocked in lowered for blocked in AGENT_BLOCKED_COMMANDS):
        raise ValueError("command blocked by the safety list")
    timeout = max(1, min(int(args.get("timeout_seconds") or 120), 600))
    proc = subprocess.run(["bash", "-lc", command], cwd=os.getcwd(), capture_output=True,
                          text=True, timeout=timeout, check=False)
    parts = [f"exit {proc.returncode}"]
    if proc.stdout.strip():
        parts.append("stdout:\n" + proc.stdout.rstrip())
    if proc.stderr.strip():
        parts.append("stderr:\n" + proc.stderr.rstrip())
    return _cap("\n".join(parts))


def execute_tool(name: str, args: dict[str, Any], approve: Any = None,
                 on_event: Any = None, allow_outside: bool = False) -> str:
    try:
        if name == "read_file":
            return tool_read_file(args)
        if name == "list_dir":
            return tool_list_dir(args)
        if name == "search":
            return tool_search(args)
        if name == "write_file":
            if approve and not approve("write", str(args.get("path"))):
                return "error: the user denied this write"
            return tool_write_file(args, allow_outside)
        if name == "edit_file":
            if approve and not approve("edit", str(args.get("path"))):
                return "error: the user denied this edit"
            return tool_edit_file(args, allow_outside)
        if name == "run_command":
            if approve and not approve("run", str(args.get("command"))):
                return "error: the user denied this command"
            return tool_run_command(args)
        if name == "todo":
            items = args.get("items") or []
            if on_event:
                on_event("todos", items)
            done = sum(1 for item in items if str(item.get("status")) == "completed")
            return f"todo list updated ({done}/{len(items)} done)"
        return (f"error: unknown tool {name!r}. Available: read_file, write_file, edit_file, "
                "list_dir, search, run_command, todo")
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        return f"error: {exc}"


def retry_after_seconds(message: str) -> int:
    match = re.search(r"retry[-_ ]after[:\s]+(\d+)", message or "", re.I)
    return int(match.group(1)) if match else 0


def response_message(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict):
        return {}
    choices = data.get("choices")
    if not isinstance(choices, list) or not choices or not isinstance(choices[0], dict):
        return {}
    message = choices[0].get("message")
    return message if isinstance(message, dict) else {}


def agent_turn(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str = "coding",
    max_rounds: int = 8,
    approve: Any = None,
    on_event: Any = None,
    allow_outside: bool = False,
    temperature: float | None = None,
    max_tokens: int | None = None,
) -> dict[str, Any]:
    """Run a tool-calling loop until the model answers or rounds run out."""
    tools = agent_tool_specs()
    emit = on_event or (lambda kind, payload: None)
    meta: dict[str, Any] = {}
    for round_index in range(max(1, max_rounds)):
        attempts = 0
        while True:
            try:
                result = route_once(messages, model=model, task_hint=task_hint,
                                    max_tokens=max_tokens, temperature=temperature, tools=tools)
                break
            except RuntimeError as exc:
                wait = retry_after_seconds(str(exc))
                if attempts < 1 and 0 < wait <= 45:
                    emit("notice", {"message": f"free-tier limit hit; waiting {wait}s"})
                    time.sleep(wait + 1)
                    attempts += 1
                    continue
                if any(message.get("role") == "tool" for message in messages):
                    return {"text": (f"I stopped after {round_index} round(s): the free pool is "
                                     f"rate limited ({exc}). The work above is what completed; "
                                     "ask again in a minute to continue."),
                            "meta": meta, "rounds": round_index, "interrupted": True}
                raise
        meta = result.get("x_agent_router") or meta
        message = response_message(result)
        text = content_to_text(message.get("content"))
        calls = message.get("tool_calls") or []
        if not calls:
            return {"text": text, "meta": meta, "rounds": round_index + 1}
        messages.append({"role": "assistant", "content": text, "tool_calls": calls})
        for call in calls:
            if not isinstance(call, dict):
                continue
            function = call.get("function") or {}
            # Some free models decorate tool names ("edit_file<|channel|>commentary",
            # "functions.edit_file"). Normalise before dispatch.
            name = re.split(r"[<\s]", str(function.get("name") or ""))[0]
            name = name.split(".")[-1].strip()
            raw_args = function.get("arguments")
            if isinstance(raw_args, str):
                try:
                    args = json.loads(raw_args) if raw_args.strip() else {}
                except json.JSONDecodeError:
                    args = {"raw": raw_args}
            elif isinstance(raw_args, dict):
                args = raw_args
            else:
                args = {}
            emit("tool", {"name": name, "arguments": args})
            output = execute_tool(name, args, approve, emit, allow_outside)
            emit("tool_result", {"name": name, "output": _cap(output, 4000)})
            messages.append({"role": "tool", "tool_call_id": str(call.get("id") or name),
                             "content": _cap(output, 12000)})
    # Out of rounds: ask for a wrap-up without tools.
    messages.append({"role": "user", "content":
                     "Stop calling tools. Summarize what you changed and what you verified."})
    try:
        result = route_once(messages, model=model, task_hint="summarization",
                            max_tokens=max_tokens)
    except RuntimeError as exc:
        return {"text": (f"Stopped after {max_rounds} tool rounds: the free pool is rate limited "
                         f"({exc}). The tool output above is what completed; raise --max-rounds "
                         "or continue in a minute."),
                "meta": meta, "rounds": max_rounds, "interrupted": True}
    meta = result.get("x_agent_router") or meta
    return {"text": response_text(result), "meta": meta, "rounds": max_rounds}


def cmd_agent(args: argparse.Namespace) -> int:
    config = load_config()
    acfg = config.get("agent") or {}
    cwd = Path(os.path.expanduser(args.cwd or os.getcwd())).resolve()
    if not cwd.is_dir():
        die(f"working directory not found: {cwd}")
    os.chdir(cwd)
    task = " ".join(args.task).strip() if isinstance(args.task, list) else str(args.task)
    if not task:
        die("give the agent a task")
    system = agent_system_prompt(cwd, getattr(args, "skill", None) or [])
    messages: list[dict[str, Any]] = [{"role": "system", "content": system},
                                      {"role": "user", "content": task}]
    state = {"auto": bool(args.auto or acfg.get("auto_approve")), "denied": 0}

    def approve(kind: str, detail: str) -> bool:
        if state["auto"]:
            return True
        if not sys.stdin.isatty():
            state["denied"] += 1
            eprint(f"{PROG}: denied {kind} (non-interactive; pass --auto): {detail}")
            return False
        print(f"\n[{kind}] {detail}")
        try:
            answer = input("allow? [y/N/a=always] ").strip().lower()
        except EOFError:
            return False
        if answer in {"a", "always"}:
            state["auto"] = True
            return True
        return answer in {"y", "yes"}

    def on_event(kind: str, payload: dict[str, Any]) -> None:
        if kind == "tool":
            print(f"  -> {payload.get('name')} "
                  f"{json.dumps(payload.get('arguments') or {}, ensure_ascii=False)[:240]}")
        elif kind == "tool_result":
            output = str(payload.get("output") or "").rstrip()
            for line in output.splitlines()[:24]:
                print(f"     {line[:200]}")
            if len(output.splitlines()) > 24:
                print("     ...")
        elif kind == "todos":
            for item in payload or []:
                mark = {"completed": "[x]", "in_progress": "[>]"}.get(str(item.get("status")), "[ ]")
                print(f"  {mark} {item.get('task')}")
        elif kind == "notice":
            print(f"  ... {payload.get('message')}")

    rounds = int(args.max_rounds or acfg.get("max_rounds") or 8)
    try:
        result = agent_turn(messages, model=args.model or "auto", task_hint=args.task_hint or "coding",
                            max_rounds=rounds, approve=approve, on_event=on_event,
                            allow_outside=bool(args.allow_outside or acfg.get("allow_outside")),
                            temperature=getattr(args, "temperature", None),
                            max_tokens=args.max_tokens or None)
    except RuntimeError as exc:
        die(str(exc))
    if args.json:
        print(json.dumps({"task": task, "result": result}, indent=2, default=str))
        return 0
    print("\n" + (result.get("text") or "(the model returned no text)"))
    meta = result.get("meta") or {}
    if meta:
        print(f"\n[{PRODUCT}: {meta.get('provider')}/{meta.get('model')} · "
              f"{result.get('rounds')} round(s) · {meta.get('latency_ms')}ms]")
    if state["denied"]:
        print(f"({state['denied']} action(s) denied - rerun with --auto to allow them)")
    return 0


