def candidate_payload(candidates: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Serialize candidates without ever exposing account credentials."""
    payload = []
    for c in candidates:
        acct = c.get("account") or {}
        payload.append({
            "rank": len(payload) + 1,
            "score": c.get("score"),
            "provider": c["model"].get("provider"),
            "model": c["model"].get("model"),
            "id": c["model"].get("id"),
            "name": c["model"].get("name"),
            "context": c["model"].get("context"),
            "free_type": c["model"].get("free_type"),
            "tos": c["model"].get("tos"),
            "quota": acct.get("quota"),
            "account": acct.get("label"),
            "reasons": c.get("reasons") or [],
            "fit": c.get("fit"), "health": c.get("health"),
            "latency": c.get("latency"), "stability": c.get("stability"),
        })
    return payload


def print_candidates(candidates: list[dict[str, Any]], as_json: bool = False) -> None:
    if as_json:
        print(json.dumps(candidate_payload(candidates), indent=2))
        return
    if not candidates:
        print("No free candidates. Set a provider key or start a local model server.")
        print("Try: hyperrouter doctor")
        return
    print(f"{'#':>2} {'score':>6} {'provider/model':<44} {'ctx':>8} {'free':<18} {'quota':>6}  why")
    for i, c in enumerate(candidates, 1):
        m = c["model"]
        acct = c.get("account") or {}
        quota = acct.get("quota") or {}
        q = quota.get("fraction")
        qtext = "unlim" if q is None or quota.get("kind") == "uncapped" else f"{q * 100:.0f}%"
        reasons = ", ".join((c.get("reasons") or [])[:3])
        print(f"{i:>2} {c.get('score', 0):>6.3f} {m.get('id',''):<44} {m.get('context',0):>8} "
              f"{str(m.get('free_type','')):<18} {qtext:>6}  {reasons}")


def normalize_task(task: str) -> str:
    """Accept either a task category (coding, chat) or a free-text request."""
    value = (task or "chat").strip()
    if value in TASK_ALIASES and TASK_ALIASES[value]:
        value = TASK_ALIASES[value] or "chat"
    if value not in TASK_WEIGHTS:
        value = classify_task(value)[0]
    return value


