def run_agent(name: str, prompt: str, timeout: float = 300.0,
              session: str | None = None) -> str:
    """Drive another agent CLI in one-shot mode and return its answer."""
    backend = AGENT_BACKENDS.get(name)
    if not backend:
        raise RuntimeError(f"unknown agent: {name}")
    if backend.get("in_process"):
        # Freebuff ships no non-interactive mode. Answer in-process with the same
        # free models its BYOK connection points at, so its TUI never opens.
        ensure_service()
        system = chat_full_system(None, "You are Freebuff, a coding assistant. "
                                        "Answer directly and keep tool use minimal.", [])
        result = route_once([{"role": "system", "content": system},
                            {"role": "user", "content": prompt}], model="auto")
        return response_text(result)
    if not backend.get("headless"):
        raise RuntimeError(f"{name} has no headless mode; use `{PROG} run {name}` for its UI, "
                           f"or chat here for the same free models")
    command = list(backend["command"])
    if not shutil.which(command[0]):
        # Fall back to the npm package instead of demanding a global install.
        package = str(backend.get("npx") or "")
        if package and shutil.which("npx"):
            command = ["npx", "-y", package] + command[1:]
        else:
            raise RuntimeError(f"{command[0]} is not installed or not on PATH"
                               + (f" (or run it with: npx -y {package})" if package else ""))
    if name == "opencode" and session:
        command += ["--session", session]
    command.append(prompt)
    ensure_service()
    try:
        proc = subprocess.run(command, capture_output=True, text=True, timeout=timeout,
                              env=backend_env(backend), cwd=os.getcwd(), check=False)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"{name} timed out after {timeout:.0f}s") from None
    output = (proc.stdout or "").strip()
    if not output:
        output = (proc.stderr or "").strip()
    if proc.returncode != 0 and not output:
        raise RuntimeError(f"{name} exited with {proc.returncode}")
    return output


def agent_available(backend: dict[str, Any]) -> bool:
    command = list(backend.get("command") or [])
    binary = backend.get("binary") or (command[0] if command else "")
    if backend.get("in_process"):
        return True
    if binary and shutil.which(binary):
        return True
    return bool(backend.get("npx") and shutil.which("npx"))


def check_agent(name: str, timeout: float = 120.0) -> dict[str, Any]:
    """Prove a harness end-to-end: our proxy answers, its flags work, we parse output."""
    prompt = "Reply with exactly the word pong and nothing else."
    started = time.monotonic()
    record: dict[str, Any] = {"agent": name, "ok": False, "latency_ms": 0,
                              "checked_at": utc_now()}
    try:
        answer = run_agent(name, prompt, timeout=timeout)
        record.update(ok="pong" in answer.lower(), output=answer.strip()[:200])
        if not record["ok"]:
            record["error"] = "answered, but not with pong"
    except (RuntimeError, OSError) as exc:
        record["error"] = redact(str(exc))[:300]
    record["latency_ms"] = int((time.monotonic() - started) * 1000)
    return record


def cmd_agents(args: argparse.Namespace) -> int:
    config = load_config()
    stored = config.get("agent_checks") if isinstance(config.get("agent_checks"), dict) else {}
    target = getattr(args, "test", None)
    if target is not None:
        names = [target] if target else [name for name, backend in AGENT_BACKENDS.items()
                                         if agent_available(backend)]
        if not names:
            print("no agent harness is installed; install one or use the built-in free pool")
            return 1
        failures = 0
        for name in names:
            if name not in AGENT_BACKENDS:
                print(f"unknown agent: {name}", file=sys.stderr)
                return 2
            print(f"testing {name} ...", flush=True)
            record = check_agent(name)
            stored[name] = record
            state = "ok" if record["ok"] else "FAILED"
            print(f"  {state}  {record['latency_ms']} ms  {record.get('output') or record.get('error')}")
            failures += 0 if record["ok"] else 1
        config["agent_checks"] = stored
        save_config(config)
        return 1 if failures else 0
    rows = []
    for name, backend in AGENT_BACKENDS.items():
        command = list(backend.get("command") or [])
        binary = backend.get("binary") or (command[0] if command else "")
        check = stored.get(name) or {}
        rows.append({"name": name, "available": agent_available(backend),
                     "headless": bool(backend.get("headless") or backend.get("in_process")),
                     "verified": bool(check.get("ok")) or bool(backend.get("verified")),
                     "checked": check or None,
                     "help": backend.get("help")})
    if getattr(args, "json", False):
        print(json.dumps(rows, indent=2))
        return 0
    print(f"{'agent':<12} {'available':<10} {'headless':<9} notes")
    for row in rows:
        check = row.get("checked") or {}
        note = row['help']
        if check.get("ok"):
            note += f" (verified {check.get('latency_ms', 0)} ms)"
        elif check:
            note += " (last test FAILED)"
        elif not row["verified"]:
            note += " (flags unverified)"
        print(f"{row['name']:<12} {'yes' if row['available'] else 'no':<10} "
              f"{'yes' if row['headless'] else 'no':<9} {note}")
    print(f"\nUse one from chat with /agent <name>, or one-shot: "
          f"{PROG} route \"...\" --agent opencode")
    print(f"Prove the installed harnesses work: {PROG} agents --test")
    return 0


