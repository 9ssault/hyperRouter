def validate_provider_key(provider: str, key: str, timeout: float = 20.0) -> tuple[bool, str]:
    """Check a provider key against its models endpoint, then a tiny completion."""
    if not key:
        return False, "empty key"
    url = models_url(provider)
    if not url:
        return False, "this provider has no known endpoint"
    headers = {"Authorization": f"Bearer {key}", "x-api-key": key,
               "anthropic-version": "2023-06-01"}
    status, _, data = http_json("GET", url, headers=headers, timeout=timeout)
    if status == 200:
        count = len(data.get("data") or []) if isinstance(data, dict) else 0
        return True, f"models endpoint ok ({count} models)"
    if status in {401, 403}:
        return False, f"key rejected (HTTP {status})"
    chat = chat_url(provider)
    model = next((m.get("model") for m in load_catalog().get("models") or []
                  if m.get("provider") == provider and m.get("routable")), None)
    if not chat or not model:
        return False, f"models endpoint returned HTTP {status}"
    payload = json.dumps({"model": model, "max_tokens": 1,
                          "messages": [{"role": "user", "content": "hi"}]}).encode()
    status, _, data = http_json("POST", chat, headers={**headers, "Content-Type": "application/json"},
                                payload=payload, timeout=timeout)
    if status == 200:
        return True, "completion ok"
    error = data.get("error") if isinstance(data, dict) else data
    return False, f"HTTP {status} {redact(str(error))[:120]}"


def cmd_connect(args: argparse.Namespace) -> int:
    """Register a provider credential by env reference and verify it works."""
    provider = (args.provider or "").strip()
    meta = provider_meta(provider)
    if not meta:
        die(f"unknown provider: {provider} (see `hyperrouter providers`)")
    names = account_env_names(provider)
    env_name = (args.env or (names[0] if names else "")).strip()
    key = ""
    if args.key_stdin:
        key = sys.stdin.readline().strip()
    elif env_name:
        key = env_value(env_name)
    if args.keyless:
        env_name, key = "", ""
    if not args.keyless and not key:
        die(f"no key found. Export it first (`export {env_name}=...`), pipe it with "
            "--key-stdin, or pass --keyless for a provider that needs none.")
    if key:
        ok, detail = validate_provider_key(provider, key)
        print(f"{'OK  ' if ok else 'FAIL'} {provider}: {detail}")
        if not ok and not args.force:
            return 1
    config = load_config()
    item = {"provider": provider, "env": env_name, "label": args.label or env_name or "keyless",
            "monthly_limit": int(args.monthly_limit or 0),
            "daily_limit": int(args.daily_limit or 0), "weight": float(args.weight or 1.0)}
    accounts = config.setdefault("accounts", [])
    accounts[:] = [a for a in accounts if not (
        a.get("provider") == item["provider"] and a.get("env") == item["env"]
        and (a.get("label") or "") == item["label"])]
    accounts.append(item)
    save_config(config)
    print(f"registered {provider} via {env_name or 'keyless'}")
    if env_name and not env_value(env_name):
        print(f"set the key in your shell: export {env_name}=... (the router reads it from "
              "the environment; it is never written to config)")
    print(f"check: {PROG} accounts test --provider {provider} && {PROG} models --task coding")
    return 0


def cmd_accounts(args: argparse.Namespace) -> int:
    config = load_config()
    if args.action == "list":
        accounts = discover_accounts(config)
        if args.provider:
