SKILL_ROOT = CONFIG_HOME / "skills"
ANTHROPIC_SKILLS_REPO = "anthropics/skills"


def skill_search_dirs() -> list[Path]:
    dirs = [SKILL_ROOT, HOME / ".agents" / "skills"]
    cwd = Path.cwd()
    dirs.extend([cwd / ".agents" / "skills", cwd / ".skills", cwd / "skills"])
    seen: list[Path] = []
    for path in dirs:
        if path.is_dir() and path not in seen:
            seen.append(path)
    return seen


def parse_frontmatter(text: str) -> tuple[dict[str, str], str]:
    meta: dict[str, str] = {}
    body = text
    if text.startswith("---"):
        end = text.find("\n---", 3)
        if end != -1:
            header = text[3:end]
            body = text[end + 4:].lstrip("\n")
            lines = header.splitlines()
            index = 0
            while index < len(lines):
                line = lines[index]
                index += 1
                if ":" not in line or line.lstrip().startswith("#"):
                    continue
                key, value = line.split(":", 1)
                value = value.strip().strip('"\'')
                if value in {">", "|", ">-", "|-", ">+", "|+"}:
                    block = []
                    while index < len(lines) and (lines[index].startswith(" ") or not lines[index].strip()):
                        block.append(lines[index].strip())
                        index += 1
                    value = " ".join(part for part in block if part)
                meta[key.strip()] = value
    return meta, body


def discover_skills() -> list[dict[str, Any]]:
    skills: list[dict[str, Any]] = []
    seen: set[str] = set()
    for root in skill_search_dirs():
        for path in sorted(root.rglob("SKILL.md")):
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            meta, body = parse_frontmatter(text)
            name = str(meta.get("name") or path.parent.name).strip()
            if not name or name in seen:
                continue
            seen.add(name)
            skills.append({
                "name": name, "description": str(meta.get("description") or "").strip(),
                "path": str(path), "root": str(root), "body": body,
                "license": str(meta.get("license") or ""),
                "tokens": estimate_tokens(body),
            })
    return skills


def find_skill(name: str) -> dict[str, Any] | None:
    low = name.strip().lower()
    for skill in discover_skills():
        if skill["name"].lower() == low or skill["name"].lower().split(":")[-1] == low:
            return skill
    for skill in discover_skills():
        if low in skill["name"].lower():
            return skill
    return None


def skill_context(names: Sequence[str], limit_tokens: int = 6000) -> str:
    """Full instructions for the named skills, size-capped."""
    chunks: list[str] = []
    used = 0
    for name in names:
        skill = find_skill(name)
        if not skill:
            eprint(f"{PROG}: unknown skill: {name} (try `{PROG} skills list`)")
            continue
        body = skill["body"]
        budget = limit_tokens - used
        if budget <= 0:
            break
        if estimate_tokens(body) > budget:
            body = body[: budget * 4] + "\n... (truncated)"
        chunks.append(f"## Skill: {skill['name']}\n{skill['description']}\n\n{body}")
        used += estimate_tokens(body)
    return "\n\n".join(chunks)


def skill_catalog_text(limit: int = 60) -> str:
    """Name + description only, for progressive disclosure in the system prompt."""
    skills = discover_skills()
    if not skills:
        return ""
    lines = ["Available skills (ask to use one by name):"]
    for skill in skills[:limit]:
        desc = skill["description"][:110]
        lines.append(f"- {skill['name']}: {desc}")
    return "\n".join(lines)


def install_skill_repo(target: str) -> tuple[bool, str]:
    if not shutil.which("git"):
        return False, "git is not installed"
    value = target.strip()
    if value.startswith("http://") or value.startswith("https://"):
        url = value
        name = url.rstrip("/").split("/")[-1].removesuffix(".git")
    elif "/" in value and not Path(value).exists():
        url = f"https://github.com/{value}.git"
        name = value.split("/")[-1]
    else:
        path = Path(value).expanduser()
        if not path.is_dir():
            return False, f"not a local directory: {value}"
        url = str(path)
        name = path.name
    SKILL_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    destination = SKILL_ROOT / name
    if destination.exists():
        return False, f"already installed at {destination} (remove it first to update)"
    result = subprocess.run(["git", "clone", "--depth", "1", url, str(destination)],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=300, check=False)
    if result.returncode != 0:
        return False, result.stderr.decode("utf-8", "replace").strip()[:400]
    found = len(list(destination.rglob("SKILL.md")))
    return True, f"installed {name} with {found} skill(s) into {destination}"


def cmd_skills(args: argparse.Namespace) -> int:
    action = args.action or "list"
    if action == "path":
        print(SKILL_ROOT)
        for path in skill_search_dirs():
            print(path)
        return 0
    if action == "install":
        if not args.target:
            die("usage: hyperrouter skills install <owner/repo | url | dir>")
        ok, message = install_skill_repo(args.target)
        print(message)
        return 0 if ok else 1
    if action == "remove":
        if not args.target:
            die("usage: hyperrouter skills remove <name>")
        skill = find_skill(args.target)
        if not skill:
            die(f"unknown skill: {args.target}")
        path = Path(skill["path"]).parent
        if SKILL_ROOT not in path.parents and HOME / ".agents" not in path.parents:
            die(f"refusing to remove {path} (outside the managed skill directories)")
        shutil.rmtree(path)
        print(f"removed {path}")
        return 0
    skills = discover_skills()
    if args.search:
        needle = args.search.lower()
        skills = [s for s in skills if needle in s["name"].lower() or needle in s["description"].lower()]
    if action == "show":
        if not args.target:
            die("usage: hyperrouter skills show <name>")
        skill = find_skill(args.target)
        if not skill:
            die(f"unknown skill: {args.target}")
        print(f"# {skill['name']}\n{skill['description']}\n")
        print(skill["body"])
        return 0
    if args.json:
        print(json.dumps([{k: v for k, v in s.items() if k != "body"} for s in skills], indent=2))
        return 0
    if not skills:
        print("No skills found.")
        print(f"Install some: {PROG} skills install {ANTHROPIC_SKILLS_REPO}")
        return 0
    print(f"{'name':<28} {'tokens':>6}  description")
    for skill in skills:
        print(f"{skill['name']:<28} {skill['tokens']:>6}  {skill['description'][:96]}")
    print(f"\n{len(skills)} skill(s). Roots: " + ", ".join(str(p) for p in skill_search_dirs()))
    return 0


# ---------------------------------------------------------------------------
# MCP (Model Context Protocol) client
# ---------------------------------------------------------------------------

MCP_PROTOCOL_VERSION = "2025-06-18"
MCP_PRESETS: dict[str, dict[str, Any]] = {
    "rea": {
        "command": "npx", "args": ["-y", "rea-agents@latest", "mcp"],
        "env": {}, "enabled": True,
        "description": "REA — reverse engineer binaries, apps and runtime behavior",
    },
}


class McpError(RuntimeError):
    pass


class McpClient:
    """Minimal stdio MCP client: initialize, tools/list, tools/call."""

    def __init__(self, config: dict[str, Any], timeout: float = 30.0):
        command = str(config.get("command") or "").strip()
        if not command:
            raise McpError("mcp server has no command")
        argv = [command, *[str(x) for x in (config.get("args") or [])]]
        env = os.environ.copy()
        env.update({str(k): str(v) for k, v in (config.get("env") or {}).items()})
        self.timeout = timeout
        self._id = 0
        try:
            self.proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, env=env, text=True,
                                         bufsize=1, cwd=str(Path.home()))
        except OSError as exc:
            raise McpError(f"could not start {argv[0]}: {exc}") from exc

    def _send(self, payload: dict[str, Any]) -> None:
        assert self.proc.stdin is not None
        self.proc.stdin.write(json.dumps(payload) + "\n")
        self.proc.stdin.flush()

    def _read(self) -> dict[str, Any]:
        assert self.proc.stdout is not None
        import select
        ready, _, _ = select.select([self.proc.stdout], [], [], self.timeout)
        if not ready:
            raise McpError(f"timed out after {self.timeout:.0f}s")
        line = self.proc.stdout.readline()
        if not line:
            raise McpError("server closed the connection")
        try:
            return json.loads(line)
        except json.JSONDecodeError as exc:
            raise McpError(f"invalid JSON from server: {line[:200]}") from exc

    def request(self, method: str, params: dict[str, Any] | None = None) -> Any:
        self._id += 1
        request_id = self._id
        self._send({"jsonrpc": "2.0", "id": request_id, "method": method,
                    "params": params or {}})
        while True:
            message = self._read()
            if message.get("id") != request_id:
                continue
            if "error" in message:
                error = message["error"] or {}
                raise McpError(f"{error.get('message') or error}")
            return message.get("result")

    def notify(self, method: str, params: dict[str, Any] | None = None) -> None:
        self._send({"jsonrpc": "2.0", "method": method, "params": params or {}})

    def initialize(self) -> dict[str, Any]:
        result = self.request("initialize", {
            "protocolVersion": MCP_PROTOCOL_VERSION,
            "capabilities": {},
            "clientInfo": {"name": PRODUCT, "version": VERSION},
        }) or {}
        self.notify("notifications/initialized")
        return result

    def list_tools(self) -> list[dict[str, Any]]:
        result = self.request("tools/list", {}) or {}
        return list(result.get("tools") or [])

    def call_tool(self, name: str, arguments: dict[str, Any]) -> Any:
        return self.request("tools/call", {"name": name, "arguments": arguments})

    def close(self) -> None:
        try:
            if self.proc.stdin:
                self.proc.stdin.close()
            self.proc.terminate()
            self.proc.wait(timeout=5)
        except (OSError, subprocess.SubprocessError):
            try:
                self.proc.kill()
            except OSError:
                pass

    def __enter__(self) -> "McpClient":
        self.initialize()
        return self

    def __exit__(self, *exc: Any) -> None:
        self.close()


def mcp_servers(config: dict[str, Any] | None = None) -> dict[str, dict[str, Any]]:
    config = config or load_config()
    servers = config.get("mcp", {}).get("servers") or {}
    return {str(k): dict(v) for k, v in servers.items() if isinstance(v, dict)}


def mcp_call(server_name: str, tool: str, arguments: dict[str, Any],
             timeout: float = 60.0) -> Any:
    servers = mcp_servers()
    server = servers.get(server_name)
    if not server:
        raise McpError(f"unknown MCP server: {server_name}")
    with McpClient(server, timeout=timeout) as client:
        return client.call_tool(tool, arguments)


def _mcp_text(result: Any) -> str:
    if not isinstance(result, dict):
        return json.dumps(result, ensure_ascii=False, indent=2)
    items = result.get("content")
    if isinstance(items, list):
        parts = []
        for item in items:
            if isinstance(item, dict) and item.get("type") == "text":
                parts.append(str(item.get("text") or ""))
        if parts:
            return "\n".join(parts)
    return json.dumps(result, ensure_ascii=False, indent=2)


def cmd_mcp(args: argparse.Namespace) -> int:
    config = load_config()
    block = config.setdefault("mcp", {"servers": {}, "timeout_seconds": 30, "max_tool_rounds": 3})
    servers = block.setdefault("servers", {})
    action = args.action or "list"
    if action == "add-rea":
        servers["rea"] = copy.deepcopy(MCP_PRESETS["rea"])
        save_config(config)
        print(f"registered MCP server 'rea' -> {' '.join(MCP_PRESETS['rea']['args'])}")
        print(f"check it: {PROG} mcp tools rea")
        return 0
    if action == "add":
        if not args.name:
            die("usage: hyperrouter mcp add <name> --command <cmd> [--args \"-y pkg mcp\"]")
        command = args.command or (MCP_PRESETS.get(args.name, {}) or {}).get("command")
        if not command:
            die("--command is required (or use a preset name like 'rea')")
        argv = args.args.split() if getattr(args, "args", None) else list(
            (MCP_PRESETS.get(args.name, {}) or {}).get("args") or [])
        servers[args.name] = {"command": command, "args": argv, "env": {},
                              "enabled": True}
        save_config(config)
        print(f"registered MCP server '{args.name}' -> {command} {' '.join(argv)}")
        return 0
    if action in {"remove", "enable", "disable"}:
        if not args.name:
            die(f"usage: hyperrouter mcp {action} <name>")
        if args.name not in servers:
            die(f"unknown MCP server: {args.name}")
        if action == "remove":
            servers.pop(args.name)
            save_config(config)
            print(f"removed MCP server '{args.name}'")
        else:
            servers[args.name]["enabled"] = action == "enable"
            save_config(config)
            print(f"{action}d MCP server '{args.name}'")
        return 0
    if not servers:
        print("No MCP servers configured.")
        print(f"Add REA:  {PROG} mcp add-rea")
        print(f"Or:       {PROG} mcp add <name> --command <cmd> --args \"...\"")
        return 0
    if action == "list":
        rows = []
        for name, server in sorted(servers.items()):
            rows.append({"name": name, "command": server.get("command"),
                         "args": server.get("args") or [],
                         "enabled": bool(server.get("enabled", True))})
        if args.json:
            print(json.dumps(rows, indent=2))
            return 0
        print(f"{'name':<14} {'on':<4} command")
        for row in rows:
            print(f"{row['name']:<14} {'yes' if row['enabled'] else 'no':<4} "
                  f"{row['command']} {' '.join(str(x) for x in row['args'])}")
        return 0
    target = args.name
    if not target:
        die("which server? e.g. hyperrouter mcp tools rea")
    server = servers.get(target)
    if not server:
        die(f"unknown MCP server: {target}")
    try:
        with McpClient(server, timeout=float(block.get("timeout_seconds") or 30)) as client:
            if action == "test":
                info = client.initialize()
                tools = client.list_tools()
                print(f"OK {target}: {len(tools)} tools, server={info.get('serverInfo')}")
                return 0
            if action == "tools":
                tools = client.list_tools()
                if args.json:
                    print(json.dumps(tools, indent=2))
                    return 0
                print(f"{'tool':<36} description")
                for tool in tools:
                    print(f"{str(tool.get('name'))[:36]:<36} {str(tool.get('description') or '')[:88]}")
                print(f"\n{len(tools)} tool(s) on {target}")
                return 0
            if action == "call":
                if not args.tool:
                    die("usage: hyperrouter mcp call <server> <tool> [--json '{}']")
                raw = args.json_args or "{}"
                try:
                    arguments = json.loads(raw)
                except json.JSONDecodeError as exc:
                    die(f"--json must be a JSON object: {exc}")
                result = client.call_tool(args.tool, arguments)
                print(_mcp_text(result))
                return 0
    except McpError as exc:
        die(f"mcp {target}: {exc}")
    die(f"unknown mcp action: {action}")


