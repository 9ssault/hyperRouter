# Service management
# ---------------------------------------------------------------------------


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def read_pid() -> int | None:
    try:
        return int(PID_PATH.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, ValueError):
        return None


def health_check(host: str, port: int) -> dict[str, Any] | None:
    status, _, data = http_json("GET", f"http://{host}:{port}/health", timeout=2)
    if status == 200 and isinstance(data, dict):
        return data
    return None


def service_start(host: str, port: int) -> int:
    ensure_dirs()
    pid = read_pid()
    if pid and pid_alive(pid):
        print(f"hyperrouter already running (pid {pid})")
        return 0
    log = LOG_PATH.open("ab")
    try:
        proc = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "serve", "--host", host, "--port", str(port)],
            stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
            start_new_session=True, close_fds=True,
        )
    finally:
        log.close()
    PID_PATH.write_text(str(proc.pid), encoding="utf-8")
    try:
        os.chmod(PID_PATH, 0o600)
    except OSError:
        pass
    for _ in range(30):
        if health_check(host, port):
            print(f"hyperrouter started (pid {proc.pid}) at http://{host}:{port}/v1")
            return 0
        time.sleep(0.1)
    print(f"hyperrouter started (pid {proc.pid}), but health check is not ready yet")
    print(f"log: {LOG_PATH}")
    return 0


def service_stop() -> int:
    pid = read_pid()
    if not pid:
        print("hyperrouter is not running")
        return 0
    if not pid_alive(pid):
        PID_PATH.unlink(missing_ok=True)
        print("hyperrouter is not running (stale pid removed)")
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    for _ in range(30):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    if pid_alive(pid):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    PID_PATH.unlink(missing_ok=True)
    print("hyperrouter stopped")
    return 0


def service_status(host: str, port: int, as_json: bool = False) -> int:
    pid = read_pid()
    alive = bool(pid and pid_alive(pid))
    health = health_check(host, port)
    data = {"running": alive, "pid": pid, "health": health,
            "base_url": f"http://{host}:{port}/v1", "log": str(LOG_PATH)}
    if as_json:
        print(json.dumps(data, indent=2))
    else:
        print(f"running: {alive}")
        print(f"pid: {pid}")
        print(f"base_url: http://{host}:{port}/v1")
        print(f"health: {'ok' if health else 'unreachable'}")
        if health:
            print(f"catalog: {health.get('catalog')}")
            print(f"accounts: {health.get('accounts')}")
    return 0 if alive else 1


