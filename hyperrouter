    if args.action == "add":
        if not args.provider:
            die("--provider is required")
        meta = provider_meta(args.provider)
        if not meta:
            die(f"unknown provider: {args.provider} (see hyperrouter providers)")
        env = args.env or ""
        if not env and not args.keyless:
            names = account_env_names(args.provider)
            if not names:
                die("--env is required for this provider")
            env = names[0]
        item = {
            "provider": args.provider, "env": env, "label": args.label or env or "keyless",
            "monthly_limit": int(args.monthly_limit or 0),
            "daily_limit": int(args.daily_limit or 0),
            "weight": float(args.weight or 1.0),
        }
        accounts = config.setdefault("accounts", [])
        accounts[:] = [a for a in accounts if not (
            a.get("provider") == item["provider"] and a.get("env") == item["env"]
            and (a.get("label") or "") == item["label"]
        )]
        accounts.append(item)
        save_config(config)
        print(f"Added account reference {item['provider']}:{item['env'] or 'keyless'}")
        if env and not env_value(env):
            print(f"warning: {env} is not set in this shell", file=sys.stderr)
        return 0
    if args.action in {"remove", "enable", "disable"}:
        if not args.provider:
            die("--provider is required")
        accounts = config.setdefault("accounts", [])
        before = len(accounts)
        if args.action == "remove":
            accounts[:] = [a for a in accounts if not (
                a.get("provider") == args.provider
                and (not args.env or a.get("env") == args.env)
                and (not args.label or (a.get("label") or "") == args.label)
            )]
        else:
            for acct in accounts:
                if acct.get("provider") == args.provider and (
                    not args.env or acct.get("env") == args.env
                ):
                    acct["disabled"] = args.action == "disable"
        save_config(config)
        print(f"{args.action}: {before - len(accounts)} removed" if args.action == "remove"
              else f"{args.action}: {args.provider}")
        return 0
    if args.action == "test":
        accounts = discover_accounts(config)
        if args.provider:
            accounts = [a for a in accounts if a["provider"] == args.provider]
        if not accounts:
            print("No accounts to test.")
            return 1
        failures = 0
        for acct in accounts:
            url = models_url(acct["provider"])
            if not url:
                print(f"FAIL {acct['provider']:<18} {acct['label']:<20} no models endpoint")
                failures += 1
                continue
            status, _, data = http_json("GET", url, headers=upstream_headers(acct["provider"], acct), timeout=15)
            if status == 200:
                count = len(data.get("data") or []) if isinstance(data, dict) else 0
                print(f"OK   {acct['provider']:<18} {acct['label']:<20} models={count}")
            else:
                failures += 1
                err = data.get("error") if isinstance(data, dict) else data
                print(f"FAIL {acct['provider']:<18} {acct['label']:<20} HTTP {status} {redact(str(err))[:120]}")
        return 1 if failures else 0
    die(f"unknown accounts action: {args.action}")


