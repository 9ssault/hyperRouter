def agent_tool_specs() -> list[dict[str, Any]]:
    def spec(name: str, description: str, properties: dict[str, Any],
             required: list[str]) -> dict[str, Any]:
        return {"type": "function", "function": {"name": name, "description": description,
                                                 "parameters": {"type": "object",
                                                                "properties": properties,
                                                                "required": required}}}

    path = {"type": "string", "description": "File or directory path, relative to the working directory"}
    return [
        spec("read_file", "Read a text file with line numbers.",
             {"path": path, "start_line": {"type": "integer"},
              "end_line": {"type": "integer"}}, ["path"]),
        spec("write_file", "Create or overwrite a file. Read it first unless you are creating it.",
             {"path": path, "content": {"type": "string"}}, ["path", "content"]),
        spec("edit_file", "Replace one exact string in a file. old_string must match exactly once.",
             {"path": path, "old_string": {"type": "string"},
              "new_string": {"type": "string"},
              "replace_all": {"type": "boolean"}}, ["path", "old_string", "new_string"]),
        spec("list_dir", "List a directory.", {"path": path}, ["path"]),
        spec("search", "Search file contents (ripgrep syntax when available).",
             {"pattern": {"type": "string"}, "path": {"type": "string"},
              "glob": {"type": "string"},
              "max_results": {"type": "integer"}}, ["pattern"]),
        spec("run_command", "Run a shell command in the working directory and return its output.",
             {"command": {"type": "string"}, "timeout_seconds": {"type": "integer"}},
             ["command"]),
        spec("web_search", "Search the web (keyless) and return titles, links and snippets.",
             {"query": {"type": "string"}, "max_results": {"type": "integer"}},
             ["query"]),
        spec("web_fetch", "Fetch a URL and return its readable text, for docs, issues, pages.",
             {"url": {"type": "string"}, "max_chars": {"type": "integer"}}, ["url"]),
        spec("todo", "Replace the task list shown to the user (one entry per step).",
             {"items": {"type": "array", "items": {"type": "object", "properties": {
                 "task": {"type": "string"},
                 "status": {"type": "string", "enum": ["pending", "in_progress", "completed"]}},
                 "required": ["task", "status"]}}}, ["items"]),
        spec("subagent", "Fan work out to parallel workers. Give each worker its own files and "
             "a self-contained task; independent files only. Returns each worker's report.",
             {"tasks": {"type": "array", "items": {"type": "object", "properties": {
                 "files": {"type": "array", "items": {"type": "string"},
                           "description": "Files this worker owns"},
                 "task": {"type": "string", "description": "What this worker must do"}},
                 "required": ["task"]}},
              "max_workers": {"type": "integer"}},
             ["tasks"]),
    ]


def agent_system_prompt(cwd: Path, skills: Sequence[str] = ()) -> str:
    parts = [
        f"You are {PRODUCT}, a coding agent working in {cwd}.",
        "Use the tools to inspect and change the workspace. Read a file before editing it; "
        "prefer edit_file over rewriting whole files; keep shell commands small and relevant.",
        "Never claim a check passed unless you ran it. When the task is done, summarize what "
        "changed and what you verified.",
        "Track multi-step work with the todo tool.",
        "Use web_search and web_fetch for documentation, errors and current facts; cite the URL "
        "you relied on.",
        "For work that splits across independent files, call the subagent tool with one task "
        "per file group; workers run in parallel and you merge their reports.",
    ]
    agents_md = cwd / "AGENTS.md"
    if agents_md.is_file():
        parts.append("\n# Project instructions (AGENTS.md)\n" + agents_md.read_text(
            encoding="utf-8", errors="replace")[:20000])
    if skills:
        parts.append(skill_context(skills))
    return "\n\n".join(parts)


def _work_root(root: Any = None) -> Path:
    return Path(root).resolve() if root else Path.cwd().resolve()


def _tool_path(raw: Any, allow_outside: bool = False, root: Any = None) -> Path:
    base = _work_root(root)
    raw_path = Path(os.path.expanduser(str(raw or ".")))
    path = (raw_path if raw_path.is_absolute() else base / raw_path).resolve()
    if not allow_outside and path != base and base not in path.parents:
        raise ValueError(f"path is outside the working directory: {path}")
    return path


def display_width(text: str) -> int:
    width = 0
    for char in str(text or ""):
        if unicodedata.combining(char):
            continue
        width += 2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1
    return width


def clip_display(text: str, width: int) -> str:
    """Trim a string to a display width without splitting wide characters."""
    if width <= 0:
        return ""
    out: list[str] = []
    used = 0
    for char in str(text or ""):
        if unicodedata.combining(char):
            out.append(char)
            continue
        size = 2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1
        if used + size > width:
            break
        out.append(char)
        used += size
    return "".join(out)


def _cap(text: str, limit: int = 12000) -> str:
    text = str(text or "")
    if len(text) <= limit:
        return text
    return text[:limit] + f"\n... ({len(text) - limit} more characters)"


def diff_preview(path: Path, before: str, after: str, context: int = 3) -> str:
    """Unified diff between what is on disk and what the tool would write."""
    if before == after:
        return f"(no change to {path})"
    diff = list(difflib.unified_diff(
        before.splitlines(keepends=True), after.splitlines(keepends=True),
        fromfile=f"a/{path.name}", tofile=f"b/{path.name}", n=context))
    if not diff:
        return f"(no textual change to {path})"
    added = sum(1 for line in diff if line.startswith("+") and not line.startswith("+++"))
    removed = sum(1 for line in diff if line.startswith("-") and not line.startswith("---"))
    body = "".join(diff)
    header = f"{path}  (+{added} -{removed})"
    if len(diff) > 400:
        body = "".join(diff[:400]) + f"... ({len(diff) - 400} more diff lines)\n"
    return header + "\n" + body.rstrip("\n")


def preview_footer(preview: str) -> str:
    first = (preview or "").splitlines()[0] if preview else ""
    return first


def tool_read_file(args: dict[str, Any], root: Any = None) -> str:
    path = _tool_path(args.get("path"), root=root)
    text = path.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines()
    start = max(1, int(args.get("start_line") or 1))
    end = int(args.get("end_line") or 0) or min(len(lines), start + 599)
    end = min(end, start + 599)
    body = "\n".join(f"{number:>5}  {lines[number - 1]}" for number in range(start, min(end, len(lines)) + 1))
    return f"{path} ({len(lines)} lines)\n{body}"


def tool_write_file(args: dict[str, Any], allow_outside: bool = False,
                    approve: Any = None, root: Any = None) -> str:
    path = _tool_path(args.get("path"), allow_outside, root)
    content = str(args.get("content") or "")
    before = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
    if path.is_dir():
        raise ValueError(f"not a file: {path}")
    if approve and not approve("write", str(path), diff_preview(path, before, content)):
        return "error: the user denied this write"
    if path.exists():
        backup(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    return f"wrote {len(content)} chars to {path}"


def tool_edit_file(args: dict[str, Any], allow_outside: bool = False,
                   approve: Any = None, root: Any = None) -> str:
    path = _tool_path(args.get("path"), allow_outside, root)
    old = str(args.get("old_string") or "")
    new = str(args.get("new_string") or "")
    if not old:
        raise ValueError("old_string must not be empty")
    if not path.is_file():
        raise ValueError(f"not a file: {path}")
    text = path.read_text(encoding="utf-8", errors="replace")
    count = text.count(old)
    if count == 0:
        raise ValueError("old_string was not found in the file")
    if count > 1 and not args.get("replace_all"):
        raise ValueError(f"old_string matches {count} times; add more context or set replace_all")
    updated = text.replace(old, new) if args.get("replace_all") else text.replace(old, new, 1)
    if approve and not approve("edit", str(path), diff_preview(path, text, updated)):
        return "error: the user denied this edit"
    backup(path)
    path.write_text(updated, encoding="utf-8")
    return f"edited {path} ({count} replacement{'s' if count != 1 else ''}, {len(updated)} chars)"


def tool_list_dir(args: dict[str, Any], root: Any = None) -> str:
    path = _tool_path(args.get("path"), root=root)
    if not path.is_dir():
        raise ValueError(f"not a directory: {path}")
    entries = sorted(path.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
    rows = [f"{entry.name}{'/' if entry.is_dir() else ''}" for entry in entries[:300]]
    more = f"\n... {len(entries) - 300} more" if len(entries) > 300 else ""
    return f"{path}\n" + "\n".join(rows) + more


def tool_search(args: dict[str, Any], root: Any = None) -> str:
    pattern = str(args.get("pattern") or "")
    if not pattern:
        raise ValueError("pattern is required")
    path = _tool_path(args.get("path") or ".", root=root)
    limit = max(1, min(int(args.get("max_results") or 50), 300))
    rg = shutil.which("rg")
    if rg:
        command = [rg, "-n", "--no-heading", "--color", "never", "-m", str(limit), pattern, str(path)]
        if args.get("glob"):
            command[1:1] = ["-g", str(args["glob"])]
        proc = subprocess.run(command, capture_output=True, text=True, timeout=60, check=False)
        if proc.returncode not in (0, 1):
            raise ValueError(proc.stderr.strip()[:400] or "search failed")
        output = proc.stdout.strip()
        return _cap(output or "no matches", 16000)
    import re as _re
    hits: list[str] = []
    regex = _re.compile(pattern)
    for file in path.rglob("*"):
        if len(hits) >= limit or not file.is_file():
            continue
        try:
            for number, line in enumerate(file.read_text(encoding="utf-8", errors="ignore").splitlines(), 1):
                if regex.search(line):
                    hits.append(f"{file}:{number}:{line.strip()[:200]}")
                    if len(hits) >= limit:
                        break
        except OSError:
            continue
    return _cap("\n".join(hits) or "no matches", 16000)


WEB_USER_AGENT = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                  "(KHTML, like Gecko) Chrome/126.0 Safari/537.36")


def _assert_public_url(url: str) -> None:
    """Reject non-HTTP schemes and any host that resolves to a private address."""
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"http", "https"}:
        raise ValueError(f"only http(s) URLs are allowed, not {parsed.scheme or 'none'}")
    host = (parsed.hostname or "").strip().lower()
    if not host:
        raise ValueError("url has no host")
    if host in {"localhost", "localhost.localdomain"} or host.endswith((".local", ".internal")):
        raise ValueError("refusing to fetch a local address")
    try:
        addresses = {info[4][0] for info in socket.getaddrinfo(host, parsed.port or 80,
                                                               proto=socket.IPPROTO_TCP)}
    except socket.gaierror as exc:
        raise ValueError(f"could not resolve {host}: {exc}") from exc
    for address in addresses:
        try:
            ip = ipaddress.ip_address(address.split("%")[0])
        except ValueError:
            continue
        if (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved
                or ip.is_multicast or ip.is_unspecified):
            raise ValueError(f"refusing to fetch {host}: it resolves to the private address {ip}")


class _SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req: Any, fp: Any, code: Any, msg: Any, headers: Any,
                         newurl: str) -> Any:
        _assert_public_url(newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def _web_get(url: str, timeout: float = 25.0, max_bytes: int = 3_000_000) -> tuple[str, str]:
    """Fetch a URL with a browser user agent; return (final_url, body)."""
    _assert_public_url(url)
    request = urllib.request.Request(url, headers={
        "User-Agent": WEB_USER_AGENT,
        "Accept": "text/html,application/xhtml+xml,text/plain;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.8",
    })
    opener = urllib.request.build_opener(_SafeRedirectHandler())
    with opener.open(request, timeout=timeout) as response:
        charset = response.headers.get_content_charset() or "utf-8"
        body = response.read(max_bytes).decode(charset, errors="replace")
        return str(response.geturl() or url), body


def _decode_bing_url(href: str) -> str:
    href = htmllib.unescape(href)
    if "bing.com/ck/a" not in href:
        return href
    match = re.search(r"[?&]u=a1([A-Za-z0-9_\-=]+)", href)
    if not match:
        return href
    raw = match.group(1).replace("-", "+").replace("_", "/")
    raw += "=" * (-len(raw) % 4)
    try:
        decoded = base64.b64decode(raw).decode("utf-8", errors="replace")
    except Exception:  # noqa: BLE001
        return href
    return decoded if decoded.startswith("http") else href


def _strip_html(fragment: str) -> str:
    text = re.sub(r"<(script|style|noscript)[^>]*>.*?</\1>", " ", fragment,
                  flags=re.S | re.I)
    text = re.sub(r"<[^>]+>", " ", text)
    text = htmllib.unescape(text)
    return re.sub(r"\s+", " ", text).strip()


WEB_CACHE_PATH = DATA_HOME / "web-cache.json"
WEB_CACHE_TTL = 900
WEB_RATE_LOCK = threading.Lock()
WEB_LAST_CALL: dict[str, float] = {}


def _web_rate_limit(host: str, interval: float = 1.5) -> None:
    with WEB_RATE_LOCK:
        last = WEB_LAST_CALL.get(host, 0.0)
        wait = interval - (time.monotonic() - last)
        if wait > 0:
            time.sleep(wait)
        WEB_LAST_CALL[host] = time.monotonic()


def _web_cache_read() -> dict[str, Any]:
    try:
        data = json.loads(WEB_CACHE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def _web_cache_get(key: str) -> Any:
    entry = _web_cache_read().get(key)
    if not isinstance(entry, dict):
        return None
    if time.time() - float(entry.get("ts") or 0) > WEB_CACHE_TTL:
        return None
    return entry.get("value")


def _web_cache_set(key: str, value: Any) -> None:
    data = _web_cache_read()
    data[key] = {"ts": time.time(), "value": value}
    if len(data) > 200:
        for stale in sorted(data, key=lambda k: float((data[k] or {}).get("ts") or 0))[:-150]:
            data.pop(stale, None)
    payload = json.dumps(data, ensure_ascii=False)
    while len(payload) > 1_500_000 and len(data) > 10:
        oldest = min(data, key=lambda k: float((data[k] or {}).get("ts") or 0))
        data.pop(oldest, None)
        payload = json.dumps(data, ensure_ascii=False)
    try:
        WEB_CACHE_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        WEB_CACHE_PATH.write_text(payload, encoding="utf-8")
    except OSError:
        pass


def _search_brave(query: str, limit: int) -> list[dict[str, str]]:
    key = os.environ.get("BRAVE_API_KEY") or ""
    if not key:
        return []
    url = ("https://api.search.brave.com/res/v1/web/search?q="
           + urllib.parse.quote_plus(query) + f"&count={limit}")
    request = urllib.request.Request(url, headers={"X-Subscription-Token": key,
                                                   "Accept": "application/json"})
    with urllib.request.urlopen(request, timeout=20) as response:
        data = json.loads(response.read().decode("utf-8", errors="replace"))
    rows = []
    for item in ((data.get("web") or {}).get("results") or [])[:limit]:
        rows.append({"title": _strip_html(str(item.get("title") or "")),
                     "url": str(item.get("url") or ""),
                     "snippet": _strip_html(str(item.get("description") or ""))})
    return rows


def _search_tavily(query: str, limit: int) -> list[dict[str, str]]:
    key = os.environ.get("TAVILY_API_KEY") or ""
    if not key:
        return []
    payload = json.dumps({"api_key": key, "query": query, "max_results": limit}).encode()
    request = urllib.request.Request("https://api.tavily.com/search", data=payload,
                                     headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=25) as response:
        data = json.loads(response.read().decode("utf-8", errors="replace"))
    return [{"title": _strip_html(str(item.get("title") or "")),
             "url": str(item.get("url") or ""),
             "snippet": _strip_html(str(item.get("content") or ""))}
            for item in (data.get("results") or [])[:limit]]


def _search_exa(query: str, limit: int) -> list[dict[str, str]]:
    key = os.environ.get("EXA_API_KEY") or ""
    if not key:
        return []
    payload = json.dumps({"query": query, "numResults": limit}).encode()
    request = urllib.request.Request("https://api.exa.ai/search", data=payload,
                                     headers={"Content-Type": "application/json",
                                              "x-api-key": key})
    with urllib.request.urlopen(request, timeout=25) as response:
        data = json.loads(response.read().decode("utf-8", errors="replace"))
    return [{"title": _strip_html(str(item.get("title") or "")),
             "url": str(item.get("url") or ""),
             "snippet": _strip_html(str(item.get("text") or item.get("summary") or ""))}
            for item in (data.get("results") or [])[:limit]]


def _search_bing(query: str, limit: int) -> list[dict[str, str]]:
    url = ("https://www.bing.com/search?q=" + urllib.parse.quote_plus(query)
           + f"&count={limit}&setlang=en")
    _web_rate_limit("www.bing.com", 2.0)
    _, body = _web_get(url, timeout=25.0)
    blocks = re.split(r'<li class="b_algo"', body)[1:]
    rows: list[dict[str, str]] = []
    for block in blocks:
        match = re.search(r'<h2[^>]*>\s*<a[^>]*href="([^"]+)"[^>]*>(.*?)</a>', block, re.S)
        if not match:
            continue
        link = _decode_bing_url(match.group(1))
        title = _strip_html(match.group(2))
        snippet = ""
        for pattern in (r'<p[^>]*>(.*?)</p>', r'class="b_caption"[^>]*>(.*?)</div>'):
            found = re.search(pattern, block, re.S)
            if found:
                snippet = _strip_html(found.group(1))
                break
        rows.append({"title": title, "url": link, "snippet": snippet[:400]})
        if len(rows) >= limit:
            break
    return rows


def tool_web_search(args: dict[str, Any]) -> str:
    query = str(args.get("query") or "").strip()
    if not query:
        raise ValueError("query is required")
    limit = max(1, min(int(args.get("max_results") or 8), 20))
    cache_key = f"search:{limit}:{query.lower()}"
    cached = _web_cache_get(cache_key)
    if isinstance(cached, dict):
        rows = cached.get("rows") or []
        provider = str(cached.get("provider") or "cache")
    else:
        rows, provider = [], "none"
        for name, search in (("brave", _search_brave), ("tavily", _search_tavily),
                             ("exa", _search_exa), ("bing", _search_bing)):
            try:
                found = search(query, limit)
            except (OSError, ValueError, json.JSONDecodeError, urllib.error.URLError) as exc:
                emit_web_notice(f"{name} search failed: {exc}")
                continue
            if found:
                rows, provider = found, name
                break
        if rows:
            _web_cache_set(cache_key, {"provider": provider, "rows": rows[:limit]})
    if not rows:
        return (f"no results for {query!r} (all search backends failed - try "
                "web_fetch on a known URL, or export BRAVE_API_KEY)")
    body = "\n\n".join(f"{index}. {row.get('title')}\n   {row.get('url')}\n   "
                        f"{row.get('snippet', '')[:400]}"
                        for index, row in enumerate(rows[:limit], 1))
    return _cap(f"[{provider}]\n" + body, 12000)


def emit_web_notice(message: str) -> None:
    """Keep search-backend failures from breaking the caller."""
    try:
        config = load_config()
        if bool((config.get("web") or {}).get("verbose", False)):
            eprint(f"{PROG}: {message}")
    except Exception:  # noqa: BLE001
        pass


def tool_web_fetch(args: dict[str, Any]) -> str:
    url = str(args.get("url") or "").strip()
    if not url:
        raise ValueError("url is required")
    if "://" not in url:
        url = "https://" + url
    limit = max(500, min(int(args.get("max_chars") or 8000), 40000))
    final_url, body = _web_get(url)
    title_match = re.search(r"<title[^>]*>(.*?)</title>", body, re.S | re.I)
    title = _strip_html(title_match.group(1)) if title_match else ""
    if "<html" in body.lower() or "<body" in body.lower():
        content = _strip_html(body)
    else:
        content = body.strip()
    header = f"{title}\n{final_url}\n" if title else f"{final_url}\n"
    return _cap(header + "\n" + content, limit)


def sandbox_prefix(root: Path) -> list[str]:
    """bubblewrap prefix when present: read-only system, writable workspace only."""
    config = load_config()
    acfg = config.get("agent") or {}
    mode = str(acfg.get("sandbox") or "auto")
    if mode in {"none", "off", "false"}:
        return []
    bwrap = shutil.which("bwrap")
    if not bwrap:
        return []
    prefix = [bwrap, "--die-with-parent", "--unshare-pid",
              "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
              "--tmpfs", "/tmp", "--bind", str(root), str(root)]
    # Tool caches must stay writable or pip/npm/cargo fail inside the sandbox.
    for cache in (HOME / ".cache", HOME / ".npm", HOME / ".cargo",
                  HOME / ".local" / "share"):
        if cache.exists():
            prefix += ["--bind", str(cache), str(cache)]
    prefix += ["--chdir", str(root)]
    if not bool(acfg.get("sandbox_network", True)):
        prefix.append("--unshare-net")
    return prefix + ["--"]


def tool_run_command(args: dict[str, Any], root: Any = None) -> str:
    command = str(args.get("command") or "").strip()
    if not command:
        raise ValueError("command is required")
    lowered = command.lower().replace("  ", " ")
    if any(blocked in lowered for blocked in AGENT_BLOCKED_COMMANDS):
        raise ValueError("command blocked by the safety list")
    timeout = max(1, min(int(args.get("timeout_seconds") or 120), 600))
    workspace = _work_root(root)
    argv = sandbox_prefix(workspace) + ["bash", "-lc", command]
    proc = subprocess.run(argv, cwd=str(workspace), capture_output=True,
                          text=True, timeout=timeout, check=False)
    parts = [f"exit {proc.returncode}"]
    if proc.stdout.strip():
        parts.append("stdout:\n" + proc.stdout.rstrip())
    if proc.stderr.strip():
        parts.append("stderr:\n" + proc.stderr.rstrip())
    return _cap("\n".join(parts))


SUBAGENT_MAX_WORKERS = 4


def subagent_system_prompt(files: Sequence[str]) -> str:
    scope = ("\n".join(f"- {name}" for name in files)
             or "(no explicit files - stay read-only and report what you would change)")
    return "\n".join([
        f"You are a worker subagent for {PRODUCT} running in {Path.cwd()}.",
        "You own only these files:",
        scope,
        "Another agent owns everything else, so do not edit files outside your list; read them if "
        "you need context. Make the change, run a quick check if one is cheap, then answer with a "
        "short report: what you changed, and what you verified. Do not restate the task.",
    ])


def run_subagent(assignment: dict[str, Any], *, model: str = "auto",
                 task_hint: str = "coding", max_rounds: int = 4,
                 approve: Any = None, on_event: Any = None,
                 allow_outside: bool = False, ctx: dict[str, Any] | None = None) -> dict[str, Any]:
    """Run one worker to completion and return its report."""
    ctx = dict(ctx or {})
    files = [str(name) for name in (assignment.get("files") or [])]
    siblings = [str(name) for name in (assignment.get("siblings") or [])]
    task = str(assignment.get("task") or "").strip()
    if not task:
        return {"ok": False, "error": "task is required", "files": files}
    sub_ctx = dict(ctx)
    sub_ctx["depth"] = int(ctx.get("depth") or 0) + 1
    sub_ctx["files"] = set(files)
    sub_ctx.setdefault("changed", set())
    system = subagent_system_prompt(files)
    if siblings:
        system += ("\nOther workers own these files at the same time; do not edit them:\n"
                   + "\n".join(f"- {name}" for name in siblings))
    messages: list[dict[str, Any]] = [
        {"role": "system", "content": system},
        {"role": "user", "content": task},
    ]
    try:
        result = agent_turn(messages, model=model, task_hint=task_hint,
                            max_rounds=max(1, max_rounds), approve=approve,
                            on_event=on_event, allow_outside=allow_outside,
                            ctx=sub_ctx, allow_subagents=False)
    except RuntimeError as exc:
        return {"ok": False, "error": str(exc), "files": files}
    except Exception as exc:  # noqa: BLE001 - reported to the parent
        return {"ok": False, "error": f"{type(exc).__name__}: {exc}", "files": files}
    return {"ok": True, "response": result.get("text") or "",
            "rounds": result.get("rounds"), "interrupted": bool(result.get("interrupted")),
            "files": files, "changed": sorted(sub_ctx.get("changed") or [])}


def tool_subagent(args: dict[str, Any], approve: Any = None, on_event: Any = None,
                  allow_outside: bool = False, ctx: dict[str, Any] | None = None) -> str:
    ctx = ctx or {}
    if int(ctx.get("depth") or 0) > 0:
        return "error: workers cannot spawn their own workers; do the work directly"
    tasks = [item for item in (args.get("tasks") or []) if isinstance(item, dict)]
    tasks = [item for item in tasks if str(item.get("task") or "").strip()]
    if not tasks:
        return "error: give at least one task with a \"task\" field"
    # Two workers on the same file would race and lose an edit, so refuse that.
    owners: dict[str, int] = {}
    overlaps: list[str] = []
    for index, item in enumerate(tasks, 1):
        for name in item.get("files") or []:
            key = str(name).strip()
            if not key:
                continue
            if key in owners:
                overlaps.append(f"{key} (workers {owners[key]} and {index})")
            owners.setdefault(key, index)
    if overlaps:
        return ("error: these files are assigned to more than one worker: "
                + ", ".join(sorted(set(overlaps)))
                + ". Split by file, or run the work sequentially.")
    ceiling = max(1, min(int(ctx.get("max_subagents") or SUBAGENT_MAX_WORKERS),
                         SUBAGENT_MAX_WORKERS))
    limit = max(1, min(int(args.get("max_workers") or ceiling), ceiling))
    workers = tasks[:limit]
    if len(tasks) > limit:
        workers = workers[:limit]
    base_rounds = max(1, int(ctx.get("subagent_rounds") or 4))
    lock = ctx.get("approval_lock")
    if approve is not None and lock is not None:
        raw_approve = approve

        def approve(kind: str, detail: str, preview: str = "") -> bool:  # noqa: F811
            with lock:
                return bool(raw_approve(kind, detail, preview))
    label = {id(item): index + 1 for index, item in enumerate(workers)}

    def emit(kind: str, payload: dict[str, Any]) -> None:
        if on_event:
            try:
                on_event(kind, payload)
            except Exception:  # noqa: BLE001 - events must never break a worker
                pass

    def worker_events(worker_id: int) -> Any:
        def inner(kind: str, payload: dict[str, Any]) -> None:
            emit(kind, dict(payload or {}, worker=worker_id))
        return inner

    def retryable(report: dict[str, Any]) -> bool:
        text = str(report.get("error") or "").lower()
        return any(bit in text for bit in ("rate limit", "429", "timed out", "timeout",
                                          "temporarily", "overloaded", "502", "503"))

    root = _work_root(ctx.get("root"))
    isolate = bool(ctx.get("isolation", True))

    def work(item: dict[str, Any], worker_id: int) -> dict[str, Any]:
        started = time.time()
        assigned: list[str] = []
        for name in item.get("files") or []:
            try:
                source = _tool_path(name, root=root)
                assigned.append(str(source.relative_to(root)))
            except ValueError:
                continue
        report: dict[str, Any] = {"ok": False, "error": "not attempted"}
        for attempt in range(2):
            scratch = Path(tempfile.mkdtemp(prefix=f"hyperrouter-w{worker_id}-")) if isolate else None
            before: dict[str, bytes | None] = {}
            worker_ctx = dict(ctx)
            if scratch is not None:
                for relative in assigned:
                    source = root / relative
                    if not source.is_file():
                        continue
                    data = source.read_bytes()
                    before[relative] = data
                    target = scratch / relative
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(data)
                worker_ctx["root"] = str(scratch)
            report = run_subagent(item, model=ctx.get("model") or "auto",
                                  task_hint=ctx.get("task_hint") or "coding",
                                  max_rounds=base_rounds, approve=approve,
                                  on_event=worker_events(worker_id),
                                  allow_outside=False if isolate else allow_outside,
                                  ctx=worker_ctx)
            if scratch is not None:
                merged: list[str] = []
                conflicts: list[str] = []
                if report.get("ok"):
                    for relative in assigned:
                        produced = scratch / relative
                        if not produced.is_file():
                            continue
                        content = produced.read_bytes()
                        original = before.get(relative)
                        target = root / relative
                        current = target.read_bytes() if target.is_file() else None
                        if current != original:
                            conflicts.append(relative)
                            continue
                        if content != current:
                            target.parent.mkdir(parents=True, exist_ok=True)
                            target.write_bytes(content)
                            merged.append(relative)
                report["changed"] = merged
                if conflicts:
                    report["conflicts"] = conflicts
                shutil.rmtree(scratch, ignore_errors=True)
            if report.get("ok") or not retryable(report) or attempt == 1:
                break
            emit("subagent_start", {"worker": worker_id, "retry": True,
                                    "files": [str(f) for f in (item.get("files") or [])],
                                    "task": "retrying after: " + str(report.get("error") or "")[:120]})
            report["retried"] = True
        report["elapsed"] = round(time.time() - started, 1)
        return report

    reports: dict[int, dict[str, Any]] = {}
    results: list[dict[str, Any]] = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(limit, len(workers))) as pool:
        futures = {}
        for item in workers:
            worker_id = label[id(item)]
            siblings = sorted({str(name) for other in workers if other is not item
                               for name in (other.get("files") or [])})
            item = dict(item, siblings=siblings)
            fut = pool.submit(work, item, worker_id)
            futures[fut] = (worker_id, item)
            # Stagger starts so N workers do not hit the same free tier in the same ms.
            time.sleep(min(0.6 * (worker_id - 1), 2.0))
            emit("subagent_start", {"worker": worker_id,
                                    "files": [str(f) for f in (item.get("files") or [])],
                                    "task": str(item.get("task") or "")[:200]})
        try:
            for fut in concurrent.futures.as_completed(futures, timeout=900):
                worker_id, item = futures[fut]
                try:
                    report = fut.result()
                except Exception as exc:  # noqa: BLE001 - one worker must not kill the batch
                    report = {"ok": False, "error": f"{type(exc).__name__}: {exc}",
                              "files": [str(f) for f in (item.get("files") or [])]}
                report["worker"] = worker_id
                reports[worker_id] = report
                results.append(report)
                emit("subagent_done", {"worker": worker_id, "ok": bool(report.get("ok")),
                                       "changed": report.get("changed") or [],
                                       "elapsed": report.get("elapsed"),
                                       "retried": bool(report.get("retried")),
                                       "error": report.get("error") or ""})
        except concurrent.futures.TimeoutError:
            results.append({"ok": False, "error": "worker batch timed out after 900s"})
    merged = [reports[key] for key in sorted(reports)]
    if ctx.get("on_change"):
        for report in merged:
            for name in report.get("changed") or []:
                try:
                    ctx["on_change"](name)
                except Exception:  # noqa: BLE001
                    pass
    changed = sorted({name for report in merged for name in (report.get("changed") or [])})
    failures = [report.get("worker") for report in merged if not report.get("ok")]
    # A worker can write outside its list; flag any file two workers both touched.
    touched: dict[str, set[int]] = {}
    for report in merged:
        for name in report.get("changed") or []:
            touched.setdefault(name, set()).add(int(report.get("worker") or 0))
    shared = sorted(name for name, owners_set in touched.items() if len(owners_set) > 1)
    summary = (f"{len(merged) - len(failures)}/{len(merged)} workers ok"
               + (f", changed {len(changed)} file(s): " + ", ".join(changed[:8]) if changed else "")
               + (f", failed: {failures}" if failures else "")
               + (f", WARNING two workers touched: {shared}" if shared else ""))
    payload = {"summary": summary,
               "workers": [{"worker": report.get("worker"), "ok": report.get("ok"),
                            "files": report.get("files") or [],
                            "changed": report.get("changed") or [],
                            "conflicts": report.get("conflicts") or [],
                            "elapsed": report.get("elapsed"),
                            "retried": bool(report.get("retried")),
                            "error": report.get("error"),
                            "report": (report.get("response") or "")[:3000]}
                           for report in merged],
               "isolated": isolate, "changed": changed, "shared": shared,
               "failed": failures}
    return _cap(json.dumps(payload, ensure_ascii=False, indent=2), 16000)


def execute_tool(name: str, args: dict[str, Any], approve: Any = None,
                 on_event: Any = None, allow_outside: bool = False,
                 ctx: dict[str, Any] | None = None,
                 allow_subagents: bool = True) -> str:
    ctx = ctx if isinstance(ctx, dict) else {}
    root = ctx.get("root")
    try:
        policy = (load_config().get("agent") or {}).get("approvals") or {}

        def allow(kind: str) -> Any:
            """Approval callback for this kind, or None when the policy is open."""
            return approve if (approve and policy.get(kind, True)) else None

        if name.startswith("mcp__"):
            target = (MCP_AGENT_CACHE.get("map") or {}).get(name)
            if not target:
                return (f"error: unknown MCP tool {name!r} - call it as exposed by "
                        "tools/list, or reload the session")
            if isinstance(target, dict):
                server, tool = str(target.get("server")), str(target.get("tool"))
                readonly = bool(target.get("readonly", True))
            else:
                server, tool = target  # type: ignore[misc]
                readonly = True
            ask = allow("mcp_write")
            if not readonly and ask and not ask("mcp", f"{server}/{tool}", ""):
                return "error: the user denied this MCP tool call"
            timeout = float((load_config().get("mcp") or {}).get("timeout_seconds") or 60)
            result = mcp_call(server, tool, args, timeout=max(15.0, timeout), persistent=True)
            return _cap(_mcp_text(result), int((load_config().get("agent") or {})
                                             .get("tool_result_chars") or 12000))
        if name == "read_file":
            return tool_read_file(args, root)
        if name == "list_dir":
            return tool_list_dir(args, root)
        if name == "search":
            return tool_search(args, root)
        if name == "write_file":
            output = tool_write_file(args, allow_outside, allow("write"), root)
            if not output.startswith("error:"):
                ctx.setdefault("changed", set()).add(str(args.get("path")))
            return output
        if name == "edit_file":
            output = tool_edit_file(args, allow_outside, allow("edit"), root)
            if not output.startswith("error:"):
                ctx.setdefault("changed", set()).add(str(args.get("path")))
            return output
        if name == "run_command":
            ask = allow("run")
            if ask and not ask("run", str(args.get("command")), ""):
                return "error: the user denied this command"
            return tool_run_command(args, root)
        if name == "web_search":
            return tool_web_search(args)
        if name == "web_fetch":
            return tool_web_fetch(args)
        if name == "todo":
            items = args.get("items") or []
            if on_event:
                on_event("todos", items)
            done = sum(1 for item in items if str(item.get("status")) == "completed")
            return f"todo list updated ({done}/{len(items)} done)"
        if name == "subagent":
            if not allow_subagents:
                return "error: subagents are disabled in this run; do the work yourself"
            return tool_subagent(args, approve, on_event, allow_outside, ctx)
        return (f"error: unknown tool {name!r}. Available: read_file, write_file, edit_file, "
                "list_dir, search, run_command, todo, subagent")
    except (OSError, ValueError, subprocess.SubprocessError, McpError) as exc:
        return f"error: {exc}"


VERIFY_CANDIDATES = [
    ("pyproject.toml", "python3 -m pytest -q"),
    ("pytest.ini", "python3 -m pytest -q"),
    ("setup.cfg", "python3 -m pytest -q"),
    ("package.json", "npm test --silent"),
    ("Cargo.toml", "cargo test -q"),
    ("go.mod", "go test ./..."),
]


def detect_verify_command(root: Path) -> str:
    config = load_config()
    configured = str((config.get("agent") or {}).get("verify_command") or "").strip()
    if configured:
        return configured
    for marker, command in VERIFY_CANDIDATES:
        if (root / marker).is_file():
            if marker == "package.json":
                try:
                    data = json.loads((root / marker).read_text(encoding="utf-8"))
                    if not (data.get("scripts") or {}).get("test"):
                        continue
                except (OSError, json.JSONDecodeError):
                    continue
            return command
    makefile = root / "Makefile"
    if makefile.is_file():
        try:
            if re.search(r"^test:", makefile.read_text(encoding="utf-8", errors="replace"), re.M):
                return "make test"
        except OSError:
            pass
    return ""


def run_verification(root: Path) -> dict[str, Any]:
    config = load_config()
    acfg = config.get("agent") or {}
    command = detect_verify_command(root)
    if not command:
        return {"command": "", "ok": None, "output": "no test command detected"}
    timeout = max(30, min(int(acfg.get("verify_timeout") or 300), 900))
    argv = sandbox_prefix(root) + ["bash", "-lc", command]
    try:
        proc = subprocess.run(argv, cwd=str(root), capture_output=True, text=True,
                              timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        return {"command": command, "ok": False,
                "output": f"timed out after {timeout}s"}
    except OSError as exc:
        return {"command": command, "ok": False, "output": str(exc)}
    output = _cap((proc.stdout or "") + ("\n" if proc.stdout and proc.stderr else "")
                  + (proc.stderr or ""), 6000).strip()
    return {"command": command, "ok": proc.returncode == 0,
            "exit": proc.returncode, "output": output}


def retry_after_seconds(message: str) -> int:
    match = re.search(r"retry[-_ ]after[:\s]+(\d+)", message or "", re.I)
    return int(match.group(1)) if match else 0


def response_message(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict):
        return {}
    choices = data.get("choices")
    if not isinstance(choices, list) or not choices or not isinstance(choices[0], dict):
        return {}
    message = choices[0].get("message")
    return message if isinstance(message, dict) else {}


def agent_turn(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str = "coding",
    max_rounds: int = 8,
    approve: Any = None,
    on_event: Any = None,
    allow_outside: bool = False,
    temperature: float | None = None,
    max_tokens: int | None = None,
    ctx: dict[str, Any] | None = None,
    allow_subagents: bool = True,
) -> dict[str, Any]:
    """Run a tool-calling loop until the model answers or rounds run out."""
    ctx = dict(ctx or {})
    ctx.setdefault("changed", set())
    ctx.setdefault("depth", 0)
    ctx.setdefault("model", model)
    ctx.setdefault("task_hint", task_hint)
    ctx.setdefault("root", str(Path.cwd()))
    if "isolation" not in ctx:
        ctx["isolation"] = bool((load_config().get("agent") or {})
                                .get("subagent_isolation", True))
    if allow_subagents and ctx.get("approval_lock") is None:
        # One approval prompt at a time, even when workers run in parallel.
        ctx["approval_lock"] = threading.Lock()
    tools = agent_tool_specs()
    if not allow_subagents:
        tools = [spec for spec in tools
                 if (spec.get("function") or {}).get("name") != "subagent"]
    try:
        mcp_specs = mcp_agent_specs()
    except Exception:  # noqa: BLE001 - a bad MCP config must not stop the agent
        mcp_specs = []
    if mcp_specs:
        tools = tools + mcp_specs
    emit = on_event or (lambda kind, payload: None)
    meta: dict[str, Any] = {}
    for round_index in range(max(1, max_rounds)):
        attempts = 0
        while True:
            try:
                with request_gate():
                    result = route_once(messages, model=model, task_hint=task_hint,
                                        max_tokens=max_tokens, temperature=temperature,
                                        tools=tools)
                break
            except RuntimeError as exc:
                wait = retry_after_seconds(str(exc))
                if attempts < 1 and 0 < wait <= 45:
                    emit("notice", {"message": f"free-tier limit hit; waiting {wait}s"})
                    time.sleep(wait + 1)
                    attempts += 1
                    continue
                if any(message.get("role") == "tool" for message in messages):
                    return {"text": (f"I stopped after {round_index} round(s): the free pool is "
                                     f"rate limited ({exc}). The work above is what completed; "
                                     "ask again in a minute to continue."),
                            "meta": meta, "rounds": round_index, "interrupted": True}
                raise
        meta = result.get("x_agent_router") or meta
        message = response_message(result)
        text = content_to_text(message.get("content"))
        calls = message.get("tool_calls") or []
        if not calls:
            verification = None
            acfg = load_config().get("agent") or {}
            if (ctx.get("changed") and bool(acfg.get("verify", True))
                    and int(ctx.get("depth") or 0) == 0):
                emit("notice", {"message": "running the project's checks"})
                verification = run_verification(_work_root(ctx.get("root")))
                emit("verify", verification)
            return {"text": text, "meta": meta, "rounds": round_index + 1,
                    "verification": verification}
        messages.append({"role": "assistant", "content": text, "tool_calls": calls})
        for call in calls:
            if not isinstance(call, dict):
                continue
            function = call.get("function") or {}
            # Some free models decorate tool names ("edit_file<|channel|>commentary",
            # "functions.edit_file"). Normalise before dispatch.
            name = re.split(r"[<\s]", str(function.get("name") or ""))[0]
            name = name.split(".")[-1].strip()
            raw_args = function.get("arguments")
            if isinstance(raw_args, str):
                try:
                    args = json.loads(raw_args) if raw_args.strip() else {}
                except json.JSONDecodeError:
                    args = {"raw": raw_args}
            elif isinstance(raw_args, dict):
                args = raw_args
            else:
                args = {}
            emit("tool", {"name": name, "arguments": args})
            tool_ctx = dict(ctx or {})
            tool_ctx.setdefault("changed", set())
            output = execute_tool(name, args, approve, emit, allow_outside, tool_ctx,
                                  allow_subagents=allow_subagents)
            ctx.setdefault("changed", set()).update(tool_ctx.get("changed") or [])
            emit("tool_result", {"name": name, "output": _cap(output, 4000)})
            messages.append({"role": "tool", "tool_call_id": str(call.get("id") or name),
                             "content": _cap(output, 12000)})
    # Out of rounds: ask for a wrap-up without tools.
    messages.append({"role": "user", "content":
                     "Stop calling tools. Summarize what you changed and what you verified."})
    try:
        with request_gate():
            result = route_once(messages, model=model, task_hint="summarization",
                                max_tokens=max_tokens)
    except RuntimeError as exc:
        return {"text": (f"Stopped after {max_rounds} tool rounds: the free pool is rate limited "
                         f"({exc}). The tool output above is what completed; raise --max-rounds "
                         "or continue in a minute."),
                "meta": meta, "rounds": max_rounds, "interrupted": True}
    meta = result.get("x_agent_router") or meta
    return {"text": response_text(result), "meta": meta, "rounds": max_rounds}


def cmd_agent(args: argparse.Namespace) -> int:
    config = load_config()
    acfg = config.get("agent") or {}
    cwd = Path(os.path.expanduser(args.cwd or os.getcwd())).resolve()
    if not cwd.is_dir():
        die(f"working directory not found: {cwd}")
    os.chdir(cwd)
    task = " ".join(args.task).strip() if isinstance(args.task, list) else str(args.task)
    if not task:
        die("give the agent a task")
    system = agent_system_prompt(cwd, getattr(args, "skill", None) or [])
    messages: list[dict[str, Any]] = [{"role": "system", "content": system},
                                      {"role": "user", "content": task}]
    state = {"auto": bool(args.auto or acfg.get("auto_approve")), "denied": 0}

    def approve(kind: str, detail: str, preview: str = "") -> bool:
        if state["auto"]:
            return True
        if not sys.stdin.isatty():
            state["denied"] += 1
            eprint(f"{PROG}: denied {kind} (non-interactive; pass --auto): {detail}")
            return False
        print(f"\n[{kind}] {detail}")
        if preview:
            for line in preview.splitlines()[:80]:
                print(f"  {line[:240]}")
            if len(preview.splitlines()) > 80:
                print("  ...")
        try:
            answer = input("allow? [y/N/a=always] ").strip().lower()
        except EOFError:
            return False
        if answer in {"a", "always"}:
            state["auto"] = True
            return True
        return answer in {"y", "yes"}

    json_events = bool(getattr(args, "json_events", False))

    def on_event(kind: str, payload: dict[str, Any]) -> None:
        if json_events:
            print(json.dumps({"event": kind, "data": payload}, ensure_ascii=False,
                             default=str), flush=True)
            return
        if kind == "tool":
            print(f"  -> {payload.get('name')} "
                  f"{json.dumps(payload.get('arguments') or {}, ensure_ascii=False)[:240]}")
        elif kind == "tool_result":
            output = str(payload.get("output") or "").rstrip()
            for line in output.splitlines()[:24]:
                print(f"     {line[:200]}")
            if len(output.splitlines()) > 24:
                print("     ...")
        elif kind == "todos":
            for item in payload or []:
                mark = {"completed": "[x]", "in_progress": "[>]"}.get(str(item.get("status")), "[ ]")
                print(f"  {mark} {item.get('task')}")
        elif kind == "subagent_start":
            files = ", ".join(payload.get("files") or []) or "no files"
            print(f"  ++ worker {payload.get('worker')} ({files}): "
                  f"{str(payload.get('task') or '')[:160]}")
        elif kind == "subagent_done":
            changed = ", ".join(payload.get("changed") or [])
            state_bit = "ok" if payload.get("ok") else f"failed: {payload.get('error') or ''}"
            print(f"  ++ worker {payload.get('worker')} {state_bit}"
                  + (f" (changed {changed})" if changed else ""))
        elif kind == "verify":
            command = payload.get("command") or "(none)"
            state = {True: "passed", False: "failed", None: "skipped"}[payload.get("ok")]
            print(f"  == verify {state}: {command}")
            for line in str(payload.get("output") or "").splitlines()[:20]:
                print(f"     {line[:200]}")
        elif kind == "notice":
            print(f"  ... {payload.get('message')}")

    rounds = int(args.max_rounds or acfg.get("max_rounds") or 8)
    ctx = {"subagent_rounds": int(acfg.get("subagent_rounds") or 4),
           "max_subagents": int(acfg.get("max_subagents") or 4)}
    try:
        result = agent_turn(messages, model=args.model or "auto", task_hint=args.task_hint or "coding",
                            max_rounds=rounds, approve=approve, on_event=on_event,
                            allow_outside=bool(args.allow_outside or acfg.get("allow_outside")),
                            temperature=getattr(args, "temperature", None),
                            max_tokens=args.max_tokens or None, ctx=ctx,
                            allow_subagents=bool(acfg.get("subagents", True))
                            and not getattr(args, "no_subagents", False))
    except RuntimeError as exc:
        close_mcp_sessions()
        if json_events:
            print(json.dumps({"event": "error", "data": {"message": str(exc)}},
                             ensure_ascii=False), flush=True)
            return 1
        die(str(exc))
    finally:
        close_mcp_sessions()
    if json_events:
        print(json.dumps({"event": "final", "data": {"task": task, "result": result}},
                         ensure_ascii=False, default=str), flush=True)
        return 0
    if args.json:
        print(json.dumps({"task": task, "result": result}, indent=2, default=str))
        return 0
    print("\n" + (result.get("text") or "(the model returned no text)"))
    meta = result.get("meta") or {}
    if meta:
        print(f"\n[{PRODUCT}: {meta.get('provider')}/{meta.get('model')} · "
              f"{result.get('rounds')} round(s) · {meta.get('latency_ms')}ms]")
    if state["denied"]:
        print(f"({state['denied']} action(s) denied - rerun with --auto to allow them)")
    return 0


