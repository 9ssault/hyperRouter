            print(f"\n[{PRODUCT}: {router.get('provider')}/{router.get('model')} "
                  f"task={router.get('task')} latency={router.get('latency_ms')}ms]", file=sys.stderr)
    return 0


def split_task(text: str) -> list[str]:
    """Split an explicit list into subtasks; otherwise treat it as one step."""
    lines = [line.rstrip() for line in text.splitlines()]
    numbered = re.compile(r"^\s*(?:\d+[.)]|[-*+])\s+(.+)$")
    items = [match.group(1).strip() for match in (numbered.match(line) for line in lines) if match]
    if len(items) >= 2:
        return [item for item in items if item]
    # Inline lists: "1. design it 2. write it 3. review it"
    inline = [part.strip(" ;,") for part in re.split(r"(?:^|\s)\d{1,2}[.)]\s+", text.strip())]
    inline = [part for part in inline if part]
    if len(inline) >= 2:
        return inline
    paragraphs = [line.strip() for line in lines if line.strip()]
    if len(paragraphs) >= 2 and all(len(line) < 90 for line in paragraphs):
        return paragraphs
    return [text.strip()]


