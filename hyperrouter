        "source": "local" if provider in {"vllm"} else "curated",
    }


CURATED_MODELS: list[dict[str, Any]] = [_curated_model(row) for row in _CURATED_TABLE]


def merge_curated(catalog: dict[str, Any]) -> dict[str, Any]:
    """Add the curated free sources without clobbering fresher catalog data."""
    providers = catalog.setdefault("providers", {})
    for pid, meta in CURATED_PROVIDERS.items():
        if pid not in providers:
            providers[pid] = copy.deepcopy(meta)
    models = catalog.setdefault("models", [])
    known = {str(m.get("id")) for m in models if isinstance(m, dict)}
    for model in CURATED_MODELS:
        if model["id"] not in known:
            models.append(copy.deepcopy(model))
            known.add(model["id"])
    return catalog


_CATALOG_CACHE: dict[str, Any] | None = None


def load_catalog(force: bool = False) -> dict[str, Any]:
    global _CATALOG_CACHE
    if _CATALOG_CACHE is not None and not force:
        return _CATALOG_CACHE
    migrate_legacy_home()
    candidates = [CATALOG_PATH, Path(__file__).resolve().with_name("catalog.json")]
    for path in candidates:
        if path.is_file():
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue
            if isinstance(data, dict) and isinstance(data.get("models"), list):
                _CATALOG_CACHE = merge_curated(data)
                return _CATALOG_CACHE
    _CATALOG_CACHE = merge_curated(fallback_catalog())
    return _CATALOG_CACHE


def save_catalog(data: dict[str, Any]) -> None:
    global _CATALOG_CACHE
    backup(CATALOG_PATH)
    write_text(CATALOG_PATH, json.dumps(data, indent=1) + "\n")
    _CATALOG_CACHE = data


def provider_meta(provider: str) -> dict[str, Any]:
    catalog = load_catalog()
    return (catalog.get("providers") or {}).get(provider) or {}


def expand_api(api: str) -> str:
    if not api:
        return ""

    def repl(match: re.Match[str]) -> str:
        return os.environ.get(match.group(1), match.group(0))

    return re.sub(r"\$\{([A-Z0-9_]+)\}", repl, api).rstrip("/")


def chat_url(provider: str) -> str:
    meta = provider_meta(provider)
    api = expand_api(str(meta.get("api") or ""))
    if not api:
        return ""
    if api.endswith("/chat/completions"):
        return api
    if provider == "pollinations":
        return api
    return api + "/chat/completions"


def models_url(provider: str) -> str:
    meta = provider_meta(provider)
    api = expand_api(str(meta.get("api") or ""))
    if not api:
        return ""
    if api.endswith("/chat/completions"):
        api = api[: -len("/chat/completions")]
    if provider == "pollinations":
        return "https://text.pollinations.ai/models"
    return api.rstrip("/") + "/models"


def catalog_model(model_id: str) -> dict[str, Any] | None:
    catalog = load_catalog()
    for model in catalog.get("models") or []:
        if model.get("id") == model_id:
            return model
    low = model_id.lower()
    for model in catalog.get("models") or []:
        if str(model.get("id", "")).lower() == low:
            return model
    # provider/model and bare model
    for model in catalog.get("models") or []:
        if model.get("model") == model_id:
            return model
    return None


