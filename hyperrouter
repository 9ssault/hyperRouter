def repo_dir_for_update() -> Path | None:
    script = Path(__file__).resolve()
    for parent in script.parents:
        if (parent / ".git").exists():
            return parent
    for candidate in (HOME / "Projects" / "hyperRouter", Path.cwd()):
        if (candidate / ".git").exists():
            return candidate
    return None


def main_commands(parser: argparse.ArgumentParser) -> list[str]:
    for action in parser._actions:  # noqa: SLF001 - argparse has no public API
        if isinstance(action, argparse._SubParsersAction):  # noqa: SLF001
            return list(action.choices)
    return []


def cmd_update(args: argparse.Namespace) -> int:
    repo = repo_dir_for_update()
    if repo is None:
        die("no git checkout found; clone https://github.com/9ssault/hyperRouter and "
            "set HYPERROUTER_REPO to its path")
    fetch = subprocess.run(["git", "-C", str(repo), "fetch", "--quiet"],
                           capture_output=True, text=True, timeout=120, check=False)
    if fetch.returncode != 0:
        die(f"git fetch failed: {fetch.stderr.strip()[:200]}")
    local = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"],
                           capture_output=True, text=True, timeout=30, check=False).stdout.strip()
    remote = subprocess.run(["git", "-C", str(repo), "rev-parse", "origin/main"],
                            capture_output=True, text=True, timeout=30, check=False).stdout.strip()
    behind = local != remote
    report: dict[str, Any] = {"repo": str(repo), "version": VERSION, "local": local,
                              "remote": remote, "behind": behind, "updated": False}
    if behind and not args.check:
        pull = subprocess.run(["git", "-C", str(repo), "pull", "--ff-only", "--quiet"],
                              capture_output=True, text=True, timeout=180, check=False)
        if pull.returncode != 0:
            die(f"git pull failed: {pull.stderr.strip()[:200]}")
        source = repo / "hyperrouter"
        target = Path(__file__).resolve()
        if source.is_file() and source.resolve() != target:
            backup(target)
            shutil.copy2(source, target)
        report["updated"] = True
        try:
            report["new_version"] = re.search(r'^VERSION = "([^"]+)"',
                                              source.read_text(encoding="utf-8"), re.M).group(1)
        except (OSError, AttributeError):
            report["new_version"] = "unknown"
    if args.json:
        print(json.dumps(report, indent=2))
    elif behind and not args.check:
        print(f"updated {repo} {local[:8]} -> {remote[:8]}; installed version "
              f"{report.get('new_version') or VERSION}")
    elif behind:
        print(f"update available: {local[:8]} -> {remote[:8]} (run without --check to apply)")
    else:
        print(f"already up to date at {local[:8]} (hyperrouter {VERSION})")
    return 0


def cmd_completions(args: argparse.Namespace) -> int:
    parser = build_parser()
    commands = main_commands(parser)
    shell = args.shell
    if shell == "bash":
        print(f"complete -W \"{' '.join(commands)}\" {PROG}")
        print(f"complete -o default -W \"--help --version\" {PROG}")
    elif shell == "zsh":
        print(f"#compdef {PROG}")
        print(f"_arguments '1:command:({' '.join(commands)})' '*::arg:->args'")
    else:
        print(f"complete -c {PROG} -f -a \"{' '.join(commands)}\"")
        print(f"complete -c {PROG} -l help -d 'show help'")
        print(f"complete -c {PROG} -l version -d 'show version'")
    return 0


def cmd_man(args: argparse.Namespace) -> int:
    parser = build_parser()
    commands = main_commands(parser)
    lines = [f".TH {PROG.upper()} 1 \"{datetime.now():%Y-%m-%d}\" \"{PRODUCT} {VERSION}\" \"User Commands\"",
             ".SH NAME", f"{PROG} \\- free-model router and terminal coding agent",
             ".SH SYNOPSIS", f".B {PROG}", ".RI [ command ] [ options ]",
             ".SH DESCRIPTION", f"{PRODUCT} routes requests across free model providers, "
             "runs a full-screen agent with tools, and delegates to OpenCode, "
             "Freebuff or DeepSeek Harness. Run with no command to open the TUI.",
             ".SH COMMANDS"]
    for action in parser._actions:  # noqa: SLF001
        if isinstance(action, argparse._SubParsersAction):  # noqa: SLF001
            for name, sub in action.choices.items():
                help_text = (sub.description or "").splitlines()[0] if sub.description else ""
                lines.append(f".TP\n.B {name}\n{help_text or 'see'} " + f"\\({PROG} {name} --help\\)")
            break
    lines += [".SH FILES", f"~/.config/hyperrouter/config.json",
              f"~/.local/share/hyperrouter/router.db",
              ".SH SEE ALSO", f"{PROG} doctor, {PROG} settings"]
    print("\n".join(lines))
    return 0


