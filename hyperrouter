def color_map(enabled: bool) -> dict[str, str]:
    if not enabled:
        return {key: "" for key in ("dim", "bold", "cyan", "green", "red", "yellow", "reset")}
    return {"dim": "\033[2m", "bold": "\033[1m", "cyan": "\033[36m",
            "green": "\033[32m", "red": "\033[31m", "yellow": "\033[33m",
            "reset": "\033[0m"}


def setup_readline(history_path: Path, models: Sequence[str]) -> None:
    try:
        import readline  # type: ignore
    except ImportError:
        return
    try:
        history_path.parent.mkdir(parents=True, exist_ok=True)
        readline.read_history_file(str(history_path))
        readline.set_history_length(1000)
    except (OSError, AttributeError):
        pass
    commands = list(CHAT_COMMANDS) + list(TASK_ALIASES)
    models = list(models)

    def completer(text: str, state: int) -> str | None:
        if text.startswith("/model ") or text.startswith("/task "):
            pool = models if "model" in text else list(TASK_ALIASES)
            matches = [item for item in pool if item.split(" ")[0].startswith(text.split(" ", 1)[1])]
        else:
            matches = [item.split(" ")[0] for item in commands if item.startswith(text)]
        return matches[state] if state < len(matches) else None

    try:
        readline.set_completer(completer)
        readline.parse_and_bind("tab: complete")
    except (AttributeError, OSError):
        pass


def save_readline_history(history_path: Path) -> None:
    try:
        import readline  # type: ignore
        readline.write_history_file(str(history_path))
    except (ImportError, OSError, AttributeError):
        pass


def transcript_dir(config: dict[str, Any]) -> Path:
    raw = str(config.get("chat", {}).get("transcript_dir") or "").strip()
    path = Path(os.path.expanduser(raw)) if raw else DATA_HOME / "transcripts"
    return path


def transcript_append(path: Path, entry: dict[str, Any]) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        pass


def sessions_dir() -> Path:
    return DATA_HOME / "sessions"


def chat_session_path(args: argparse.Namespace, config: dict[str, Any]) -> Path | None:
    if getattr(args, "resume", False):
        files = sorted(sessions_dir().glob("*.json"), key=lambda p: p.stat().st_mtime)
        return files[-1] if files else sessions_dir() / "default.json"
    raw = getattr(args, "session", None)
    if raw:
        path = Path(os.path.expanduser(raw))
        if "/" not in raw and not path.suffix:
            return sessions_dir() / f"{raw}.json"
        return path
    return None


def chat_system_prompt(persona_name: str | None, extra: str) -> str:
    parts = []
    if persona_name:
        persona = load_persona(persona_name)
        if persona:
            parts.append(persona)
    if extra.strip():
        parts.append(extra.strip())
    return "\n\n".join(parts)


def chat_full_system(persona_name: str | None, extra: str,
                     skill_names: Sequence[str]) -> str:
    parts = [chat_system_prompt(persona_name, extra)]
    if skill_names:
        parts.append(skill_context(skill_names))
    return "\n\n".join(part for part in parts if part.strip())


def chat_router_tag(meta: dict[str, Any], colors: dict[str, str],
                    show_tokens: bool = True) -> str:
    if not meta.get("provider"):
        return ""
    bits = [f"{meta.get('provider')}/{meta.get('model')}"]
    if meta.get("task"):
        bits.append(f"task={meta['task']}")
    if meta.get("latency_ms"):
        bits.append(f"{float(meta['latency_ms']) / 1000:.1f}s")
    if show_tokens and (meta.get("tokens_in") or meta.get("tokens_out")):
        bits.append(f"{human_count(meta.get('tokens_in', 0))} in / "
                    f"{human_count(meta.get('tokens_out', 0))} out")
    return f"{colors['dim']}[{PRODUCT}: " + " · ".join(bits) + f"]{colors['reset']}"


def cmd_chat(args: argparse.Namespace) -> int:
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    wants_tui = not getattr(args, "plain", False)
    if getattr(args, "tui", False):
        wants_tui = True
    if (getattr(args, "once", None) or getattr(args, "prompt", None) or not interactive
            or not load_config().get("ui", {}).get("tui", True)):
        return cmd_chat_plain(args)
    if not wants_tui:
        return cmd_chat_plain(args)
    return cmd_tui(args)


def cmd_chat_plain(args: argparse.Namespace) -> int:
    config = load_config()
    ccfg = config.get("chat") or {}
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    use_color = bool(ccfg.get("color", True)) and not getattr(args, "no_color", False) and interactive
    colors = color_map(use_color)
    model = args.model or str(ccfg.get("model") or "auto")
    task_hint = args.task or ""
    strategy = args.strategy or ccfg.get("strategy") or None
    temperature = (args.temperature if args.temperature is not None
                   else float(ccfg.get("temperature") if ccfg.get("temperature") is not None else 0.7))
    max_tokens = (args.max_tokens if args.max_tokens is not None
                  else int(ccfg.get("max_tokens") or 0))
    stream = (bool(ccfg.get("stream", True)) and not args.no_stream)
    enrich = bool(ccfg.get("auto_enrich")) or bool(getattr(args, "enrich", False))
    persona_name = args.persona or ccfg.get("persona")
    system_extra = args.system if args.system is not None else str(ccfg.get("system") or "")
    show_tag = bool(ccfg.get("show_router_tag", True))
    show_tokens = bool(ccfg.get("show_token_usage", True))
    history_limit = max(2, int(ccfg.get("history_limit") or 40))
    session = chat_session_path(args, config)
    if session is None and not getattr(args, "once", None) and not getattr(args, "prompt", None):
        session = sessions_dir() / "default.json"
    skill_names = [str(x) for x in (getattr(args, "skill", None) or [])]
    skill_names += [str(x) for x in (config.get("chat", {}).get("skills") or [])]
    agent_backend = getattr(args, "agent", None) or None
    if agent_backend and agent_backend not in AGENT_BACKENDS:
        die(f"unknown agent: {agent_backend} (choose from {', '.join(AGENT_BACKENDS)})")
    messages: list[dict[str, Any]] = []
    pending: list[str] = []
    if session and session.is_file():
        try:
            saved = json.loads(session.read_text(encoding="utf-8"))
            loaded = saved.get("messages") if isinstance(saved, dict) else saved
            if isinstance(loaded, list):
                messages = [m for m in loaded if isinstance(m, dict) and m.get("role") in {"user", "assistant"}]
        except (OSError, json.JSONDecodeError):
            eprint(f"{PROG}: could not load session {session}")
    transcript: Path | None = None
    if ccfg.get("save_transcript", True) and not args.no_save:
        transcript = transcript_dir(config) / f"chat-{datetime.now().strftime('%Y%m%d-%H%M%S')}.jsonl"
    history_file = DATA_HOME / "chat_history"
    aliases = list(ALIAS_DESCRIPTIONS)
    setup_readline(history_file, aliases)

    def write_entry(role: str, content: str, meta: dict[str, Any] | None = None) -> None:
        if transcript is None:
            return
        transcript_append(transcript, {"ts": utc_now(), "role": role, "content": content,
                                        "model": model, "meta": meta or {}})

    def persist_session() -> None:
        if not session:
            return
        try:
            session.parent.mkdir(parents=True, exist_ok=True)
            session.write_text(json.dumps({"version": 1, "model": model, "messages": messages},
                                          indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        except OSError:
            pass

    def send(text: str) -> None:
        nonlocal messages, enrich
        content = text
        if pending:
            content = "\n\n".join(pending) + "\n\n" + content
            pending.clear()
        if agent_backend:
            print(f"{colors['cyan']}{agent_backend} ›{colors['reset']} ", end="", flush=True)
            try:
                answer = run_agent(agent_backend, content)
            except RuntimeError as exc:
                print(f"{colors['red']}error: {exc}{colors['reset']}")
                return
            print(answer)
            messages.append({"role": "user", "content": content})
            messages.append({"role": "assistant", "content": answer})
            write_entry("user", content)
            write_entry("assistant", answer, {"provider": agent_backend, "model": "headless"})
            persist_session()
            return
        if enrich and not any(m.get("role") == "user" for m in messages):
            content = build_prompt(content, persona=chat_system_prompt(persona_name, ""),
                                   output_format="text", max_tokens=max_tokens)
            print(f"{colors['dim']}(prompt enriched){colors['reset']}")
        messages.append({"role": "user", "content": content})
        system = chat_full_system(persona_name, system_extra, skill_names)
        payload = ([{"role": "system", "content": system}] if system else []) + messages[-history_limit:]
        meta: dict[str, Any] = {}
        print(f"{colors['cyan']}{PRODUCT} ›{colors['reset']} ", end="", flush=True)
        answer = ""
        try:
            if stream:
                pieces: list[str] = []
                for piece in stream_route(payload, model=model, task_hint=task_hint or None,
                                          strategy=strategy, max_tokens=max_tokens,
                                          temperature=temperature, meta=meta):
                    print(piece, end="", flush=True)
                    pieces.append(piece)
                answer = "".join(pieces)
                print()
            else:
                result = route_once(payload, model=model, task_hint=task_hint or None,
                                    strategy=strategy, max_tokens=max_tokens,
                                    temperature=temperature)
                answer = response_text(result)
                meta = result.get("x_agent_router") or {}
                print(answer)
        except RuntimeError as exc:
            messages.pop()
            print(f"{colors['red']}error: {exc}{colors['reset']}")
            return
        except KeyboardInterrupt:
            messages.pop()
            print(f"\n{colors['yellow']}interrupted{colors['reset']}")
            return
        if not answer.strip():
            messages.pop()
            print(f"{colors['red']}error: empty response from the free pool{colors['reset']}")
            return
        messages.append({"role": "assistant", "content": answer})
        write_entry("user", content)
        write_entry("assistant", answer, meta)
        persist_session()
        if show_tag:
            tag = chat_router_tag(meta, colors, show_tokens)
            if tag:
                print(tag)

    def handle_command(line: str) -> bool:
        nonlocal model, task_hint, strategy, temperature, max_tokens, stream, enrich
        nonlocal system_extra, persona_name, messages, show_tag, skill_names, agent_backend
        parts = line[1:].split(" ", 1)
        command = "/" + parts[0]
        value = parts[1].strip() if len(parts) > 1 else ""
        if command in {"/exit", "/quit"}:
            return False
        if command == "/help":
            for name, desc in CHAT_COMMANDS.items():
                print(f"  {name:<22} {desc}")
            return True
        if command == "/clear":
            messages = []
            if session:
                persist_session()
            print("conversation cleared")
        elif command == "/model":
            if value:
                model = value
                print(f"model: {model}")
            else:
                print(f"model: {model}  task: {task_hint or 'auto'}  strategy: {strategy or 'balanced'}")
                print("aliases: " + ", ".join(aliases))
        elif command == "/models":
            task = normalize_task(value or task_hint or "chat")
            print(f"Task: {task}")
            print_candidates(pick_models(task, limit=8, strategy=strategy))
        elif command == "/task":
            task_hint = value
            print(f"task: {task_hint or 'auto-detect'}")
        elif command == "/strategy":
            if value and value not in STRATEGIES:
                print(f"strategy must be one of: {', '.join(STRATEGIES)}")
            else:
                strategy = value or None
                print(f"strategy: {strategy or 'balanced'}")
        elif command in {"/temp", "/temperature"}:
            try:
                temperature = max(0.0, min(2.0, float(value)))
                print(f"temperature: {temperature}")
            except ValueError:
                print(f"temperature: {temperature} (give a number 0-2)")
        elif command == "/max":
            try:
                max_tokens = max(0, int(value))
                print(f"max tokens: {max_tokens or 'provider default'}")
            except ValueError:
                print(f"max tokens: {max_tokens or 'provider default'}")
        elif command == "/stream":
            stream = value.lower() not in {"off", "0", "false", "no"}
            print(f"stream: {'on' if stream else 'off'}")
        elif command == "/enrich":
            enrich = value.lower() not in {"off", "0", "false", "no"}
            print(f"auto-enrich: {'on' if enrich else 'off'}")
        elif command == "/system":
            if value:
                system_extra = value
            print(f"system: {system_extra or '(none)'}")
        elif command == "/persona":
            persona_name = value or None
            print(f"persona: {persona_name or '(none)'}")
        elif command == "/file":
            path = Path(os.path.expanduser(value)).resolve()
            if not value or not path.is_file():
                print(f"file not found: {value or '(none given)'}")
            else:
                body = path.read_text(encoding="utf-8", errors="replace")
                if len(body) > 200_000:
                    body = body[:200_000] + "\n... (truncated)"
                pending.append(f"## File: {path}\n\n{body}")
                print(f"attached {path} ({estimate_tokens(body)} tokens) to the next message")
        elif command == "/usage":
            days = 7
            if value:
                try:
                    days = int(value)
                except ValueError:
                    days = 7
            cmd_usage(argparse.Namespace(days=days, by="provider", limit=8, provider=None,
                                         model=None, json=False))
        elif command == "/settings":
            if value:
                got = deep_get(load_config(), value.split("."))
                print(f"{value} = {format_setting(got)}")
            else:
                flat = flatten_config(load_config())
                for key in sorted(flat):
                    if key.startswith(("chat.", "routing.")):
                        print(f"  {key:<32} {format_setting(flat[key])}")
        elif command == "/sources":
            cmd_sources(argparse.Namespace(json=False))
        elif command == "/save":
            target = Path(os.path.expanduser(value)) if value else (session or Path.cwd() / "chat.json")
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(json.dumps({"version": 1, "model": model, "messages": messages},
                                         indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
            print(f"saved {len(messages)} messages to {target}")
        elif command == "/load":
            target = Path(os.path.expanduser(value))
            if not target.is_file():
                print(f"file not found: {value or '(none given)'}")
            else:
                saved = json.loads(target.read_text(encoding="utf-8"))
                loaded = saved.get("messages") if isinstance(saved, dict) else saved
                if isinstance(loaded, list):
                    messages = [m for m in loaded if isinstance(m, dict)]
                    if isinstance(saved, dict) and saved.get("model"):
                        model = str(saved["model"])
                    print(f"loaded {len(messages)} messages from {target}")
        elif command == "/retry":
            last_user = next((m for m in reversed(messages) if m.get("role") == "user"), None)
            if not last_user:
                print("nothing to retry")
            else:
                while messages and messages[-1].get("role") != "user":
                    messages.pop()
                if messages:
                    messages.pop()
                send(str(last_user.get("content") or ""))
        elif command == "/keys":
            for key, desc in TUI_HELP:
                if key or desc:
                    print(f"  {key:<12} {desc}")
        elif command == "/find":
            if not value:
                print("usage: /find <text> - the full-screen TUI filters the transcript live")
            else:
                hits = [m for m in messages
                        if value.lower() in content_to_text(m.get("content")).lower()]
                if not hits:
                    print(f"no messages match {value!r}")
                for index, msg in enumerate(hits[-12:], 1):
                    preview = content_to_text(msg.get("content")).replace("\n", " ")[:160]
                    print(f"  {index}. {msg.get('role')}: {preview}")
        elif command in {"/tag", "/tokens"}:
            show_tag = not show_tag
            print(f"router tag: {'on' if show_tag else 'off'}")
        elif command == "/agent":
            if not value:
                print(f"agent backend: {agent_backend or 'off (free pool)'}")
                for name, backend in AGENT_BACKENDS.items():
                    print(f"  {name:<10} {backend['help']}")
            elif value.lower() in {"off", "none", "router", "free"}:
                agent_backend = None
                print("agent backend: off (free pool)")
            elif value in AGENT_BACKENDS:
                agent_backend = value
                print(f"agent backend: {value} ({AGENT_BACKENDS[value]['help']})")
            else:
                print(f"unknown agent: {value} (choose from {', '.join(AGENT_BACKENDS)})")
        elif command == "/new":
            messages = []
            persist_session()
            print("new session")
        elif command == "/undo":
            removed = 0
            while messages and removed < 2:
                messages.pop()
                removed += 1
            persist_session()
            print(f"removed {removed} message(s)")
        elif command == "/history":
            count = 6
            if value:
                try:
                    count = max(1, int(value))
                except ValueError:
                    pass
            for msg in messages[-count:]:
                role = msg.get("role")
                text = str(msg.get("content") or "").replace("\n", " ")
                print(f"  {role:<9} {text[:100]}")
            if not messages:
                print("  (empty)")
        elif command == "/compact":
            if len(messages) < 4:
                print("nothing to compact")
            else:
                transcript_text = "\n\n".join(
                    f"{m.get('role')}: {m.get('content')}" for m in messages)
                prompt = ("Summarize this conversation for a fresh context window. Keep decisions, "
                          "facts, file paths, code identifiers and open questions.\n\n"
                          + transcript_text[:120000])
                try:
                    result = route_once([{"role": "user", "content": prompt}], model=model,
                                        task_hint="summarization", max_tokens=1200)
                    summary = response_text(result)
                except RuntimeError as exc:
                    print(f"compact failed: {exc}")
                    summary = ""
                if summary:
                    messages = [{"role": "user", "content":
                                 "Summary of the earlier conversation:\n\n" + summary}]
                    persist_session()
                    print(f"compacted to {estimate_tokens(summary)} tokens")
        elif command == "/export":
            target = Path(os.path.expanduser(value)) if value else (
                Path.cwd() / f"chat-{datetime.now().strftime('%Y%m%d-%H%M%S')}.md")
            lines = [f"# {PRODUCT} chat", "", f"model: {model}", ""]
            for msg in messages:
                lines.append(f"## {msg.get('role')}")
                lines.append("")
                lines.append(str(msg.get("content") or ""))
                lines.append("")
            target.write_text("\n".join(lines), encoding="utf-8")
            print(f"exported {len(messages)} messages to {target}")
        elif command == "/session":
            print(f"session: {session or '(not persisted)'}")
            print(f"messages: {len(messages)}  model: {model}")
        elif command == "/skill":
            if not value:
                print("skills: " + (", ".join(skill_names) or "(none)"))
            elif value in skill_names:
                skill_names.remove(value)
                print(f"unloaded skill: {value}")
            else:
                skill = find_skill(value)
                if not skill:
                    print(f"unknown skill: {value} (try /skills)")
                else:
                    skill_names.append(skill["name"])
                    print(f"loaded skill: {skill['name']} ({estimate_tokens(skill['body'])} tokens)")
        elif command == "/skills":
            cmd_skills(argparse.Namespace(action="list", target=None, search=value or None,
                                          json=False))
        elif command == "/mcp":
            if value:
                cmd_mcp(argparse.Namespace(action="tools", name=value, tool=None, json=False,
                                           command=None, args=None, json_args=None))
            else:
                cmd_mcp(argparse.Namespace(action="list", name=None, tool=None, json=False,
                                           command=None, args=None, json_args=None))
        elif command == "/init":
            target = Path.cwd() / "AGENTS.md"
            if target.exists():
                print(f"{target} already exists")
            else:
                body = (f"# Agent instructions\n\nThis project uses {PRODUCT}.\n\n"
                        f"- Free-model router: `{PROG}` (OpenAI-compatible at "
                        "http://127.0.0.1:8787/v1)\n"
                        f"- Ask a question: `{PROG} chat \"...\"` or `{PROG} route \"...\"`\n"
                        f"- Rank models: `{PROG} models --task \"...\"`\n"
                        f"- Split work: `{PROG} delegate \"1. ... 2. ...\"`\n"
                        "- Never commit API keys; providers are read from the environment.\n")
                target.write_text(body, encoding="utf-8")
                print(f"wrote {target}")
        else:
            print(f"unknown command: {command} (try /help)")
        return True

    one_shot = bool(getattr(args, "once", None) or getattr(args, "prompt", None))
    if not getattr(args, "quiet", False) and not one_shot:
        catalog = load_catalog()
        routable = sum(1 for m in catalog.get("models") or [] if m.get("routable"))
        print(f"{colors['bold']}{PRODUCT} {VERSION}{colors['reset']} — free-model chat")
        print(f"{colors['dim']}{len(catalog.get('models') or [])} free models · "
              f"{len(catalog.get('providers') or {})} providers · {routable} routable"
              f"{colors['reset']}")
        print(f"{colors['dim']}model: {model} · task: {task_hint or 'auto'} · "
              f"strategy: {strategy or 'balanced'} · stream: {'on' if stream else 'off'} · "
              f"enrich: {'on' if enrich else 'off'} · agent: {agent_backend or 'free pool'}"
              f"{colors['reset']}")
        if messages:
            print(f"{colors['dim']}resumed {len(messages)} messages" + (f" from {session}" if session else "") + colors["reset"])
        print(f"{colors['dim']}/help for commands, /exit to leave{colors['reset']}")

    once = getattr(args, "once", None)
    if once is None and getattr(args, "prompt", None):
        once = args.prompt
    try:
        if once is not None:
            send(str(once))
            return 0
        while True:
            try:
                line = input(f"{colors['green']}you ›{colors['reset']} ")
            except EOFError:
                print()
                break
            except KeyboardInterrupt:
                print("\n(use /exit to leave)")
                continue
            while line.endswith("\\"):
                try:
                    line = line[:-1] + "\n" + input(f"{colors['dim']}...{colors['reset']} ")
                except (EOFError, KeyboardInterrupt):
                    break
            text = line.strip()
            if not text:
                continue
            if text.startswith("/"):
                if not handle_command(text):
                    break
                continue
            send(text)
    finally:
        persist_session()
        save_readline_history(history_file)
    return 0


