def classify_task(text: str, has_tools: bool = False, has_images: bool = False,
                  context_tokens: int = 0) -> tuple[str, dict[str, float]]:
    low = (text or "").lower()
    scores: dict[str, float] = {}
    for task, patterns in TASK_PATTERNS.items():
        score = 0.0
        for pattern, weight in patterns:
            if re.search(pattern, low):
                score += weight
        if score:
            scores[task] = score
    if has_images:
        scores["vision"] = scores.get("vision", 0) + 2.0
    if has_tools:
        scores["agentic"] = scores.get("agentic", 0) + 0.8
    if context_tokens > 24000:
        scores["long_context"] = scores.get("long_context", 0) + 1.2
    if not scores:
        return "chat", {"chat": 1.0}
    # Prefer the highest, but break near-ties toward coding/reasoning.
    order = ["debugging", "coding", "math", "analysis", "planning", "review", "extraction",
             "translation", "summarization", "writing", "creative", "vision", "agentic",
             "long_context", "chat"]
    best = max(scores, key=lambda k: (scores[k], -order.index(k) if k in order else 99))
    if best == "long_context":
        # long_context is a modifier; keep the strongest substantive task.
        substantive = {k: v for k, v in scores.items() if k != "long_context"}
        if substantive:
            best = max(substantive, key=lambda k: substantive[k])
    return best, scores


def model_fit(model: dict[str, Any], task: str) -> tuple[float, list[str]]:
    name = f"{model.get('name','')} {model.get('model','')}".lower()
    quality = float(model.get("quality") or 0.5)
    speed = float(model.get("speed") or 0.5)
    tools = bool(model.get("tools"))
    vision = bool(model.get("vision"))
    reasoning = bool(model.get("reasoning"))
    context = int(model.get("context") or 0)
    reasons: list[str] = []
    fit = quality * 0.55 + speed * 0.10

    def add(condition: bool, value: float, reason: str) -> None:
        nonlocal fit
        if condition:
            fit += value
            reasons.append(reason)

    if task in {"coding", "debugging"}:
        add(any(x in name for x in ["coder", "code", "devstral", "codestral", "qwen", "deepseek", "glm", "kimi", "gpt-oss"]), 0.14, "code-tuned")
        add(tools, 0.08, "tools")
        add(reasoning, 0.06, "reasoning")
        add(context >= 65536, 0.05, "long context")
    elif task in {"analysis", "math", "planning", "review"}:
        add(reasoning, 0.16, "reasoning")
        add(any(x in name for x in ["pro", "opus", "sonnet", "r1", "thinking", "reasoning", "qwq", "o3", "o4", "gemini"]), 0.10, "strong reasoning family")
        add(context >= 131072, 0.06, "long context")
        add(tools, 0.04, "tools")
    elif task in {"writing", "creative"}:
        add(quality >= 0.75, 0.10, "high quality")
        add(not any(x in name for x in ["coder", "code"]), 0.05, "general-purpose")
        add(speed >= 0.6, 0.05, "responsive")
    elif task == "summarization":
        add(context >= 131072, 0.16, "long context")
        add(speed >= 0.6, 0.08, "fast")
        add(tools, 0.02, "tools")
    elif task == "translation":
        add(quality >= 0.7, 0.08, "high quality")
        add(speed >= 0.6, 0.06, "fast")
        add(any(x in name for x in ["qwen", "gemini", "mistral", "llama", "command"]), 0.05, "multilingual family")
    elif task == "extraction":
        add(tools, 0.10, "tools")
        add(bool(model.get("structured_output")), 0.10, "structured output")
        add(speed >= 0.6, 0.08, "fast")
    elif task == "vision":
        add(vision, 0.40, "vision")
    elif task == "agentic":
        add(tools, 0.30, "tools")
        add(reasoning, 0.08, "reasoning")
        add(quality >= 0.7, 0.08, "high quality")
    elif task == "long_context":
        add(context >= 131072, 0.30, "long context")
        add(context >= 500000, 0.15, "very long context")
    else:  # chat
        add(speed >= 0.65, 0.10, "fast")
        add(quality >= 0.65, 0.05, "good quality")
        add(tools, 0.02, "tools")
    return clamp(fit), reasons


def stability_score(model: dict[str, Any]) -> float:
    return FREE_TYPES.get(str(model.get("free_type") or "unknown"), 0.5)


def health_score(health: dict[str, Any]) -> float:
    success = int(health.get("success") or 0)
    failure = int(health.get("failure") or 0)
    prior = 0.85
    return clamp((success + prior * 2) / (success + failure + 2))


def latency_score(health: dict[str, Any]) -> float:
    latency = float(health.get("latency_ms") or 0)
    if latency <= 0:
        return 0.65
    return clamp(1.0 - math.log10(max(latency, 50) / 100) / 3.0, 0.1, 1.0)


def context_score(model: dict[str, Any], need: int) -> float:
    context = int(model.get("context") or 0)
    if need <= 0 or context <= 0:
        return 1.0
    if context >= need:
        return 1.0
    return clamp(context / need, 0.0, 1.0)


def score_model(
    model: dict[str, Any],
    account: dict[str, Any],
    task: str,
    strategy: str = "balanced",
    need_context: int = 0,
) -> dict[str, Any]:
    fit, reasons = model_fit(model, task)
    quota = float(account.get("quota", {}).get("fraction") or 1.0)
    health = health_score(account.get("health") or {})
    latency = latency_score(account.get("health") or {})
    stability = stability_score(model)
    ctx = context_score(model, need_context)
    weights = dict(TASK_WEIGHTS.get(task, TASK_WEIGHTS["chat"]))
    if strategy == "quality":
        weights["fit"] += 0.15
        weights["quota"] -= 0.05
    elif strategy == "speed":
        weights["latency"] += 0.15
        weights["fit"] -= 0.05
    elif strategy == "cheap":
        weights["quota"] += 0.15
        weights["fit"] -= 0.08
    elif strategy == "least-used":
        weights["quota"] += 0.10
    total_weight = sum(max(0.0, v) for v in weights.values()) or 1.0
    score = (
        fit * weights["fit"]
        + quota * weights["quota"]
        + health * weights["health"]
        + stability * weights["stability"]
        + ctx * weights["context"]
        + latency * weights["latency"]
    ) / total_weight
    # Small deterministic jitter so equal models do not always collide.
    jitter = int(hashlib.sha256(f"{model.get('id')}:{account.get('id')}".encode()).hexdigest()[:4], 16) / 65535.0
    score = clamp(score * 0.99 + jitter * 0.01)
    if quota < 0.15:
        reasons.append("low quota")
    if health < 0.5:
        reasons.append("unhealthy")
    if model.get("source") == "local":
        reasons.append("local")
    return {
        "score": round(score, 4),
        "fit": round(fit, 3),
        "quota": round(quota, 3),
        "health": round(health, 3),
        "latency": round(latency, 3),
        "stability": round(stability, 3),
        "context_fit": round(ctx, 3),
        "reasons": reasons,
        "account": account,
    }


def allowed_tos(config: dict[str, Any]) -> set[str]:
    values = config.get("routing", {}).get("allow_tos") or ["ok", "caution", "unknown", "ambiguous"]
    return {str(x).lower() for x in values}


def pick_models(
    task: str,
    limit: int = 8,
    strategy: str | None = None,
    need_tools: bool = False,
    need_vision: bool = False,
    need_context: int = 0,
    explicit_model: str | None = None,
    include_unavailable: bool = False,
    strict_tos: bool | None = None,
) -> list[dict[str, Any]]:
    config = load_config()
    strategy = strategy or str(config.get("routing", {}).get("strategy") or "balanced")
    tos_ok = allowed_tos(config)
    if strict_tos is None:
        strict_tos = bool(config.get("routing", {}).get("strict_tos"))
    if strict_tos:
        tos_ok.discard("ambiguous")
    catalog = load_catalog()
    conn = connect()
    try:
        candidates: list[dict[str, Any]] = []
        # Discover once per call: with a 1000+ model catalog, doing it per model
        # turns routing into a multi-second scan.
        pool = discover_accounts(config)
        accounts_by_provider: dict[str, list[dict[str, Any]]] = {}
        for acct in pool:
            accounts_by_provider.setdefault(str(acct["provider"]), []).append(acct)
        usage_cache = {acct["id"]: usage_for(acct["id"], conn) for acct in pool}
        for model in catalog.get("models") or []:
            if not isinstance(model, dict):
                continue
            if model.get("free_type") == "discontinued" or not model.get("routable"):
                continue
            if str(model.get("tos") or "").lower() not in tos_ok:
                continue
            if need_tools and not model.get("tools"):
                continue
            if need_vision and not model.get("vision"):
                continue
            if need_context and int(model.get("context") or 0) < need_context:
                continue
            if explicit_model and model.get("id") != explicit_model and model.get("model") != explicit_model:
                continue
            provider_accounts = accounts_by_provider.get(str(model.get("provider")), [])
            if not provider_accounts:
                if include_unavailable:
                    candidates.append({"model": model, "account": None, "score": 0.0,
                                       "reasons": ["no configured account"]})
                continue
            accounts = available_accounts(model, config, conn, provider_accounts, usage_cache)
            if not accounts:
                if include_unavailable:
                    candidates.append({"model": model, "account": None, "score": 0.0,
                                       "reasons": ["account cooling down or out of quota"]})
                continue
            for acct in accounts:
                scored = score_model(model, acct, task, strategy, need_context)
                candidates.append({"model": model, **scored})
        if explicit_model and not candidates:
            model = catalog_model(explicit_model)
            if model:
                candidates.append({"model": model, "account": None, "score": 0.0,
                                   "reasons": ["explicit model has no configured free account"]})
        if not candidates and not include_unavailable:
            # Last resort: include local discovery placeholders if their endpoint is up.
            for model in catalog.get("models") or []:
                if model.get("source") != "local":
                    continue
                accounts = available_accounts(model, config, conn,
                                              accounts_by_provider.get(str(model.get("provider"))))
                if accounts:
                    scored = score_model(model, accounts[0], task, strategy, need_context)
                    candidates.append({"model": model, **scored})
        candidates.sort(key=lambda c: c.get("score", 0), reverse=True)
        # Prefer accounts without recent failures; still fall back to unhealthy ones.
        candidates.sort(key=lambda c: (float(c.get("health", 1.0)) < 0.5,
                                       -float(c.get("score", 0))))
        # Keep the best account per model, then diversify providers a little.
        best: list[dict[str, Any]] = []
        seen_models: set[str] = set()
        for candidate in candidates:
            mid = candidate["model"]["id"]
            if mid in seen_models:
                continue
            seen_models.add(mid)
            best.append(candidate)
        if strategy == "round-robin":
            best.sort(key=lambda c: (c["account"].get("health", {}).get("last_used") or "", -c.get("score", 0)))
        elif strategy == "least-used":
            best.sort(key=lambda c: (c["account"].get("quota", {}).get("used", 0), -c.get("score", 0)))
        return best[: max(1, limit)]
    finally:
        conn.close()


