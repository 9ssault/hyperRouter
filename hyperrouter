def human_count(value: float) -> str:
    value = float(value or 0)
    for unit in ("", "k", "M", "B"):
        if abs(value) < 1000 or unit == "B":
            return f"{value:.0f}" if unit == "" else f"{value:.1f}{unit}"
        value /= 1000.0
    return str(value)


def sparkline(values: Sequence[float]) -> str:
    if not values:
        return ""
    blocks = "▁▂▃▄▅▆▇█"
    peak = max(values) or 1
    return "".join(blocks[min(len(blocks) - 1, int((v / peak) * (len(blocks) - 1)))] for v in values)


_USAGE_DIMENSIONS = {"provider", "model", "task", "day", "account"}


def cmd_usage(args: argparse.Namespace) -> int:
    config = load_config()
    days = int(args.days or config.get("usage", {}).get("window_days") or 7)
    days = max(1, min(days, 3650))
    by = args.by or "provider"
    if by not in _USAGE_DIMENSIONS:
        die(f"--by must be one of: {', '.join(sorted(_USAGE_DIMENSIONS))}")
    limit = int(args.limit or config.get("usage", {}).get("rows") or 12)
    since = (datetime.now(timezone.utc) - timedelta(days=days)).isoformat(timespec="seconds")
    where = ["ts >= ?"]
    params: list[Any] = [since]
    if args.provider:
        where.append("provider = ?")
        params.append(args.provider)
    if args.model:
        where.append("model = ?")
        params.append(args.model)
    clause = " AND ".join(where)
    group = {"provider": "provider", "model": "provider, model", "task": "task",
             "day": "substr(ts, 1, 10)", "account": "account_id"}[by]
    conn = connect()
    try:
        totals = conn.execute(
            f"""SELECT COUNT(*) n, SUM(CASE WHEN status='ok' THEN 1 ELSE 0 END) ok,
                       COALESCE(SUM(tokens_in),0) tin, COALESCE(SUM(tokens_out),0) tout,
                       COALESCE(AVG(latency_ms),0) lat
                FROM requests WHERE {clause}""", params).fetchone()
        rows = conn.execute(
            f"""SELECT {group} AS bucket, COUNT(*) n,
                       SUM(CASE WHEN status='ok' THEN 1 ELSE 0 END) ok,
                       COALESCE(SUM(tokens_in),0) tin, COALESCE(SUM(tokens_out),0) tout,
                       COALESCE(AVG(latency_ms),0) lat
                FROM requests WHERE {clause}
                GROUP BY bucket ORDER BY n DESC, tin DESC LIMIT ?""",
            params + [limit]).fetchall()
        daily = conn.execute(
            f"""SELECT substr(ts,1,10) day, COUNT(*) n, COALESCE(SUM(tokens_in+tokens_out),0) tok
                FROM requests WHERE {clause} GROUP BY day ORDER BY day""", params).fetchall()
        recent = conn.execute(
            f"""SELECT ts, provider, model, status, tokens_in, tokens_out, latency_ms
                FROM requests WHERE {clause} ORDER BY ts DESC LIMIT 6""", params).fetchall()
        accounts = discover_accounts(config)
        quota_rows = []
        for acct in accounts[:20]:
            model = next((m for m in load_catalog().get("models") or []
                          if m.get("provider") == acct["provider"] and m.get("routable")), None)
            if not model:
                continue
            quota = quota_state(acct, model, conn)
            quota_rows.append({"provider": acct["provider"], "label": acct["label"],
                               "quota": quota})
    finally:
        conn.close()
    data = {
        "window_days": days, "since": since, "by": by,
        "totals": {"requests": int(totals["n"] or 0), "ok": int(totals["ok"] or 0),
                   "failed": int(totals["n"] or 0) - int(totals["ok"] or 0),
                   "tokens_in": int(totals["tin"] or 0), "tokens_out": int(totals["tout"] or 0),
                   "avg_latency_ms": round(float(totals["lat"] or 0), 1)},
        "rows": [dict(row) for row in rows],
        "daily": [dict(row) for row in daily],
        "recent": [dict(row) for row in recent],
        "quota": quota_rows,
    }
    if args.json:
        print(json.dumps(data, indent=2, default=str))
        return 0
    t = data["totals"]
    if not t["requests"]:
        print(f"No requests in the last {days} day(s). Try: {PROG} chat")
        return 0
    rate = 0.0 if not t["requests"] else (t["ok"] / t["requests"]) * 100
    print(f"{PRODUCT} usage — last {days} day(s)")
    print(f"  requests  {t['requests']}  ({t['ok']} ok, {t['failed']} failed, {rate:.0f}% success)")
    print(f"  tokens    {human_count(t['tokens_in'])} in / {human_count(t['tokens_out'])} out")
    print(f"  latency   {t['avg_latency_ms'] / 1000:.2f}s average")
    if data["daily"]:
        values = [float(row["tok"]) for row in data["daily"]]
        spark = sparkline(values)
        print(f"  daily     {spark}  ({data['daily'][0]['day']} → {data['daily'][-1]['day']})")
    print(f"\nBy {by}:")
    header = {"provider": "provider", "model": "model", "task": "task",
              "day": "day", "account": "account"}[by]
    print(f"  {header:<34} {'req':>5} {'ok':>5} {'in':>8} {'out':>8} {'avg':>7}")
    for row in data["rows"]:
        bucket = row["bucket"] if row["bucket"] is not None else "(unknown)"
        print(f"  {str(bucket)[:34]:<34} {row['n']:>5} {int(row['ok'] or 0):>5} "
              f"{human_count(row['tin']):>8} {human_count(row['tout']):>8} "
              f"{float(row['lat'] or 0) / 1000:>6.2f}s")
    if data["recent"]:
        print("\nRecent:")
        for row in data["recent"]:
            status = "ok" if row["status"] == "ok" else str(row["status"])
            print(f"  {str(row['ts'])[:19]}  {status:<6} {str(row['provider'])}/{row['model']}")
    if data["quota"]:
        print("\nRemaining quota:")
        for item in data["quota"]:
            q = item["quota"]
            left = "unlimited" if q["remaining"] < 0 else f"{q['fraction'] * 100:.0f}%"
            print(f"  {item['provider']:<18} {item['label']:<20} {left}")
    return 0


def _session_rows(config: dict[str, Any]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for path in sorted(sessions_dir().glob("*.json"), key=lambda p: p.stat().st_mtime,
                       reverse=True):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        messages = data.get("messages") if isinstance(data, dict) else data
        if not isinstance(messages, list):
            messages = []
        rows.append({"name": path.stem, "path": str(path), "kind": "session",
                     "messages": len(messages), "model": (data.get("model")
                                                          if isinstance(data, dict) else ""),
                     "updated": datetime.fromtimestamp(path.stat().st_mtime).isoformat(timespec="seconds")})
    for path in sorted(transcript_dir(config).glob("*.jsonl"),
                       key=lambda p: p.stat().st_mtime, reverse=True):
        count = 0
        try:
            with path.open(encoding="utf-8") as fh:
                count = sum(1 for line in fh if line.strip())
        except OSError:
            continue
        rows.append({"name": path.stem, "path": str(path), "kind": "transcript",
                     "messages": count, "model": "",
                     "updated": datetime.fromtimestamp(path.stat().st_mtime).isoformat(timespec="seconds")})
    return rows


def cmd_sessions(args: argparse.Namespace) -> int:
    config = load_config()
    action = args.action or "list"
    rows = _session_rows(config)
    target = (args.name or "").strip()
    if action == "list":
        if args.json:
            print(json.dumps(rows, indent=2))
            return 0
        if not rows:
            print("no saved sessions yet - the TUI writes one per conversation")
            return 0
        print(f"{'name':<34} {'kind':<11} {'msgs':>5}  {'updated':<20} model")
        for row in rows[:60]:
            print(f"{row['name'][:34]:<34} {row['kind']:<11} {row['messages']:>5}  "
                  f"{row['updated']:<20} {row['model'] or ''}")
        print(f"\n{len(rows)} item(s) in {sessions_dir()} and {transcript_dir(config)}")
        return 0
    chosen = next((row for row in rows if row["name"] == target), None)
    if chosen is None:
        die(f"no session or transcript named {target!r} (see `{PROG} sessions list`)")
    path = Path(chosen["path"])
    if action in {"show", "export"}:
        if chosen["kind"] == "session":
            data = json.loads(path.read_text(encoding="utf-8"))
            messages = data.get("messages") if isinstance(data, dict) else data
            messages = [m for m in (messages or []) if isinstance(m, dict)]
        else:
            messages = []
            with path.open(encoding="utf-8") as fh:
                for line in fh:
                    try:
                        entry = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if isinstance(entry, dict):
                        messages.append({"role": str(entry.get("role") or "info"),
                                         "content": str(entry.get("content") or "")})
        if action == "show":
            limit = max(1, min(int(args.limit or 20), 200))
            for message in messages[-limit:]:
                print(f"## {message.get('role')}\n{content_to_text(message.get('content'))[:2000]}\n")
            return 0
        target_path = Path(os.path.expanduser(args.output)) if args.output else (
            Path.cwd() / f"{chosen['name']}.md")
        lines = [f"# {PRODUCT} session: {chosen['name']}", ""]
        for message in messages:
            lines.extend([f"## {message.get('role')}", "",
                          content_to_text(message.get("content")), ""])
        target_path.write_text("\n".join(lines), encoding="utf-8")
        print(f"exported {len(messages)} message(s) to {target_path}")
        return 0
    if action == "resume":
        if chosen["kind"] != "session":
            die("only TUI sessions can be resumed; transcripts are read-only history")
        print(f"{PROG} chat --session {shlex_join([str(path)])}")
        return 0
    if action == "delete":
        if not args.yes:
            die("refusing to delete without --yes")
        path.unlink(missing_ok=True)
        print(f"deleted {path}")
        return 0
    if action == "prune":
        days = max(1, int(args.days or 30))
        cutoff = time.time() - days * 86400
        removed = 0
        for row in rows:
            candidate = Path(row["path"])
            if candidate.stat().st_mtime >= cutoff:
                continue
            if args.dry_run:
                print(f"would delete {candidate}")
                continue
            if not args.yes:
                die("refusing to prune without --yes")
            candidate.unlink(missing_ok=True)
            removed += 1
        print(f"pruned {removed} item(s) older than {days} day(s)" if not args.dry_run
              else f"{sum(1 for r in rows if Path(r['path']).stat().st_mtime < cutoff)} "
                   f"item(s) older than {days} day(s)")
        return 0
    die(f"unknown sessions action: {action}")
    return 2


def cmd_uninstall(args: argparse.Namespace) -> int:
    script = Path(__file__).resolve()
    targets = [script]
    for name in ("hyperRouter", "agent-router"):
        link = script.with_name(name)
        if link.is_symlink() or (link.exists() and link.resolve() == script):
            targets.append(link)
    config_dir = CONFIG_PATH.parent
    data_dir = DATA_HOME
    actions = [f"remove {path}" for path in targets]
    if args.purge:
        actions.append(f"remove {config_dir}")
        actions.append(f"remove {data_dir}")
    if args.dry_run:
        for action in actions:
            print(f"would {action}")
        return 0
    if not args.yes:
        die("refusing to uninstall without --yes (try --dry-run first)")
    if not args.keep_service:
        try:
            service_stop()
        except Exception:  # noqa: BLE001 - uninstall must not fail on a missing service
            pass
    for path in targets:
        try:
            path.unlink()
            print(f"removed {path}")
        except FileNotFoundError:
            pass
        except OSError as exc:
            eprint(f"{PROG}: could not remove {path}: {exc}")
    if args.purge:
        for path in (config_dir, data_dir):
            shutil.rmtree(path, ignore_errors=True)
            print(f"removed {path}")
    print("uninstalled. Provider keys in your shell profile were left alone.")
    return 0


