def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def eprint(*args: Any) -> None:
    print(*args, file=sys.stderr)


def die(message: str, code: int = 1) -> "NoReturn":
    eprint(f"hyperrouter: {message}")
    raise SystemExit(code)


def clamp(value: float, lo: float = 0.0, hi: float = 1.0) -> float:
    return max(lo, min(hi, value))


def estimate_tokens(text: str) -> int:
    if not text:
        return 0
    return max(1, math.ceil(len(text) / 4))


def redact(text: str) -> str:
    text = re.sub(r"sk-[A-Za-z0-9_-]{8,}", "sk-***", text)
    text = re.sub(r"(?i)(authorization:\s*bearer\s+)[^\s,;]+", r"\1***", text)
    text = re.sub(r"(?i)(api[_-]?key[\"'=:\s]+)[A-Za-z0-9._-]{8,}", r"\1***", text)
    return text


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""


def write_text(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    dest = path.with_name(path.name + f".bak-{stamp}")
    shutil.copy2(path, dest)
    try:
        os.chmod(dest, 0o600)
    except OSError:
        pass
    return dest


def strip_jsonc(text: str) -> str:
    out: list[str] = []
    i = 0
    in_string = False
    escaped = False
    while i < len(text):
        ch = text[i]
        if in_string:
            out.append(ch)
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            out.append(ch)
            i += 1
            continue
        if ch == "/" and i + 1 < len(text):
            if text[i + 1] == "/":
                nl = text.find("\n", i)
                if nl == -1:
                    break
                i = nl
                continue
            if text[i + 1] == "*":
                end = text.find("*/", i + 2)
                i = len(text) if end == -1 else end + 2
                continue
        out.append(ch)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))


def load_json(path: Path, default: Any = None) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return copy.deepcopy(default)
    except json.JSONDecodeError as exc:
        raise ValueError(f"{path}: invalid JSON ({exc})") from exc


def load_jsonc(path: Path, default: Any = None) -> Any:
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return copy.deepcopy(default)
    try:
        return json.loads(strip_jsonc(text))
    except json.JSONDecodeError as exc:
        raise ValueError(f"{path}: invalid JSON/JSONC ({exc})") from exc


def save_json(path: Path, data: Any, dry_run: bool = False) -> None:
    if dry_run:
        return
    backup(path)
    write_text(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def migrate_legacy_home() -> None:
    """Carry data over from the pre-rename `agent-router` directories once."""
    for old, new in ((LEGACY_DATA_HOME, DATA_HOME), (LEGACY_CONFIG_HOME, CONFIG_HOME)):
        if old.is_dir() and not new.exists():
            try:
                shutil.copytree(old, new, dirs_exist_ok=True)
            except OSError:
                continue


def ensure_dirs() -> None:
    migrate_legacy_home()
    DATA_HOME.mkdir(parents=True, exist_ok=True, mode=0o700)
    CONFIG_HOME.mkdir(parents=True, exist_ok=True, mode=0o700)


def load_config() -> dict[str, Any]:
    data = load_json(CONFIG_PATH, DEFAULT_CONFIG)
    if not isinstance(data, dict):
        raise ValueError(f"{CONFIG_PATH}: top-level must be an object")
    merged = copy.deepcopy(DEFAULT_CONFIG)
    for key, value in data.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key].update(value)
        else:
            merged[key] = value
    return merged


def save_config(config: dict[str, Any], dry_run: bool = False) -> None:
    save_json(CONFIG_PATH, config, dry_run=dry_run)


def http_request(
    method: str,
    url: str,
    headers: dict[str, str] | None = None,
    data: bytes | None = None,
    timeout: float = 300.0,
) -> tuple[int, dict[str, str], bytes]:
    req = urllib.request.Request(url, data=data, headers=headers or {}, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, {k.lower(): v for k, v in resp.headers.items()}, resp.read()
    except urllib.error.HTTPError as exc:
        return exc.code, {k.lower(): v for k, v in exc.headers.items()}, exc.read()
    except urllib.error.URLError as exc:
        return 0, {}, str(exc.reason).encode("utf-8", "replace")
    except TimeoutError:
        return 0, {}, b"timeout"


def http_json(
    method: str,
    url: str,
    headers: dict[str, str] | None = None,
    payload: Any = None,
    timeout: float = 300.0,
) -> tuple[int, dict[str, str], Any]:
    data = None
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers = {**(headers or {}), "Content-Type": "application/json"}
    status, hdrs, raw = http_request(method, url, headers, data, timeout)
    try:
        body = json.loads(raw.decode("utf-8", "replace")) if raw else None
    except json.JSONDecodeError:
        body = raw.decode("utf-8", "replace")
    return status, hdrs, body


