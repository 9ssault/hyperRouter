def skill_search_dirs() -> list[Path]:
    dirs = [SKILL_ROOT, HOME / ".agents" / "skills"]
    cwd = Path.cwd()
    dirs.extend([cwd / ".agents" / "skills", cwd / ".skills", cwd / "skills"])
    seen: list[Path] = []
    for path in dirs:
        if path.is_dir() and path not in seen:
            seen.append(path)
    return seen


def parse_frontmatter(text: str) -> tuple[dict[str, str], str]:
    meta: dict[str, str] = {}
    body = text
    if text.startswith("---"):
        end = text.find("\n---", 3)
        if end != -1:
            header = text[3:end]
            body = text[end + 4:].lstrip("\n")
            lines = header.splitlines()
            index = 0
            while index < len(lines):
                line = lines[index]
                index += 1
                if ":" not in line or line.lstrip().startswith("#"):
                    continue
                key, value = line.split(":", 1)
                value = value.strip().strip('"\'')
                if value in {">", "|", ">-", "|-", ">+", "|+"}:
                    block = []
                    while index < len(lines) and (lines[index].startswith(" ") or not lines[index].strip()):
                        block.append(lines[index].strip())
                        index += 1
                    value = " ".join(part for part in block if part)
                meta[key.strip()] = value
    return meta, body


def discover_skills() -> list[dict[str, Any]]:
    skills: list[dict[str, Any]] = []
    seen: set[str] = set()
    for root in skill_search_dirs():
        for path in sorted(root.rglob("SKILL.md")):
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            meta, body = parse_frontmatter(text)
            name = str(meta.get("name") or path.parent.name).strip()
            if not name or name in seen:
                continue
            seen.add(name)
            skills.append({
                "name": name, "description": str(meta.get("description") or "").strip(),
                "path": str(path), "root": str(root), "body": body,
                "license": str(meta.get("license") or ""),
                "tokens": estimate_tokens(body),
            })
    return skills


def find_skill(name: str) -> dict[str, Any] | None:
    low = name.strip().lower()
    for skill in discover_skills():
        if skill["name"].lower() == low or skill["name"].lower().split(":")[-1] == low:
            return skill
    for skill in discover_skills():
        if low in skill["name"].lower():
            return skill
    return None


def skill_context(names: Sequence[str], limit_tokens: int = 6000) -> str:
    """Full instructions for the named skills, size-capped."""
    chunks: list[str] = []
    used = 0
    for name in names:
        skill = find_skill(name)
        if not skill:
            eprint(f"{PROG}: unknown skill: {name} (try `{PROG} skills list`)")
            continue
        body = skill["body"]
        budget = limit_tokens - used
        if budget <= 0:
            break
        if estimate_tokens(body) > budget:
            body = body[: budget * 4] + "\n... (truncated)"
        chunks.append(f"## Skill: {skill['name']}\n{skill['description']}\n\n{body}")
        used += estimate_tokens(body)
    return "\n\n".join(chunks)


def skill_catalog_text(limit: int = 60) -> str:
    """Name + description only, for progressive disclosure in the system prompt."""
    skills = discover_skills()
    if not skills:
        return ""
    lines = ["Available skills (ask to use one by name):"]
    for skill in skills[:limit]:
        desc = skill["description"][:110]
        lines.append(f"- {skill['name']}: {desc}")
    return "\n".join(lines)


def install_skill_repo(target: str, name: str | None = None) -> tuple[bool, str]:
    if not shutil.which("git"):
        return False, "git is not installed"
    value = target.strip()
    if value.startswith("http://") or value.startswith("https://"):
        url = value
        name = name or url.rstrip("/").split("/")[-1].removesuffix(".git")
    elif "/" in value and not Path(value).exists():
        url = f"https://github.com/{value}.git"
        name = name or value.split("/")[-1]
    else:
        path = Path(value).expanduser()
        if not path.is_dir():
            return False, f"not a local directory: {value}"
        url = str(path)
        name = name or path.name
    SKILL_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    destination = SKILL_ROOT / name
    if destination.exists():
        return False, f"already installed at {destination} (remove it first to update)"
    result = subprocess.run(["git", "clone", "--depth", "1", url, str(destination)],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=300, check=False)
    if result.returncode != 0:
        return False, result.stderr.decode("utf-8", "replace").strip()[:400]
    found = len(list(destination.rglob("SKILL.md")))
    write_skill_provenance(destination, url)
    return True, f"installed {name} with {found} skill(s) into {destination}"


def write_skill_provenance(destination: Path, repo: str) -> dict[str, Any]:
    """Record where a collection came from, plus how much runnable code it ships."""
    if not repo or repo.startswith("(unknown"):
        repo = next((name for name, folder in DEFAULT_SKILL_COLLECTIONS.items()
                     if folder == destination.name), repo)
    commit = ""
    try:
        proc = subprocess.run(["git", "-C", str(destination), "rev-parse", "HEAD"],
                              capture_output=True, text=True, timeout=20, check=False)
        commit = proc.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    scripts = 0
    executables = 0
    for file in destination.rglob("*"):
        if not file.is_file():
            continue
        if file.suffix in {".sh", ".py", ".js", ".ts", ".ps1", ".rb"}:
            scripts += 1
            if os.access(file, os.X_OK):
                executables += 1
    data = {"repo": repo, "commit": commit, "installed_at": utc_now(),
            "skills": len(list(destination.rglob("SKILL.md"))),
            "scripts": scripts, "executables": executables}
    try:
        (destination / ".provenance.json").write_text(
            json.dumps(data, indent=2) + "\n", encoding="utf-8")
    except OSError:
        pass
    return data


def collect_provenance() -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for root in (SKILL_ROOT, HOME / ".agents" / "skills"):
        if not root.is_dir():
            continue
        for entry in sorted(root.iterdir()):
            if not entry.is_dir():
                continue
            data: dict[str, Any] = {}
            marker = entry / ".provenance.json"
            if marker.is_file():
                try:
                    data = json.loads(marker.read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError):
                    data = {}
            data.setdefault("name", entry.name)
            data.setdefault("path", str(entry))
            data.setdefault("skills", len(list(entry.rglob("SKILL.md"))))
            data.setdefault("repo", "(unknown - installed before provenance)")
            rows.append(data)
    return rows


def project_skills_path() -> Path:
    return Path.cwd() / ".hyperrouter" / "skills.json"


def project_skills() -> list[str]:
    path = project_skills_path()
    if not path.is_file():
        return []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    items = data.get("skills") if isinstance(data, dict) else data
    return [str(item) for item in (items or []) if str(item).strip()]


def set_project_skills(names: Sequence[str]) -> None:
    path = project_skills_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"skills": list(names)}, indent=2) + "\n", encoding="utf-8")


def ensure_default_skills(verbose: bool = True) -> list[str]:
    """Install every collection in DEFAULT_SKILL_COLLECTIONS that is missing."""
    actions: list[str] = []
    for repo, folder in DEFAULT_SKILL_COLLECTIONS.items():
        destination = SKILL_ROOT / folder
        if destination.exists():
            continue
        ok, message = install_skill_repo(repo, name=folder)
        if verbose:
            print(message)
        actions.append(f"skills: {'installed' if ok else 'failed'} {repo} -> {message}")
    if verbose and not actions:
        print(f"skills: all {len(DEFAULT_SKILL_COLLECTIONS)} default collections are installed")
    return actions


def cmd_skills(args: argparse.Namespace) -> int:
    action = args.action or "list"
    if action in {"install-defaults", "defaults", "sync"}:
        actions = ensure_default_skills(verbose=True)
        total = len(discover_skills())
        print(f"{len(DEFAULT_SKILL_COLLECTIONS)} default collections, {total} skill(s) installed")
        return 0 if not any("failed" in line for line in actions) else 1
    if action == "path":
        print(SKILL_ROOT)
        for path in skill_search_dirs():
            print(path)
        return 0
    if action == "update":
        updated = 0
        for row in collect_provenance():
            path = Path(str(row.get("path")))
            if not (path / ".git").exists():
                print(f"skip   {path.name} (not a git checkout)")
                continue
            proc = subprocess.run(["git", "-C", str(path), "pull", "--ff-only"],
                                  capture_output=True, text=True, timeout=180, check=False)
            status = "updated" if proc.returncode == 0 else "failed"
            if proc.returncode == 0:
                updated += 1
                write_skill_provenance(path, "")
            detail = (proc.stdout or proc.stderr).strip().splitlines()
            print(f"{status:<7} {path.name}" + (f" - {detail[-1][:100]}" if detail else ""))
        print(f"{updated} collection(s) updated, {len(discover_skills())} skill(s) available")
        return 0
    if action == "trust":
        rows = collect_provenance()
        print(f"{'collection':<34} {'skills':>6} {'scripts':>7}  origin")
        risky = 0
        for row in rows:
            scripts = int(row.get("scripts") or 0)
            risky += 1 if scripts else 0
            origin = str(row.get("repo") or "")[:60]
            print(f"{str(row.get('name'))[:34]:<34} {int(row.get('skills') or 0):>6} "
                  f"{scripts:>7}  {origin}")
        print(f"\n{len(rows)} collection(s); {risky} ship runnable scripts. Skills are "
              "instructions, not sandboxed code - review before trusting a repo.")
        return 0
    if action in {"pin", "unpin"}:
        if not args.target:
            die(f"usage: hyperrouter skills {action} <name>")
        names = project_skills()
        if action == "pin":
            if not find_skill(args.target):
                die(f"unknown skill: {args.target}")
            if args.target not in names:
                names.append(args.target)
        else:
            names = [name for name in names if name != args.target]
        set_project_skills(names)
        print(f"{args.target} {'pinned to' if action == 'pin' else 'unpinned from'} "
              f"{project_skills_path()}")
        return 0
    if action == "dedupe":
        seen: dict[str, list[str]] = {}
        for skill in discover_skills():
            seen.setdefault(str(skill["name"]), []).append(str(skill["path"]))
        duplicates = {name: paths for name, paths in seen.items() if len(paths) > 1}
        if not duplicates:
            print(f"no duplicate skill names across {len(seen)} skill(s)")
            return 0
        for name, paths in sorted(duplicates.items()):
            print(f"{name}:")
            for path in paths:
                print(f"  {path}")
        print(f"\n{len(duplicates)} duplicated name(s); the first path in the search "
              "order wins. Remove a collection to change precedence.")
        return 0
    if action == "install":
        if not args.target:
            die("usage: hyperrouter skills install <owner/repo | url | dir>")
        ok, message = install_skill_repo(args.target)
        print(message)
        return 0 if ok else 1
    if action == "remove":
        if not args.target:
            die("usage: hyperrouter skills remove <name>")
        skill = find_skill(args.target)
        if not skill:
            die(f"unknown skill: {args.target}")
        path = Path(skill["path"]).parent
        if SKILL_ROOT not in path.parents and HOME / ".agents" not in path.parents:
            die(f"refusing to remove {path} (outside the managed skill directories)")
        shutil.rmtree(path)
        print(f"removed {path}")
        return 0
    skills = discover_skills()
    if args.search:
        needle = args.search.lower()
        skills = [s for s in skills if needle in s["name"].lower() or needle in s["description"].lower()]
    if action == "show":
        if not args.target:
            die("usage: hyperrouter skills show <name>")
        skill = find_skill(args.target)
        if not skill:
            die(f"unknown skill: {args.target}")
        print(f"# {skill['name']}\n{skill['description']}\n")
        print(skill["body"])
        return 0
    if args.json:
        print(json.dumps([{k: v for k, v in s.items() if k != "body"} for s in skills], indent=2))
        return 0
    if not skills:
        print("No skills found.")
        print(f"Install some: {PROG} skills install {ANTHROPIC_SKILLS_REPO}")
        return 0
    print(f"{'name':<28} {'tokens':>6}  description")
    for skill in skills:
        print(f"{skill['name']:<28} {skill['tokens']:>6}  {skill['description'][:96]}")
    print(f"\n{len(skills)} skill(s). Roots: " + ", ".join(str(p) for p in skill_search_dirs()))
    return 0


