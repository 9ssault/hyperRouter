def account_env_names(provider: str) -> list[str]:
    meta = provider_meta(provider)
    names = [str(x) for x in (meta.get("env") or []) if x]
    # Common fallbacks
    upper = re.sub(r"[^A-Z0-9]+", "_", provider.upper()).strip("_")
    for candidate in (f"{upper}_API_KEY", f"{upper}_KEY", f"{upper}_TOKEN"):
        if candidate not in names:
            names.append(candidate)
    return names


def env_value(name: str) -> str:
    return (os.environ.get(name) or "").strip()


def discover_accounts(config: dict[str, Any] | None = None) -> list[dict[str, Any]]:
    config = config or load_config()
    catalog = load_catalog()
    accounts: list[dict[str, Any]] = []
    seen: set[str] = set()

    # Explicit account references from config.
    for item in config.get("accounts") or []:
        if not isinstance(item, dict):
            continue
        provider = str(item.get("provider") or "")
        env = str(item.get("env") or "")
        if not provider:
            continue
        key = env_value(env) if env else ""
        if env and not key:
            continue
        ident = f"{provider}:{env or 'keyless'}:{item.get('label') or env or 'default'}"
        if ident in seen:
            continue
        seen.add(ident)
        accounts.append({
            "id": ident,
            "provider": provider,
            "env": env,
            "key": key,
            "label": str(item.get("label") or env or "default"),
            "monthly_limit": int(item.get("monthly_limit") or 0),
            "daily_limit": int(item.get("daily_limit") or 0),
            "weight": float(item.get("weight") or 1.0),
            "disabled": bool(item.get("disabled") or False),
            "source": "config",
        })

    # Environment-discovered accounts.
    routable_providers = {
        str(m.get("provider")) for m in (catalog.get("models") or [])
        if isinstance(m, dict) and m.get("routable")
    }
    for provider, meta in (catalog.get("providers") or {}).items():
        if not isinstance(meta, dict):
            continue
        env_names = account_env_names(provider)
        found = False
        for base in env_names:
            candidates = [base] + [f"{base}_{i}" for i in range(2, 10)] + [f"{base}_ALT", f"{base}_BACKUP"]
            for name in candidates:
                key = env_value(name)
                if not key:
                    continue
                found = True
                ident = f"{provider}:{name}:{name}"
                if ident in seen:
                    continue
                seen.add(ident)
                accounts.append({
                    "id": ident, "provider": provider, "env": name, "key": key,
                    "label": name, "monthly_limit": 0, "daily_limit": 0,
                    "weight": 1.0, "disabled": False, "source": "env",
                })
        if (not found and str(meta.get("auth") or "") in {"none", "optional"}
                and provider in routable_providers):
            ident = f"{provider}:keyless:keyless"
            if ident not in seen:
                seen.add(ident)
                accounts.append({
                    "id": ident, "provider": provider, "env": "", "key": "",
                    "label": "keyless", "monthly_limit": 0, "daily_limit": 0,
                    "weight": 1.0, "disabled": False, "source": "keyless",
                })
    return accounts


def connect() -> sqlite3.Connection:
    ensure_dirs()
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS accounts (
            id TEXT PRIMARY KEY,
            provider TEXT NOT NULL,
            env TEXT,
            label TEXT,
            monthly_limit INTEGER DEFAULT 0,
            daily_limit INTEGER DEFAULT 0,
            weight REAL DEFAULT 1.0,
            disabled INTEGER DEFAULT 0,
            updated_at TEXT
        );
        CREATE TABLE IF NOT EXISTS usage (
            account_id TEXT NOT NULL,
            window TEXT NOT NULL,
            tokens_in INTEGER DEFAULT 0,
            tokens_out INTEGER DEFAULT 0,
            requests INTEGER DEFAULT 0,
            PRIMARY KEY (account_id, window)
        );
        CREATE TABLE IF NOT EXISTS health (
            account_id TEXT PRIMARY KEY,
            success INTEGER DEFAULT 0,
            failure INTEGER DEFAULT 0,
            latency_ms REAL DEFAULT 0,
            last_used TEXT,
            cooldown_until TEXT,
            last_error TEXT
        );
        CREATE TABLE IF NOT EXISTS model_health (
            account_id TEXT NOT NULL,
            model TEXT NOT NULL,
            success INTEGER DEFAULT 0,
            failure INTEGER DEFAULT 0,
            cooldown_until TEXT,
            last_error TEXT,
            PRIMARY KEY (account_id, model)
        );
        CREATE TABLE IF NOT EXISTS requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts TEXT NOT NULL,
            task TEXT,
            provider TEXT,
            model TEXT,
            account_id TEXT,
            status TEXT,
            http_status INTEGER,
            tokens_in INTEGER DEFAULT 0,
            tokens_out INTEGER DEFAULT 0,
            latency_ms REAL DEFAULT 0,
            error TEXT
        );
        CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT);
        CREATE TABLE IF NOT EXISTS api_keys (
            id TEXT PRIMARY KEY,
            label TEXT NOT NULL,
            key_hash TEXT NOT NULL UNIQUE,
            prefix TEXT NOT NULL,
            created_at TEXT NOT NULL,
            last_used TEXT,
            revoked INTEGER DEFAULT 0
        );
        CREATE INDEX IF NOT EXISTS idx_requests_ts ON requests(ts);
        """
    )
    return conn


def register_accounts(accounts: Iterable[dict[str, Any]], conn: sqlite3.Connection | None = None) -> None:
    own = conn is None
    conn = conn or connect()
    try:
        now = utc_now()
        for acct in accounts:
            conn.execute(
                """INSERT INTO accounts(id, provider, env, label, monthly_limit, daily_limit, weight, disabled, updated_at)
                   VALUES(?,?,?,?,?,?,?,?,?)
                   ON CONFLICT(id) DO UPDATE SET
                     provider=excluded.provider, env=excluded.env, label=excluded.label,
                     monthly_limit=excluded.monthly_limit, daily_limit=excluded.daily_limit,
                     weight=excluded.weight, disabled=excluded.disabled, updated_at=excluded.updated_at""",
                (acct["id"], acct["provider"], acct.get("env") or "", acct.get("label") or "",
                 int(acct.get("monthly_limit") or 0), int(acct.get("daily_limit") or 0),
                 float(acct.get("weight") or 1.0), 1 if acct.get("disabled") else 0, now),
            )
        conn.commit()
    finally:
        if own:
            conn.close()


def usage_for(account_id: str, conn: sqlite3.Connection) -> dict[str, int]:
    month = datetime.now(timezone.utc).strftime("%Y-%m")
    day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    row_m = conn.execute("SELECT tokens_in,tokens_out,requests FROM usage WHERE account_id=? AND window=?",
                         (account_id, month)).fetchone()
    row_d = conn.execute("SELECT tokens_in,tokens_out,requests FROM usage WHERE account_id=? AND window=?",
                         (account_id, day)).fetchone()
    total = conn.execute("SELECT COALESCE(SUM(tokens_in+tokens_out),0) FROM usage WHERE account_id=?",
                         (account_id,)).fetchone()[0]
    return {
        "month_tokens": (row_m["tokens_in"] + row_m["tokens_out"]) if row_m else 0,
        "day_tokens": (row_d["tokens_in"] + row_d["tokens_out"]) if row_d else 0,
        "total_tokens": int(total or 0),
        "month_requests": row_m["requests"] if row_m else 0,
        "day_requests": row_d["requests"] if row_d else 0,
    }


def health_for(account_id: str, conn: sqlite3.Connection) -> dict[str, Any]:
    row = conn.execute("SELECT * FROM health WHERE account_id=?", (account_id,)).fetchone()
    if not row:
        return {"success": 0, "failure": 0, "latency_ms": 0.0, "cooldown_until": None,
                "last_used": None, "last_error": None}
    return dict(row)


def model_health_for(account_id: str, model_id: str, conn: sqlite3.Connection) -> dict[str, Any]:
    row = conn.execute(
        "SELECT * FROM model_health WHERE account_id=? AND model=?", (account_id, model_id)
    ).fetchone()
    if not row:
        return {"success": 0, "failure": 0, "cooldown_until": None, "last_error": None}
    return dict(row)


def is_cooling(health: dict[str, Any]) -> bool:
    until = health.get("cooldown_until")
    if not until:
        return False
    try:
        return datetime.fromisoformat(until) > datetime.now(timezone.utc)
    except ValueError:
        return False


def quota_state(account: dict[str, Any], model: dict[str, Any], conn: sqlite3.Connection,
                usage: dict[str, int] | None = None) -> dict[str, Any]:
    usage = usage or usage_for(account["id"], conn)
    free_type = str(model.get("free_type") or "unknown")
    monthly_limit = int(account.get("monthly_limit") or 0) or int(model.get("monthly_tokens") or 0)
    daily_limit = int(account.get("daily_limit") or 0)
    if not daily_limit and free_type == "recurring-daily" and monthly_limit:
        daily_limit = max(1, monthly_limit // 30)
    credit = int(model.get("credit_tokens") or 0)
    if free_type == "one-time-initial" and credit:
        monthly_limit = 0
        used = usage["total_tokens"]
        limit = credit
        remaining = max(0, limit - used)
        frac = remaining / limit if limit else 1.0
        return {"limit": limit, "used": used, "remaining": remaining, "fraction": frac,
                "kind": "credit", "day_limit": 0, "day_used": 0}
    if monthly_limit:
        remaining = max(0, monthly_limit - usage["month_tokens"])
        frac = remaining / monthly_limit
        if daily_limit:
            day_remaining = max(0, daily_limit - usage["day_tokens"])
            frac = min(frac, day_remaining / daily_limit if daily_limit else 1.0)
        return {"limit": monthly_limit, "used": usage["month_tokens"], "remaining": remaining,
                "fraction": frac, "kind": "monthly", "day_limit": daily_limit,
                "day_used": usage["day_tokens"]}
    return {"limit": 0, "used": usage["month_tokens"], "remaining": -1, "fraction": 1.0,
            "kind": "uncapped", "day_limit": daily_limit, "day_used": usage["day_tokens"]}


_LOCAL_UP_CACHE: dict[str, tuple[float, bool]] = {}


def is_local_provider(provider: str) -> bool:
    meta = provider_meta(provider)
    api = expand_api(str(meta.get("api") or ""))
    if meta.get("source") == "local":
        return True
    return any(host in api for host in ("127.0.0.1", "localhost", "[::1]", "0.0.0.0"))


def local_endpoint_up(provider: str, ttl: float = 15.0) -> bool:
    """Cheap TCP check so dead local servers are not advertised as available."""
    now = time.monotonic()
    cached = _LOCAL_UP_CACHE.get(provider)
    if cached and now - cached[0] < ttl:
        return cached[1]
    meta = provider_meta(provider)
    api = expand_api(str(meta.get("api") or ""))
    if not api:
        _LOCAL_UP_CACHE[provider] = (now, False)
        return False
    try:
        from urllib.parse import urlparse
        parsed = urlparse(api)
        host = parsed.hostname or "127.0.0.1"
        port = parsed.port or (443 if parsed.scheme == "https" else 80)
        with socket.create_connection((host, port), timeout=0.25):
            ok = True
    except OSError:
        ok = False
    _LOCAL_UP_CACHE[provider] = (now, ok)
    return ok


def available_accounts(model: dict[str, Any], config: dict[str, Any] | None = None,
                       conn: sqlite3.Connection | None = None,
                       accounts: list[dict[str, Any]] | None = None,
                       usage_cache: dict[str, dict[str, int]] | None = None) -> list[dict[str, Any]]:
    config = config or load_config()
    provider = str(model.get("provider") or "")
    if is_local_provider(provider) and not local_endpoint_up(provider):
        return []
    own = conn is None
    conn = conn or connect()
    try:
        result = []
        pool = accounts if accounts is not None else discover_accounts(config)
        for acct in pool:
            if acct["provider"] != model["provider"] or acct.get("disabled"):
                continue
            health = health_for(acct["id"], conn)
            if is_cooling(health):
                continue
            mhealth = model_health_for(acct["id"], str(model.get("model") or ""), conn)
            if is_cooling(mhealth):
                continue
            quota = quota_state(acct, model, conn, usage=(
                (usage_cache or {}).get(acct["id"])))
            if quota["fraction"] <= 0:
                continue
            result.append({**acct, "health": health, "model_health": mhealth, "quota": quota})
        result.sort(key=lambda a: (a["quota"]["fraction"], -float(a["health"].get("success") or 0)))
        return result
    finally:
        if own:
            conn.close()


def record_attempt(
    account: dict[str, Any],
    model: dict[str, Any],
    task: str,
    status: str,
    http_status: int,
    tokens_in: int,
    tokens_out: int,
    latency_ms: float,
    error: str = "",
) -> None:
    conn = connect()
    try:
        now = utc_now()
        month = datetime.now(timezone.utc).strftime("%Y-%m")
        day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        if status == "ok":
            for window in (month, day):
                conn.execute(
                    """INSERT INTO usage(account_id, window, tokens_in, tokens_out, requests)
                       VALUES(?,?,?,?,1)
                       ON CONFLICT(account_id, window) DO UPDATE SET
                         tokens_in=tokens_in+excluded.tokens_in,
                         tokens_out=tokens_out+excluded.tokens_out,
                         requests=requests+1""",
                    (account["id"], window, tokens_in, tokens_out),
                )
            health = health_for(account["id"], conn)
            success = int(health.get("success") or 0) + 1
            old_lat = float(health.get("latency_ms") or 0)
            latency = latency_ms if old_lat <= 0 else old_lat * 0.8 + latency_ms * 0.2
            conn.execute(
                """INSERT INTO health(account_id, success, failure, latency_ms, last_used, cooldown_until, last_error)
                   VALUES(?,?,?,?,?,NULL,NULL)
                   ON CONFLICT(account_id) DO UPDATE SET
                     success=excluded.success, latency_ms=excluded.latency_ms,
                     last_used=excluded.last_used, cooldown_until=NULL, last_error=NULL""",
                (account["id"], success, int(health.get("failure") or 0), latency, now),
            )
            conn.execute(
                """INSERT INTO model_health(account_id, model, success, failure, cooldown_until, last_error)
                   VALUES(?,?,1,0,NULL,NULL)
                   ON CONFLICT(account_id, model) DO UPDATE SET
                     success=success+1, cooldown_until=NULL, last_error=NULL""",
                (account["id"], str(model.get("model") or model.get("id") or "")),
            )
        else:
            health = health_for(account["id"], conn)
            failure = int(health.get("failure") or 0) + 1
            cooldown = cooldown_seconds(http_status, error)
            until = (datetime.now(timezone.utc) + timedelta(seconds=cooldown)).isoformat(timespec="seconds")
            if account_wide_error(http_status):
                conn.execute(
                    """INSERT INTO health(account_id, success, failure, latency_ms, last_used, cooldown_until, last_error)
                       VALUES(?,?,?,?,?,?,?)
                       ON CONFLICT(account_id) DO UPDATE SET
                         failure=excluded.failure, last_used=excluded.last_used,
                         cooldown_until=excluded.cooldown_until, last_error=excluded.last_error""",
                    (account["id"], int(health.get("success") or 0), failure,
                     float(health.get("latency_ms") or 0), now, until, redact(error)[:500]),
                )
            else:
                conn.execute(
                    """INSERT INTO health(account_id, success, failure, latency_ms, last_used, cooldown_until, last_error)
                       VALUES(?,?,?,?,?,NULL,?)
                       ON CONFLICT(account_id) DO UPDATE SET
                         failure=excluded.failure, last_used=excluded.last_used,
                         last_error=excluded.last_error""",
                    (account["id"], int(health.get("success") or 0), failure,
                     float(health.get("latency_ms") or 0), now, redact(error)[:500]),
                )
            model_cd = model_cooldown_seconds(http_status, error)
            model_until = (datetime.now(timezone.utc) + timedelta(seconds=model_cd)).isoformat(timespec="seconds")
            conn.execute(
                """INSERT INTO model_health(account_id, model, success, failure, cooldown_until, last_error)
                   VALUES(?,?,0,1,?,?)
                   ON CONFLICT(account_id, model) DO UPDATE SET
                     failure=failure+1, cooldown_until=excluded.cooldown_until,
                     last_error=excluded.last_error""",
                (account["id"], str(model.get("model") or model.get("id") or ""),
                 model_until, redact(error)[:500]),
            )
        conn.execute(
            """INSERT INTO requests(ts, task, provider, model, account_id, status, http_status,
                                    tokens_in, tokens_out, latency_ms, error)
               VALUES(?,?,?,?,?,?,?,?,?,?,?)""",
            (now, task, model.get("provider"), model.get("model"), account["id"], status,
             http_status, tokens_in, tokens_out, latency_ms, redact(error)[:1000]),
        )
        conn.commit()
    finally:
        conn.close()


def cooldown_seconds(http_status: int, error: str = "") -> int:
    match = re.search(r"retry[-_ ]after[:\s]+(\d+)", error, re.I)
    if match:
        return max(1, min(int(match.group(1)), 3600))
    if http_status == 429:
        return 120
    if http_status in (401, 403):
        return 3600
    if http_status == 402:
        return 86400
    if http_status >= 500:
        return 60
    return 30


def account_wide_error(http_status: int) -> bool:
    """True when the credential/account itself is unusable, not just one model."""
    return http_status in {401, 402, 403, 429}


def model_cooldown_seconds(http_status: int, error: str = "") -> int:
    """Cooldown for one provider/model pair; keeps the rest of the provider usable."""
    match = re.search(r"retry[-_ ]after[:\s]+(\d+)", error, re.I)
    if match:
        return max(1, min(int(match.group(1)), 3600))
    low = error.lower()
    if http_status in {400, 404, 410, 422}:
        model_gone = "model" in low and any(
            phrase in low
            for phrase in ("unavailable", "not found", "does not exist", "unsupported", "no such")
        )
        return 3600 if model_gone else 600
    if http_status == 429:
        return 120
    if http_status >= 500:
        return 120
    return 120


def routing_timeout(config: dict[str, Any] | None = None, total: bool = False) -> float:
    routing = (config or load_config()).get("routing", {})
    key = "total_timeout_seconds" if total else "candidate_timeout_seconds"
    default = 120.0 if total else 45.0
    try:
        value = float(routing.get(key) or default)
    except (TypeError, ValueError):
        value = default
    return max(5.0, value)


def opencode_service_env_state() -> str:
    """Check whether OpenCode's background service can see the router key."""
    proc_root = Path("/proc")
    if not proc_root.is_dir():
        return "unknown"
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            cmdline = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
        except OSError:
            continue
        if "opencode" not in cmdline or "serve --service" not in cmdline:
            continue
        try:
            env = (entry / "environ").read_bytes().split(b"\0")
        except OSError:
            return "unknown"
        has_key = any(item.startswith(b"HYPERROUTER_API_KEY=") for item in env)
        return "ok" if has_key else "missing"
    return "not-running"

