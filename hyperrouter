# Local API keys
# ---------------------------------------------------------------------------


def hash_api_key(raw: str) -> str:
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def _secret_tool(args: list[str], payload: bytes | None = None) -> subprocess.CompletedProcess[bytes] | None:
    binary = shutil.which("secret-tool")
    if not binary:
        return None
    try:
        return subprocess.run(
            [binary, *args],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None


def keyring_enabled() -> bool:
    return os.environ.get("HYPERROUTER_NO_KEYRING", "").lower() not in {"1", "true", "yes", "on"}


def keyring_store(raw: str) -> bool:
    if not keyring_enabled():
        return False
    result = _secret_tool(
        ["store", "--label=hyperrouter local key", "service", KEYRING_SERVICE,
         KEYRING_ATTR, KEYRING_VALUE],
        payload=raw.encode("utf-8"),
    )
    if result is None or result.returncode != 0:
        return False
    check = _secret_tool(["lookup", "service", KEYRING_SERVICE, KEYRING_ATTR, KEYRING_VALUE])
    return bool(check and check.returncode == 0 and check.stdout.decode("utf-8", "replace").strip() == raw)


def keyring_load() -> str:
    if not keyring_enabled():
        return ""
    for service in (KEYRING_SERVICE, "agent-router"):
        result = _secret_tool(["lookup", "service", service, KEYRING_ATTR, KEYRING_VALUE])
        if result and result.returncode == 0:
            value = result.stdout.decode("utf-8", "replace").strip()
            if value:
                return value
    return ""


def keyring_clear() -> None:
    if not keyring_enabled():
        return
    _secret_tool(["clear", "service", KEYRING_SERVICE, KEYRING_ATTR, KEYRING_VALUE])


def store_api_key(raw: str) -> str:
    """Store the raw local key. Prefer the OS keyring; fall back to a 0600 file."""
    if keyring_store(raw):
        KEY_PATH.unlink(missing_ok=True)
        return "keyring"
    write_text(KEY_PATH, raw + "\n")
    return "file"


def load_api_key() -> str:
    value = keyring_load()
    if value:
        return value
    if KEY_PATH.is_file():
        try:
            return KEY_PATH.read_text(encoding="utf-8").strip()
        except OSError:
            return ""
    return ""


def clear_api_key() -> None:
    keyring_clear()
    KEY_PATH.unlink(missing_ok=True)


def key_source() -> str:
    if keyring_load():
        return "keyring"
    if KEY_PATH.is_file():
        return "file"
    if os.environ.get("HYPERROUTER_API_KEY") or os.environ.get("AGENT_ROUTER_API_KEY"):
        return "env"
    return "none"


def active_key_rows(conn: sqlite3.Connection) -> list[sqlite3.Row]:
    return list(conn.execute(
        "SELECT * FROM api_keys WHERE revoked=0 ORDER BY created_at DESC"
    ).fetchall())


def auth_required() -> bool:
    conn = connect()
    try:
        return bool(active_key_rows(conn))
    finally:
        conn.close()


def generate_api_key(label: str = "default", revoke_existing: bool = False) -> str:
    ensure_dirs()
    raw = KEY_PREFIX + secrets.token_urlsafe(32)
    digest = hash_api_key(raw)
    conn = connect()
    try:
        if revoke_existing:
            conn.execute("UPDATE api_keys SET revoked=1 WHERE revoked=0")
        else:
            active = active_key_rows(conn)
            if active:
                raise ValueError("an active router key already exists; use `hyperrouter keys rotate`")
        conn.execute(
            "INSERT INTO api_keys(id, label, key_hash, prefix, created_at, revoked) VALUES(?,?,?,?,?,0)",
            (str(uuid.uuid4()), label, digest, raw[:12], utc_now()),
        )
        conn.commit()
    finally:
        conn.close()
    store_api_key(raw)
    return raw


def verify_api_key(raw: str) -> bool:
    if not raw:
        return False
    digest = hash_api_key(raw)
    conn = connect()
    try:
        rows = active_key_rows(conn)
        if not rows:
            return True
        for row in rows:
            if hmac.compare_digest(str(row["key_hash"]), digest):
                conn.execute("UPDATE api_keys SET last_used=? WHERE id=?", (utc_now(), row["id"]))
                conn.commit()
                return True
        return False
    finally:
        conn.close()


def revoke_all_keys() -> int:
    conn = connect()
    try:
        rows = active_key_rows(conn)
        conn.execute("UPDATE api_keys SET revoked=1 WHERE revoked=0")
        conn.commit()
        count = len(rows)
    finally:
        conn.close()
    clear_api_key()
    return count


def upsert_marked_block(text: str, begin: str, end: str, body: str) -> str:
    block = f"{begin}\n{body.strip()}\n{end}"
    if begin in text and end in text:
        start = text.index(begin)
        stop = text.index(end, start) + len(end)
        tail = text[stop:]
        if tail.startswith("\n"):
            tail = tail[1:]
        return text[:start] + block + "\n" + tail
    if not text.strip():
        return block + "\n"
    return text.rstrip() + "\n\n" + block + "\n"


LEGACY_BLOCKS = (
    ("<!-- BEGIN agent-router (managed) -->", "<!-- END agent-router (managed) -->"),
    ("# BEGIN agent-router (managed)", "# END agent-router (managed)"),
)


def strip_legacy_blocks(text: str) -> str:
    """Drop managed blocks written before the hyperRouter rename."""
    for begin, end in LEGACY_BLOCKS:
        while True:
            start = text.find(begin)
            if start < 0:
                break
            stop = text.find(end, start)
            if stop < 0:
                break
            stop += len(end)
            while stop < len(text) and text[stop] == "\n":
                stop += 1
            text = text[:start] + text[stop:]
    return text


def strip_patch_items(text: str, item_ids: set[str]) -> str:
    """Remove top-level patch entries by id (used to retire the pre-rename DSH id)."""
    out: list[str] = []
    skip = False
    base_indent = 0
    for line in text.splitlines(keepends=True):
        match = re.match(r"^(\s*)- id:\s*(\S+)", line)
        if match:
            indent = len(match.group(1))
            if skip and indent > base_indent:
                continue
            skip = match.group(2) in item_ids
            if skip:
                base_indent = indent
                continue
        if skip:
            stripped = line.lstrip()
            if not stripped or stripped.startswith("#") or line.startswith(" " * (base_indent + 1)):
                if stripped.startswith(("# BEGIN", "# END")):
                    skip = False
                    out.append(line)
                continue
            skip = False
        out.append(line)
    return "".join(out)


def env_block() -> str:
    return """\
# Loads the hyperrouter local key from the OS keyring (or a 0600 file).
if [ -z "${HYPERROUTER_API_KEY:-}" ]; then
  if command -v secret-tool >/dev/null 2>&1; then
    HYPERROUTER_API_KEY="$(secret-tool lookup service hyperrouter key default 2>/dev/null)"
  fi
  if [ -z "${HYPERROUTER_API_KEY:-}" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/hyperrouter/api-key" ]; then
    HYPERROUTER_API_KEY="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/hyperrouter/api-key" 2>/dev/null)"
  fi
  export HYPERROUTER_API_KEY
fi
"""


def install_env_block(dry_run: bool = False) -> list[str]:
    actions: list[str] = []
    existing = strip_legacy_blocks(read_text(BASHRC_PATH))
    updated = upsert_marked_block(existing, ENV_BEGIN, ENV_END, env_block())
    if updated == existing:
        actions.append(f"shell: {BASHRC_PATH} already loads HYPERROUTER_API_KEY")
        return actions
    if not dry_run:
        backup(BASHRC_PATH)
        write_text(BASHRC_PATH, updated)
    actions.append(f"shell: {'would update' if dry_run else 'updated'} {BASHRC_PATH} (HYPERROUTER_API_KEY)")
    return actions


def remove_env_block(dry_run: bool = False) -> list[str]:
    existing = read_text(BASHRC_PATH)
    if ENV_BEGIN not in existing or ENV_END not in existing:
        return []
    start = existing.index(ENV_BEGIN)
    stop = existing.index(ENV_END, start) + len(ENV_END)
    head = existing[:start].rstrip()
    tail = existing[stop:]
    if tail.startswith("\n"):
        tail = tail[1:]
    updated = (head + "\n" + tail).lstrip("\n") if head else tail.lstrip("\n")
    if not dry_run:
        backup(BASHRC_PATH)
        write_text(BASHRC_PATH, updated)
    return [f"shell: {'would remove' if dry_run else 'removed'} HYPERROUTER_API_KEY block from {BASHRC_PATH}"]


