def router_protocol() -> str:
    return PROTOCOL_FALLBACK.strip()


def upsert_block(text: str, body: str) -> str:
    block = f"{MANAGED_BEGIN}\n{body.strip()}\n{MANAGED_END}"
    if MANAGED_BEGIN in text and MANAGED_END in text:
        start = text.index(MANAGED_BEGIN)
        end = text.index(MANAGED_END, start) + len(MANAGED_END)
        tail = text[end:]
        if tail.startswith("\n"):
            tail = tail[1:]
        return text[:start] + block + "\n" + tail
    if not text.strip():
        return block + "\n"
    return text.rstrip() + "\n\n" + block + "\n"


def setup_opencode(dry_run: bool = False) -> list[str]:
    actions: list[str] = []
    config = load_jsonc(OPENCODE_CONFIG, {})
    if not isinstance(config, dict):
        raise ValueError(f"{OPENCODE_CONFIG}: top-level must be an object")
    changed = False
    config.setdefault("$schema", "https://opencode.ai/config.json")
    providers = config.get("providers")
    if not isinstance(providers, dict):
        providers = {}
        config["providers"] = providers
    models = {}
    for alias, desc in ALIAS_DESCRIPTIONS.items():
        models[alias] = {
            "name": desc,
            "limit": {"context": 1000000 if alias == "auto-long" else 128000, "output": 8192},
        }
    desired = {
        "name": f"{PRODUCT} (free pool)",
        "env": ["HYPERROUTER_API_KEY"],
        "package": "@opencode/ai/providers/openai-compatible",
        "settings": {
            "baseURL": "http://127.0.0.1:8787/v1",
        },
        "models": models,
    }
    providers.pop("agent-router", None)  # pre-rename provider id
    if providers.get("hyperrouter") != desired:
        providers["hyperrouter"] = desired
        changed = True
        actions.append("opencode: set providers.hyperrouter -> http://127.0.0.1:8787/v1")
    else:
        actions.append("opencode: provider already configured")
    if changed:
        save_json(OPENCODE_CONFIG, config, dry_run=dry_run)
        actions.append(f"opencode: {'would write' if dry_run else 'wrote'} {OPENCODE_CONFIG}")
    return actions


def setup_freebuff(dry_run: bool = False) -> list[str]:
    actions: list[str] = []
    path = FREEBUFF_BYOK
    data = load_json(path, [])
    if not isinstance(data, list):
        raise ValueError(f"{path}: expected a JSON array of BYOK connections")
    now = utc_now()
    existing = None
    for item in data:
        if not isinstance(item, dict):
            continue
        if item.get("name") in {"Agent Router", PRODUCT} or (
            item.get("provider") == "openai-compatible"
            and "127.0.0.1:8787" in str(item.get("baseUrl") or "")
        ):
