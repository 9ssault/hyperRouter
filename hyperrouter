def content_to_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict):
                if item.get("type") == "text":
                    parts.append(str(item.get("text") or ""))
                elif item.get("type") == "image_url":
                    parts.append("[image]")
        return "\n".join(parts)
    return str(content or "")


def messages_to_text(messages: Any) -> str:
    if not isinstance(messages, list):
        return ""
    parts = []
    for msg in messages:
        if not isinstance(msg, dict):
            continue
        role = str(msg.get("role") or "user")
        parts.append(f"{role}: {content_to_text(msg.get('content'))}")
    return "\n".join(parts)


def has_images(messages: Any) -> bool:
    if not isinstance(messages, list):
        return False
    for msg in messages:
        content = msg.get("content") if isinstance(msg, dict) else None
        if isinstance(content, list):
            for item in content:
                if isinstance(item, dict) and item.get("type") in {"image_url", "input_image"}:
                    return True
    return False


def extract_usage(data: Any) -> tuple[int, int]:
    if not isinstance(data, dict):
        return 0, 0
    usage = data.get("usage")
    if isinstance(usage, dict):
        return int(usage.get("prompt_tokens") or usage.get("input_tokens") or 0), int(
            usage.get("completion_tokens") or usage.get("output_tokens") or 0
        )
    return 0, 0


def response_text(data: Any) -> str:
    if not isinstance(data, dict):
        return ""
    choices = data.get("choices")
    if not isinstance(choices, list) or not choices:
        return ""
    first = choices[0]
    if not isinstance(first, dict):
        return ""
    message = first.get("message")
    if isinstance(message, dict):
        return content_to_text(message.get("content"))
    return content_to_text(first.get("text"))


def upstream_headers(provider: str, account: dict[str, Any]) -> dict[str, str]:
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": f"hyperrouter/{VERSION}",
    }
    key = str(account.get("key") or "")
    if key:
        headers["Authorization"] = f"Bearer {key}"
    if provider == "openrouter":
        headers["HTTP-Referer"] = "https://github.com/cheaper-inference/OmniRoute"
        headers["X-Title"] = "hyperrouter"
    return headers


def provider_payload(body: dict[str, Any], upstream_model: str) -> dict[str, Any]:
    payload = copy.deepcopy(body)
    payload["model"] = upstream_model
    for key in ("router", "provider", "account", "x_agent_router"):
        payload.pop(key, None)
    return payload


def discover_local_model(model: dict[str, Any], account: dict[str, Any]) -> str | None:
    url = models_url(model["provider"])
    if not url:
        return None
    headers = upstream_headers(model["provider"], account)
    status, _, data = http_json("GET", url, headers=headers, timeout=10)
    if status != 200 or not isinstance(data, dict):
        return None
    items = data.get("data")
    if not isinstance(items, list):
        return None
    for item in items:
        if not isinstance(item, dict):
            continue
        mid = str(item.get("id") or "")
        if not mid:
            continue
        low = mid.lower()
        if any(x in low for x in ("embed", "whisper", "tts", "rerank")):
            continue
        return mid
    return None


def call_candidate(
    candidate: dict[str, Any],
    body: dict[str, Any],
    requested_model: str,
    task: str,
    timeout: float = 45.0,
) -> tuple[bool, Any]:
    model = candidate["model"]
    account = candidate["account"]
    provider = model["provider"]
    upstream_model = str(model.get("model") or "")
    if upstream_model == "*":
        discovered = discover_local_model(model, account)
        if not discovered:
            return False, {"status": 0, "error": f"{provider}: no local model discovered"}
        upstream_model = discovered
    url = chat_url(provider)
    if not url:
        return False, {"status": 0, "error": f"{provider}: no endpoint"}
    headers = upstream_headers(provider, account)
    payload = provider_payload(body, upstream_model)
    started = time.monotonic()
    status, hdrs, data = http_json("POST", url, headers=headers, payload=payload, timeout=timeout)
    latency = (time.monotonic() - started) * 1000
    if status != 200 or not isinstance(data, dict):
        err = data if isinstance(data, str) else json.dumps(data, ensure_ascii=False)[:800]
        if not err:
            err = f"HTTP {status}"
        record_attempt(account, model, task, "error", status, 0, 0, latency, str(err))
        return False, {"status": status, "error": redact(str(err)), "provider": provider, "model": upstream_model}
    tokens_in, tokens_out = extract_usage(data)
    if not tokens_in:
        tokens_in = estimate_tokens(messages_to_text(body.get("messages")))
    if not tokens_out:
        tokens_out = estimate_tokens(response_text(data))
    record_attempt(account, model, task, "ok", status, tokens_in, tokens_out, latency)
    data["model"] = requested_model
    if not data.get("usage"):
        data["usage"] = {"prompt_tokens": tokens_in, "completion_tokens": tokens_out,
                         "total_tokens": tokens_in + tokens_out}
    data["x_agent_router"] = {
        "provider": provider, "model": upstream_model, "task": task,
        "account": account.get("label"), "latency_ms": round(latency, 1),
    }
    return True, data


def prepare_route(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str | None = None,
    strategy: str | None = None,
    max_tokens: int | None = None,
    temperature: float | None = None,
    tools: list[dict[str, Any]] | None = None,
) -> tuple[dict[str, Any], str, str, list[dict[str, Any]]]:
    """Classify the request, apply delegation settings, and rank candidates."""
    config = load_config()
    requested = model or "auto"
    body: dict[str, Any] = {"model": requested, "messages": messages}
    cap = max_tokens or int(config.get("routing", {}).get("max_tokens") or 0)
    if cap:
        body["max_tokens"] = int(cap)
    if temperature is not None:
        body["temperature"] = float(temperature)
    task_override = TASK_ALIASES.get(requested) if requested in TASK_ALIASES else None
    if task_hint:
        task_override = task_hint
    text = messages_to_text(messages)
    needs_tools = bool(tools)
    images = has_images(messages)
    context_tokens = estimate_tokens(text)
    task = task_override or classify_task(text, has_tools=needs_tools, has_images=images,
                                         context_tokens=context_tokens)[0]
    if requested == "auto-fast":
        strategy = "speed"
    elif requested == "auto-quality":
        strategy = "quality"
    elif requested == "auto-cheap":
        strategy = "cheap"
    if tools:
        body["tools"] = tools
    explicit = None if requested in TASK_ALIASES else requested
    # Delegation: a task can be pinned to a specific model in settings.
    pinned = ((config.get("routing", {}).get("task_models") or {}).get(task)
              if isinstance(config.get("routing", {}).get("task_models"), dict) else None)
    if pinned and not explicit:
        if catalog_model(str(pinned)):
            explicit = str(pinned)
    candidates = pick_models(
        task, limit=int(config.get("routing", {}).get("max_fallbacks") or 6),
        strategy=strategy, need_tools=needs_tools, need_vision=images,
        need_context=context_tokens, explicit_model=explicit,
    )
    if not candidates and pinned and not explicit:
        candidates = pick_models(task, limit=3, strategy=strategy, need_tools=needs_tools,
                                 need_vision=images, need_context=context_tokens)
    if not candidates:
        raise RuntimeError(
            "no free model is available. Set a provider key (for example GROQ_API_KEY, "
            "MISTRAL_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY), start a local "
            "Ollama/llama.cpp server, or run `hyperrouter accounts add`."
        )
    return body, requested, task, candidates


PROVIDER_COOLDOWN: dict[str, float] = {}
COOLDOWN_LOCK = threading.Lock()
REQUEST_GATE: dict[str, Any] = {"lock": threading.Lock(), "sem": None, "size": 0}


def provider_cooling(provider: str) -> float:
    """Seconds left before this provider should be tried again (0 = ready)."""
    with COOLDOWN_LOCK:
        until = PROVIDER_COOLDOWN.get(provider, 0.0)
    return max(0.0, until - time.monotonic())


def cool_provider(provider: str, seconds: float) -> None:
    if not provider or seconds <= 0:
        return
    with COOLDOWN_LOCK:
        PROVIDER_COOLDOWN[provider] = max(PROVIDER_COOLDOWN.get(provider, 0.0),
                                          time.monotonic() + seconds)


def note_provider_failure(provider: str, status: int, error: str) -> None:
    wait = retry_after_seconds(error)
    if not wait:
        wait = 90 if status in {402, 429} else 45 if status >= 500 else 0
    cool_provider(provider, wait)


def routing_failure(errors: list[dict[str, Any]], skipped: list[str]) -> RuntimeError:
    """Explain an exhausted route without pretending nothing was tried."""
    parts = [f"{e.get('provider')}/{e.get('model')} HTTP {e.get('status')}: {e.get('error')}"
             for e in errors]
    if skipped:
        waits = [provider_cooling(name) for name in skipped]
        parts.append(f"{len(skipped)} provider(s) cooling down for up to {max(waits):.0f}s")
    message = "all free candidates failed: " + ("; ".join(parts) or "no candidate was tried")
    if any(int(e.get("status") or 0) in {402, 429} for e in errors):
        message += (". Free tiers are rate limited right now - retry in a moment or add a "
                    "provider key with `hyperrouter connect <provider>`")
    return RuntimeError(message)


def request_gate() -> threading.Semaphore:
    """Limit concurrent upstream calls so parallel workers do not stampede."""
    config = load_config()
    size = max(1, min(int((config.get("routing") or {}).get("max_concurrency") or 3), 16))
    with REQUEST_GATE["lock"]:
        if REQUEST_GATE["sem"] is None or REQUEST_GATE["size"] != size:
            REQUEST_GATE["sem"] = threading.BoundedSemaphore(size)
            REQUEST_GATE["size"] = size
        return REQUEST_GATE["sem"]


def route_once(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str | None = None,
    strategy: str | None = None,
    max_tokens: int | None = None,
    timeout: float | None = None,
    temperature: float | None = None,
    tools: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    body, requested, task, candidates = prepare_route(
        messages, model=model, task_hint=task_hint, strategy=strategy,
        max_tokens=max_tokens, temperature=temperature, tools=tools)
    errors = []
    skipped: list[str] = []
    failed_accounts: set[str] = set()
    per_timeout = float(timeout) if timeout else routing_timeout()
    deadline = time.monotonic() + routing_timeout(total=True)
    for candidate in candidates:
        account = candidate.get("account") or {}
        if account.get("id") in failed_accounts:
            continue
        provider_name = str(candidate["model"].get("provider") or "")
        if provider_cooling(provider_name) > 0:
            skipped.append(provider_name)
            continue
        remaining = deadline - time.monotonic()
        if remaining <= 1:
            errors.append({"provider": candidate["model"].get("provider"),
                           "model": candidate["model"].get("model"),
                           "status": 0, "error": "routing deadline exceeded"})
            break
        ok, result = call_candidate(candidate, body, requested, task,
                                    timeout=min(per_timeout, remaining))
        if ok:
            return result
        errors.append(result)
        note_provider_failure(provider_name, int(result.get("status") or 0),
                              str(result.get("error") or ""))
        if account_wide_error(int(result.get("status") or 0)):
            failed_accounts.add(str(account.get("id")))
    raise routing_failure(errors, skipped)


def stream_route(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str | None = None,
    strategy: str | None = None,
    max_tokens: int | None = None,
    temperature: float | None = None,
    meta: dict[str, Any] | None = None,
    timeout: float | None = None,
) -> Iterator[str]:
    """Stream tokens from the best free model, failing over before the first token.

    Metadata about the winning model is written into `meta` when the stream
    starts (provider/model) and again when it ends (latency, tokens).
    """
    body, requested, task, candidates = prepare_route(
        messages, model=model, task_hint=task_hint, strategy=strategy,
        max_tokens=max_tokens, temperature=temperature)
    meta = meta if meta is not None else {}
    errors: list[dict[str, Any]] = []
    skipped: list[str] = []
    failed_accounts: set[str] = set()
    per_timeout = float(timeout) if timeout else routing_timeout()
    deadline = time.monotonic() + routing_timeout(total=True)
    for candidate in candidates:
        account = candidate.get("account") or {}
        if account.get("id") in failed_accounts:
            continue
        cooling = provider_cooling(str(candidate["model"].get("provider") or ""))
        if cooling > 0:
            skipped.append(str(candidate["model"].get("provider") or ""))
            continue
        remaining = deadline - time.monotonic()
        if remaining <= 1:
            errors.append({"provider": candidate["model"].get("provider"),
                           "model": candidate["model"].get("model"),
                           "status": 0, "error": "routing deadline exceeded"})
            break
        model_meta = candidate["model"]
        provider = model_meta["provider"]
        upstream_model = str(model_meta.get("model") or "")
        if upstream_model == "*":
            discovered = discover_local_model(model_meta, account)
            if not discovered:
                errors.append({"provider": provider, "model": "*", "status": 0,
                               "error": "no local model discovered"})
                continue
            upstream_model = discovered
        url = chat_url(provider)
        if not url:
            errors.append({"provider": provider, "model": upstream_model, "status": 0,
                           "error": "no endpoint"})
            continue
        headers = upstream_headers(provider, account)
        headers["Accept"] = "text/event-stream"
        payload = provider_payload(body, upstream_model)
        payload["stream"] = True
        req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"),
                                     headers=headers, method="POST")
        started = time.monotonic()
        timeout = min(per_timeout, remaining)
        try:
            resp = urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError as exc:
            raw = exc.read().decode("utf-8", "replace")
            record_attempt(account, model_meta, task, "error", exc.code, 0, 0,
                           (time.monotonic() - started) * 1000, raw)
            errors.append({"provider": provider, "model": upstream_model,
                           "status": exc.code, "error": redact(raw)[:300]})
            note_provider_failure(provider, exc.code, raw)
            if account_wide_error(exc.code):
                failed_accounts.add(str(account.get("id")))
            continue
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            message = str(getattr(exc, "reason", exc))
            record_attempt(account, model_meta, task, "error", 0, 0, 0,
                           (time.monotonic() - started) * 1000, message)
            errors.append({"provider": provider, "model": upstream_model,
                           "status": 0, "error": redact(message)[:300]})
            note_provider_failure(provider, 0, message)
            continue
        produced = 0
        usage_in = 0
        usage_out = 0
        collected: list[str] = []
        try:
            first = resp.readline()
            if not first:
                record_attempt(account, model_meta, task, "error", 0, 0, 0,
                               (time.monotonic() - started) * 1000, "empty stream")
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": "empty stream"})
                resp.close()
                continue
            if first.lstrip().startswith(b"{"):
                raw = (first + resp.read()).decode("utf-8", "replace")
                record_attempt(account, model_meta, task, "error", 0, 0, 0,
                               (time.monotonic() - started) * 1000, raw)
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": redact(raw)[:300]})
                resp.close()
                continue
            meta.update({"provider": provider, "model": upstream_model, "task": task,
                         "account": account.get("label")})
            for raw_line in itertools.chain((first,), resp):
                line = raw_line.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                chunk = line[5:].strip()
                if not chunk or chunk == "[DONE]":
                    continue
                try:
                    obj = json.loads(chunk)
                except json.JSONDecodeError:
                    continue
                tin, tout = extract_usage(obj)
                usage_in = tin or usage_in
                usage_out = tout or usage_out
                choices = obj.get("choices") if isinstance(obj, dict) else None
                if isinstance(choices, list) and choices and isinstance(choices[0], dict):
                    delta = choices[0].get("delta") or {}
                    piece = content_to_text(delta.get("content"))
                    if piece:
                        produced += len(piece)
                        collected.append(piece)
                        yield piece
            resp.close()
            latency = (time.monotonic() - started) * 1000
            if not produced:
                record_attempt(account, model_meta, task, "error", 0, 0, 0, latency,
                               "stream produced no text")
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": "stream produced no text"})
                continue
            if not usage_in:
                usage_in = estimate_tokens(messages_to_text(body.get("messages")))
            if not usage_out:
                usage_out = estimate_tokens("".join(collected))
            record_attempt(account, model_meta, task, "ok", 200, usage_in, usage_out, latency)
            meta.update({"latency_ms": round(latency, 1), "tokens_in": usage_in,
                         "tokens_out": usage_out})
            return
        except GeneratorExit:
            resp.close()
            raise
        except Exception as exc:  # noqa: BLE001 - mid-stream failures cannot fail over
            resp.close()
            record_attempt(account, model_meta, task, "error", 0, 0, 0,
                           (time.monotonic() - started) * 1000, str(exc))
            meta["error"] = redact(str(exc))
            return
    raise routing_failure(errors, skipped)


def _anthropic_blocks_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [str(block.get("text") or "") for block in content
                 if isinstance(block, dict) and block.get("type") == "text"]
        return "\n".join(parts)
    return ""


def _anthropic_tool_result_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                parts.append(str(block.get("text") or ""))
            elif isinstance(block, dict) and block.get("type") == "image":
                parts.append("[image]")
        return "\n".join(parts)
    return str(content or "")


def anthropic_to_openai(body: dict[str, Any]) -> tuple[list[dict[str, Any]],
                                                       list[dict[str, Any]]]:
    """Convert an Anthropic Messages request into OpenAI chat messages + tools."""
    messages: list[dict[str, Any]] = []
    system = body.get("system")
    system_text = _anthropic_blocks_text(system)
    if system_text.strip():
        messages.append({"role": "system", "content": system_text})
    for raw in body.get("messages") or []:
        if not isinstance(raw, dict):
            continue
        role = str(raw.get("role") or "user")
        content = raw.get("content")
        if isinstance(content, str):
            messages.append({"role": role, "content": content})
            continue
        if not isinstance(content, list):
            continue
        texts: list[str] = []
        tool_calls: list[dict[str, Any]] = []
        tool_results: list[tuple[str, str]] = []
        images: list[dict[str, Any]] = []
        for block in content:
            if not isinstance(block, dict):
                continue
            kind = block.get("type")
            if kind == "text":
                texts.append(str(block.get("text") or ""))
            elif kind == "image":
                source = block.get("source") or {}
                if isinstance(source, dict):
                    if source.get("type") == "base64":
                        media = str(source.get("media_type") or "image/png")
                        data = str(source.get("data") or "")
                        images.append({"type": "image_url",
                                       "image_url": {"url": f"data:{media};base64,{data}"}})
                    elif source.get("type") == "url" and source.get("url"):
                        images.append({"type": "image_url",
                                       "image_url": {"url": str(source["url"])}})
            elif kind == "tool_use":
                tool_calls.append({
                    "id": str(block.get("id") or f"call_{len(tool_calls)}"),
                    "type": "function",
                    "function": {"name": str(block.get("name") or ""),
                                 "arguments": json.dumps(block.get("input") or {})},
                })
            elif kind == "tool_result":
                tool_results.append((str(block.get("tool_use_id") or ""),
                                     _anthropic_tool_result_text(block.get("content"))))
        text = "\n".join(part for part in texts if part)
        if role == "assistant":
            message: dict[str, Any] = {"role": "assistant", "content": text}
            if tool_calls:
                message["tool_calls"] = tool_calls
            messages.append(message)
            continue
        if text or images:
            if images:
                parts = ([{"type": "text", "text": text}] if text else []) + images
                messages.append({"role": role, "content": parts})
            else:
                messages.append({"role": role, "content": text})
        for tool_id, output in tool_results:
            messages.append({"role": "tool", "tool_call_id": tool_id,
                             "content": output or "(empty)"})
    tools: list[dict[str, Any]] = []
    for tool in body.get("tools") or []:
        if not isinstance(tool, dict):
            continue
        schema = tool.get("input_schema")
        if not isinstance(schema, dict):
            schema = {"type": "object", "properties": {}}
        tools.append({"type": "function", "function": {
            "name": str(tool.get("name") or ""),
            "description": str(tool.get("description") or "")[:1000],
            "parameters": schema,
        }})
    return messages, tools


def openai_response_to_anthropic(result: dict[str, Any], model: str) -> dict[str, Any]:
    """Convert an OpenAI chat completion into an Anthropic Messages response."""
    message = response_message(result)
    content: list[dict[str, Any]] = []
    text = content_to_text(message.get("content"))
    if text:
        content.append({"type": "text", "text": text})
    calls = message.get("tool_calls") or []
    for index, call in enumerate(calls):
        if not isinstance(call, dict):
            continue
        function = call.get("function") or {}
        raw = function.get("arguments")
        try:
            parsed = json.loads(raw) if isinstance(raw, str) and raw.strip() else (raw or {})
        except json.JSONDecodeError:
            parsed = {"input": raw}
        content.append({"type": "tool_use", "id": str(call.get("id") or f"toolu_{index}"),
                        "name": str(function.get("name") or ""),
                        "input": parsed if isinstance(parsed, dict) else {}})
    usage = result.get("usage") or {}
    return {
        "id": f"msg_{uuid.uuid4().hex[:24]}",
        "type": "message",
        "role": "assistant",
        "model": model,
        "content": content,
        "stop_reason": "tool_use" if calls else "end_turn",
        "stop_sequence": None,
        "usage": {"input_tokens": int(usage.get("prompt_tokens") or 0),
                  "output_tokens": int(usage.get("completion_tokens") or 0)},
    }


class RouterHandler:
    """Mixin-style handler methods; the real class is created below."""

    server_version = f"hyperrouter/{VERSION}"

    def log_message(self, fmt: str, *args: Any) -> None:
        try:
            line = f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} {fmt % args}\n"
            with LOG_PATH.open("a", encoding="utf-8") as fh:
                fh.write(line)
        except OSError:
            pass

    def send_json(self, status: int, payload: Any) -> None:
        raw = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def read_body(self) -> dict[str, Any]:
        raw = getattr(self, "_raw_body", None)
        if raw is None:
            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length) if length else b"{}"
        data = json.loads((raw or b"{}").decode("utf-8", "replace"))
        if not isinstance(data, dict):
            raise ValueError("body must be a JSON object")
        return data

    def authorized(self) -> bool:
        if not auth_required():
            return True
        header = str(self.headers.get("Authorization") or "").strip()
        raw = header[7:].strip() if header.lower().startswith("bearer ") else ""
        if not raw:
            raw = str(self.headers.get("x-api-key") or "").strip()
        return verify_api_key(raw)

    def require_auth(self) -> bool:
        if self.authorized():
            return True
        self.send_json(401, {"error": {
            "message": "invalid or missing hyperrouter API key. Run `hyperrouter keys show` "
                       "and set HYPERROUTER_API_KEY, or `hyperrouter keys rotate`.",
            "type": "authentication_error",
        }})
        return False

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path in {"/", "/health", "/healthz"}:
            catalog = load_catalog()
            accounts = discover_accounts()
            providers = sorted({a["provider"] for a in accounts})
            self.send_json(200, {
                "ok": True, "version": VERSION, "service": "hyperrouter",
                "base_url": f"http://{self.headers.get('Host', '127.0.0.1')}/v1",
                "auth": "required" if auth_required() else "open",
                "catalog": {"models": len(catalog.get("models") or []),
                             "providers": len(catalog.get("providers") or {}),
                             "generated_at": catalog.get("generated_at")},
                "accounts": {"total": len(accounts), "providers": providers},
            })
            return
        if path == "/ready":
            candidates = pick_models("chat", limit=1)
            self.send_json(200 if candidates else 503, {
                "ready": bool(candidates), "version": VERSION,
                "catalog": len(load_catalog().get("models") or []),
                "cooldowns": {name: round(provider_cooling(name), 1)
                              for name in list(PROVIDER_COOLDOWN) if provider_cooling(name) > 0},
            })
            return
        if path == "/admin/stats":
            if not self.require_auth():
                return
            conn = connect()
            try:
                totals = conn.execute(
                    "SELECT COUNT(*) AS n, SUM(status = 'ok') AS ok,"
                    " COALESCE(SUM(tokens_in), 0) AS tin, COALESCE(SUM(tokens_out), 0) AS tout,"
                    " COALESCE(AVG(latency_ms), 0) AS lat FROM requests"
                ).fetchone()
                by_provider = [dict(row) for row in conn.execute(
                    "SELECT provider, COUNT(*) AS n, COALESCE(SUM(tokens_out), 0) AS tout"
                    " FROM requests GROUP BY provider ORDER BY n DESC LIMIT 12")]
            finally:
                conn.close()
            accounts = discover_accounts()
            self.send_json(200, {
                "version": VERSION,
                "requests": {"total": int(totals["n"] or 0), "ok": int(totals["ok"] or 0),
                             "tokens_in": int(totals["tin"] or 0),
                             "tokens_out": int(totals["tout"] or 0),
                             "avg_latency_ms": round(float(totals["lat"] or 0), 1)},
                "providers": by_provider,
                "accounts": {"total": len(accounts),
                             "by_provider": sorted({a["provider"] for a in accounts})},
                "cooldowns": {name: round(provider_cooling(name), 1)
                              for name in list(PROVIDER_COOLDOWN) if provider_cooling(name) > 0},
                "catalog": {"models": len(load_catalog().get("models") or []),
                             "generated_at": load_catalog().get("generated_at")},
                "mcp_servers": len(mcp_servers()),
            })
            return
        if path == "/v1/models":
            if not self.require_auth():
                return
            catalog = load_catalog()
            data = []
            for alias, desc in ALIAS_DESCRIPTIONS.items():
                data.append({"id": alias, "object": "model", "created": 0,
                             "owned_by": "hyperrouter", "description": desc})
            seen = set()
            for model in catalog.get("models") or []:
                if not model.get("routable") or model.get("free_type") == "discontinued":
                    continue
                mid = model.get("id")
                if mid in seen:
                    continue
                seen.add(mid)
                data.append({
                    "id": mid, "object": "model", "created": 0, "owned_by": model.get("provider"),
                    "context_window": model.get("context"), "free_type": model.get("free_type"),
                    "tos": model.get("tos"), "name": model.get("name"),
                })
                if len(data) >= 80:
                    break
            self.send_json(200, {"object": "list", "data": data})
            return
        self.send_json(404, {"error": {"message": "not found", "type": "not_found"}})

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        # Drain the body even for 404/401 so a kept-alive socket stays in sync.
        self._raw_body = self.rfile.read(length) if length else b""
        if path not in {"/v1/chat/completions", "/v1/completions", "/v1/messages",
                        "/v1/messages/count_tokens"}:
            self.send_json(404, {"error": {"message": "not found", "type": "not_found"}})
            return
        if not self.require_auth():
            return
        try:
            body = self.read_body()
        except (ValueError, json.JSONDecodeError) as exc:
            self.send_json(400, {"error": {"message": f"invalid JSON: {exc}", "type": "invalid_request_error"}})
            return
        if path == "/v1/messages/count_tokens":
            try:
                messages, tools = anthropic_to_openai(body)
            except (ValueError, TypeError) as exc:
                self.send_json(400, {"error": {"message": str(exc), "type": "invalid_request_error"}})
                return
            tokens = estimate_tokens(messages_to_text(messages))
            if tools:
                tokens += estimate_tokens(json.dumps(tools))
            self.send_json(200, {"input_tokens": max(1, tokens)})
            return
        if path == "/v1/messages":
            try:
                self.handle_anthropic(body)
            except BrokenPipeError:
                return
            except Exception as exc:  # noqa: BLE001 - keep the proxy alive
                self.send_json(500, {"type": "error", "error": {
                    "type": "api_error", "message": redact(str(exc))}})
            return
        if path == "/v1/completions":
            prompt = body.get("prompt")
            if isinstance(prompt, list):
                prompt = "\n".join(str(x) for x in prompt)
            body = {**body, "messages": [{"role": "user", "content": str(prompt or "")}]}
        try:
            self.handle_chat(body)
        except BrokenPipeError:
            return
        except Exception as exc:  # noqa: BLE001 - the proxy must not crash the server
            self.send_json(500, {"error": {"message": redact(str(exc)), "type": "router_error"}})

    def anthropic_model(self, requested: str) -> str:
        """Claude clients send Claude model ids; map anything unknown to the free pool."""
        if requested in ALIAS_DESCRIPTIONS:
            return requested
        catalog = load_catalog()
        ids = {str(model.get("id")) for model in catalog.get("models") or []}
        return requested if requested in ids else "auto"

    def sse(self, event: str, payload: dict[str, Any]) -> None:
        raw = f"event: {event}\ndata: {json.dumps(payload, ensure_ascii=False)}\n\n"
        self.wfile.write(raw.encode("utf-8"))
        self.wfile.flush()

    def stream_anthropic_text(self, messages: list[dict[str, Any]], model: str,
                              max_tokens: int | None, temperature: Any) -> None:
        """True token streaming for text-only Claude requests."""
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        message_id = f"msg_{uuid.uuid4().hex[:24]}"
        input_tokens = max(1, estimate_tokens(messages_to_text(messages)))
        self.sse("message_start", {"type": "message_start", "message": {
            "id": message_id, "type": "message", "role": "assistant", "model": model,
            "content": [], "stop_reason": None, "stop_sequence": None,
            "usage": {"input_tokens": input_tokens, "output_tokens": 0}}})
        self.sse("content_block_start", {"type": "content_block_start", "index": 0,
                                         "content_block": {"type": "text", "text": ""}})
        meta: dict[str, Any] = {}
        started = time.time()
        first = True
        try:
            for piece in stream_route(messages, model=model, max_tokens=max_tokens,
                                      temperature=(float(temperature)
                                                   if temperature is not None else None),
                                      meta=meta):
                if not piece:
                    continue
                if first:
                    meta.setdefault("first_token_ms", round((time.time() - started) * 1000, 1))
                    first = False
                self.sse("content_block_delta", {"type": "content_block_delta", "index": 0,
                                                 "delta": {"type": "text_delta", "text": piece}})
        except RuntimeError as exc:
            self.sse("error", {"type": "error", "error": {
                "type": "overloaded_error", "message": redact(str(exc))}})
            return
        except BrokenPipeError:
            return
        self.sse("content_block_stop", {"type": "content_block_stop", "index": 0})
        output_tokens = int(meta.get("tokens_out") or 0)
        self.sse("message_delta", {"type": "message_delta",
                                    "delta": {"stop_reason": "end_turn", "stop_sequence": None},
                                    "usage": {"output_tokens": output_tokens}})
        self.sse("message_stop", {"type": "message_stop"})

    def handle_anthropic(self, body: dict[str, Any]) -> None:
        messages, tools = anthropic_to_openai(body)
        if not messages:
            self.send_json(400, {"type": "error", "error": {
                "type": "invalid_request_error", "message": "messages must not be empty"}})
            return
        requested = self.anthropic_model(str(body.get("model") or "auto"))
        max_tokens = int(body.get("max_tokens") or 0) or None
        temperature = body.get("temperature")
        if body.get("stream") and not tools:
            self.stream_anthropic_text(messages, requested, max_tokens, temperature)
            return
        try:
            result = route_once(messages, model=requested, max_tokens=max_tokens,
                                temperature=float(temperature) if temperature is not None else None,
                                tools=tools or None)
        except RuntimeError as exc:
            self.send_json(503, {"type": "error", "error": {
                "type": "overloaded_error", "message": redact(str(exc))}})
            return
        payload = openai_response_to_anthropic(result, requested)
        if not payload["content"]:
            payload["content"] = [{"type": "text", "text": "(the free model returned nothing)"}]
        if not body.get("stream"):
            self.send_json(200, payload)
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.sse("message_start", {"type": "message_start", "message": {
            "id": payload["id"], "type": "message", "role": "assistant",
            "model": payload["model"], "content": [], "stop_reason": None,
            "stop_sequence": None,
            "usage": {"input_tokens": payload["usage"]["input_tokens"],
                      "output_tokens": 0}}})
        for index, block in enumerate(payload["content"]):
            if block.get("type") == "text":
                self.sse("content_block_start", {"type": "content_block_start", "index": index,
                                                 "content_block": {"type": "text", "text": ""}})
                text = str(block.get("text") or "")
                for start in range(0, len(text), 200):
                    self.sse("content_block_delta", {
                        "type": "content_block_delta", "index": index,
                        "delta": {"type": "text_delta", "text": text[start:start + 200]}})
                self.sse("content_block_stop", {"type": "content_block_stop", "index": index})
            elif block.get("type") == "tool_use":
                self.sse("content_block_start", {"type": "content_block_start", "index": index,
                                                 "content_block": {"type": "tool_use",
                                                                   "id": block.get("id"),
                                                                   "name": block.get("name"),
                                                                   "input": {}}})
                self.sse("content_block_delta", {
                    "type": "content_block_delta", "index": index,
                    "delta": {"type": "input_json_delta",
                              "partial_json": json.dumps(block.get("input") or {})}})
                self.sse("content_block_stop", {"type": "content_block_stop", "index": index})
        self.sse("message_delta", {"type": "message_delta",
                                    "delta": {"stop_reason": payload["stop_reason"],
                                              "stop_sequence": None},
                                    "usage": {"output_tokens": payload["usage"]["output_tokens"]}})
        self.sse("message_stop", {"type": "message_stop"})

    def handle_chat(self, body: dict[str, Any]) -> None:
        requested = str(body.get("model") or "auto")
        messages = body.get("messages") or []
        if not isinstance(messages, list) or not messages:
            self.send_json(400, {"error": {"message": "messages must be a non-empty array",
                                            "type": "invalid_request_error"}})
            return
        task_override = TASK_ALIASES.get(requested) if requested in TASK_ALIASES else None
        text = messages_to_text(messages)
        tools = bool(body.get("tools"))
        images = has_images(messages)
        context_tokens = estimate_tokens(text)
        task = task_override or classify_task(text, has_tools=tools, has_images=images,
                                             context_tokens=context_tokens)[0]
        strategy = None
        if requested == "auto-fast":
            strategy = "speed"
        elif requested == "auto-quality":
            strategy = "quality"
        elif requested == "auto-cheap":
            strategy = "cheap"
        explicit = None if requested in TASK_ALIASES else requested
        candidates = pick_models(
            task, limit=int(load_config().get("routing", {}).get("max_fallbacks") or 6),
            strategy=strategy, need_tools=tools, need_vision=images,
            need_context=context_tokens, explicit_model=explicit,
        )
        if not candidates:
            self.send_json(503, {"error": {
                "message": "no free model is available. Configure a provider key or start a local "
                           "Ollama/llama.cpp server. Run `hyperrouter doctor` for details.",
                "type": "router_unavailable",
            }})
            return
        stream = bool(body.get("stream"))
        if stream:
            self.handle_stream(body, candidates, requested, task)
            return
        errors = []
        failed_accounts: set[str] = set()
        per_timeout = routing_timeout()
        deadline = time.monotonic() + routing_timeout(total=True)
        for candidate in candidates:
            account = candidate.get("account") or {}
            if account.get("id") in failed_accounts:
                continue
            remaining = deadline - time.monotonic()
            if remaining <= 1:
                errors.append({"provider": candidate["model"].get("provider"),
                               "model": candidate["model"].get("model"),
                               "status": 0, "error": "routing deadline exceeded"})
                break
            ok, result = call_candidate(candidate, body, requested, task,
                                        timeout=min(per_timeout, remaining))
            if ok:
                self.send_json(200, result)
                return
            errors.append(result)
            if account_wide_error(int(result.get("status") or 0)):
                failed_accounts.add(str(account.get("id")))
        self.send_json(502, {"error": {
            "message": "all free candidates failed",
            "type": "router_error",
            "details": errors,
        }})

    def handle_stream(self, body: dict[str, Any], candidates: list[dict[str, Any]],
                      requested: str, task: str) -> None:
        errors = []
        failed_accounts: set[str] = set()
        per_timeout = routing_timeout()
        deadline = time.monotonic() + routing_timeout(total=True)
        for candidate in candidates:
            account = candidate.get("account") or {}
            if account.get("id") in failed_accounts:
                continue
            remaining = deadline - time.monotonic()
            if remaining <= 1:
                errors.append({"provider": candidate["model"].get("provider"),
                               "model": candidate["model"].get("model"),
                               "status": 0, "error": "routing deadline exceeded"})
                break
            model = candidate["model"]
            account = candidate["account"]
            provider = model["provider"]
            upstream_model = str(model.get("model") or "")
            if upstream_model == "*":
                discovered = discover_local_model(model, account)
                if not discovered:
                    errors.append({"provider": provider, "model": "*", "status": 0,
                                   "error": "no local model discovered"})
                    continue
                upstream_model = discovered
            url = chat_url(provider)
            if not url:
                errors.append({"provider": provider, "model": upstream_model, "status": 0,
                               "error": "no endpoint"})
                continue
            headers = upstream_headers(provider, account)
            headers["Accept"] = "text/event-stream"
            payload = provider_payload(body, upstream_model)
            payload["stream"] = True
            req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"),
                                         headers=headers, method="POST")
            started = time.monotonic()
            try:
                resp = urllib.request.urlopen(req, timeout=min(per_timeout, remaining))
            except urllib.error.HTTPError as exc:
                raw = exc.read().decode("utf-8", "replace")
                latency = (time.monotonic() - started) * 1000
                record_attempt(account, model, task, "error", exc.code, 0, 0, latency, raw)
                errors.append({"provider": provider, "model": upstream_model,
                               "status": exc.code, "error": redact(raw)[:500]})
                if account_wide_error(exc.code):
                    failed_accounts.add(str(account.get("id")))
                continue
            except (urllib.error.URLError, TimeoutError) as exc:
                latency = (time.monotonic() - started) * 1000
                record_attempt(account, model, task, "error", 0, 0, 0, latency, str(exc))
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": redact(str(exc))})
                continue
            try:
                first = resp.readline()
                if not first:
                    record_attempt(account, model, task, "error", 0, 0, 0,
                                   (time.monotonic() - started) * 1000, "empty stream")
                    errors.append({"provider": provider, "model": upstream_model,
                                   "status": 0, "error": "empty stream"})
                    resp.close()
                    continue
                if first.lstrip().startswith(b"{"):
                    raw = first + resp.read()
                    record_attempt(account, model, task, "error", 0, 0, 0,
                                   (time.monotonic() - started) * 1000, raw.decode("utf-8", "replace"))
                    errors.append({"provider": provider, "model": upstream_model,
                                   "status": 0, "error": redact(raw.decode("utf-8", "replace"))[:500]})
                    resp.close()
                    continue
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream; charset=utf-8")
                self.send_header("Cache-Control", "no-cache")
                self.send_header("Connection", "close")
                self.send_header("X-Accel-Buffering", "no")
                self.end_headers()
                self.wfile.write(first)
                self.wfile.flush()
                usage_in = 0
                usage_out = 0
                collected: list[str] = []
                for raw_line in resp:
                    self.wfile.write(raw_line)
                    self.wfile.flush()
                    line = raw_line.decode("utf-8", "replace").strip()
                    if line.startswith("data:"):
                        chunk = line[5:].strip()
                        if chunk and chunk != "[DONE]":
                            try:
                                obj = json.loads(chunk)
                            except json.JSONDecodeError:
                                continue
                            tin, tout = extract_usage(obj)
                            usage_in = tin or usage_in
                            usage_out = tout or usage_out
                            choices = obj.get("choices") if isinstance(obj, dict) else None
                            if isinstance(choices, list) and choices:
                                delta = choices[0].get("delta") if isinstance(choices[0], dict) else None
                                if isinstance(delta, dict):
                                    collected.append(content_to_text(delta.get("content")))
                resp.close()
                if not usage_in:
                    usage_in = estimate_tokens(messages_to_text(body.get("messages")))
                if not usage_out:
                    usage_out = estimate_tokens("".join(collected))
                record_attempt(account, model, task, "ok", 200, usage_in, usage_out,
                               (time.monotonic() - started) * 1000)
                return
            except BrokenPipeError:
                try:
                    resp.close()
                except Exception:
                    pass
                record_attempt(account, model, task, "ok", 200, 0, 0,
                               (time.monotonic() - started) * 1000)
                return
            except Exception as exc:  # noqa: BLE001
                try:
                    resp.close()
                except Exception:
                    pass
                record_attempt(account, model, task, "error", 0, 0, 0,
                               (time.monotonic() - started) * 1000, str(exc))
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": redact(str(exc))})
                # Headers may already be sent; cannot fail over cleanly.
                try:
                    self.wfile.write(b"data: {\"error\":{\"message\":\"upstream stream failed\"}}\n\n")
                    self.wfile.flush()
                except Exception:
                    pass
                return
        self.send_json(502, {"error": {"message": "all free candidates failed",
                                        "type": "router_error", "details": errors}})


def make_handler() -> type:
    from http.server import BaseHTTPRequestHandler

    class Handler(RouterHandler, BaseHTTPRequestHandler):
        # Keep-alive halves the latency of the many short calls coding agents make.
        protocol_version = "HTTP/1.1"

    return Handler


def serve(host: str, port: int) -> int:
    from http.server import ThreadingHTTPServer

    ensure_dirs()
    load_catalog()
    handler = make_handler()
    httpd = ThreadingHTTPServer((host, port), handler)
    httpd.daemon_threads = True
    eprint(f"hyperrouter {VERSION} listening on http://{host}:{port}/v1")
    eprint(f"catalog: {CATALOG_PATH}")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
    return 0


