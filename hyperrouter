        if not args.json:
            print(f"\n── step {item['index']}/{len(plan)} · {item['task']} · {item['model']} ──")
        try:
            result = route_once(messages, model=item["model"], task_hint=item["task"],
                                max_tokens=args.max_tokens or None)
        except RuntimeError as exc:
            die(f"step {item['index']} failed: {exc}")
        answer = response_text(result)
        router = result.get("x_agent_router") or {}
        results.append({"step": item["step"], "task": item["task"],
                        "model": router.get("model"), "provider": router.get("provider"),
                        "latency_ms": router.get("latency_ms"), "output": answer})
        previous.append(f"Step {item['index']} ({item['task']}):\n{answer}")
        if not args.json:
            print(answer)
            print(f"[{router.get('provider')}/{router.get('model')} · {router.get('latency_ms')}ms]")
    if args.json:
        print(json.dumps({"task": text, "plan": plan, "results": results}, indent=2))
    return 0


