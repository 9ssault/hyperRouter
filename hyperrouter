        "pool_key": provider, "context": int(context), "max_output": int(max_output),
        "tools": bool(tools), "vision": bool(vision), "reasoning": bool(reasoning),
        "structured_output": True, "quality": float(quality), "speed": float(speed),
        "routable": True, "unavailable_reason": "",
        "source": "local" if provider in {"vllm"} else "curated",
    }


