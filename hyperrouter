    print(f"{PRODUCT} usage — last {days} day(s)")
    print(f"  requests  {t['requests']}  ({t['ok']} ok, {t['failed']} failed, {rate:.0f}% success)")
    print(f"  tokens    {human_count(t['tokens_in'])} in / {human_count(t['tokens_out'])} out")
    print(f"  latency   {t['avg_latency_ms'] / 1000:.2f}s average")
    if data["daily"]:
        values = [float(row["tok"]) for row in data["daily"]]
        spark = sparkline(values)
        print(f"  daily     {spark}  ({data['daily'][0]['day']} → {data['daily'][-1]['day']})")
    print(f"\nBy {by}:")
    header = {"provider": "provider", "model": "model", "task": "task",
              "day": "day", "account": "account"}[by]
    print(f"  {header:<34} {'req':>5} {'ok':>5} {'in':>8} {'out':>8} {'avg':>7}")
    for row in data["rows"]:
        bucket = row["bucket"] if row["bucket"] is not None else "(unknown)"
        print(f"  {str(bucket)[:34]:<34} {row['n']:>5} {int(row['ok'] or 0):>5} "
              f"{human_count(row['tin']):>8} {human_count(row['tout']):>8} "
              f"{float(row['lat'] or 0) / 1000:>6.2f}s")
    if data["recent"]:
        print("\nRecent:")
        for row in data["recent"]:
            status = "ok" if row["status"] == "ok" else str(row["status"])
            print(f"  {str(row['ts'])[:19]}  {status:<6} {str(row['provider'])}/{row['model']}")
    if data["quota"]:
        print("\nRemaining quota:")
        for item in data["quota"]:
            q = item["quota"]
            left = "unlimited" if q["remaining"] < 0 else f"{q['fraction'] * 100:.0f}%"
            print(f"  {item['provider']:<18} {item['label']:<20} {left}")
    return 0


