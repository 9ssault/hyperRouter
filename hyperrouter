def load_persona(name: str | None) -> str:
    if not name:
        return ""
    candidate = Path(name).expanduser()
    if candidate.is_file():
        return candidate.read_text(encoding="utf-8").strip()
    for base in (LAMA_PROMPTS, CONFIG_HOME / "personas"):
        for ext in ("", ".txt", ".md"):
            path = base / f"{name}{ext}"
            if path.is_file():
                return path.read_text(encoding="utf-8").strip()
    raise ValueError(f"persona not found: {name} (looked in {LAMA_PROMPTS} and {CONFIG_HOME / 'personas'})")


def default_persona() -> str:
    env_file = os.environ.get("LAMA_PERSONA_FILE")
    if env_file:
        return load_persona(env_file)
    env_name = os.environ.get("LAMA_PERSONA")
    if env_name:
        try:
            return load_persona(env_name)
        except ValueError:
            return ""
    config = load_config()
    configured = (config.get("prompt") or {}).get("persona")
    if configured:
        try:
            return load_persona(str(configured))
        except ValueError:
            return ""
    return ""


def build_prompt(
    task: str,
    context: str = "",
    persona: str = "",
    output_format: str = "text",
    constraints: Sequence[str] = (),
    examples: str = "",
    language: str = "",
    tone: str = "",
    max_tokens: int = 0,
) -> str:
    task = (task or "").strip()
    if not task:
        raise ValueError("task is empty")
    task_type, _ = classify_task(task, context_tokens=estimate_tokens(context))
    role = ROLE_GUIDE.get(task_type, ROLE_GUIDE["chat"])
    method = METHOD_GUIDE.get(task_type, METHOD_GUIDE["chat"])
    output = OUTPUT_GUIDE.get(output_format.lower(), OUTPUT_GUIDE["text"])
    parts: list[str] = []
    if persona.strip():
        parts.append(persona.strip())
    parts.append(f"# Role\n{role}")
    parts.append(f"# Objective\n{task}")
    if context.strip():
        parts.append(f"# Context\n{context.strip()}")
    else:
        parts.append("# Context\nNo external context was provided. State any assumptions you need.")
    cons = [str(c).strip() for c in constraints if str(c).strip()]
    cons.extend([
        "Do not invent facts, APIs, files, or citations. If something is unknown, say so.",
        "Prefer a direct answer over a long preamble.",
        "Keep the response focused on the objective.",
    ])
    if language:
        cons.append(f"Respond in {language}.")
    if tone:
        cons.append(f"Use a {tone} tone.")
    parts.append("# Constraints\n" + "\n".join(f"- {c}" for c in cons))
    parts.append("# Method\n" + "\n".join(f"{i}. {step}" for i, step in enumerate(method, 1)))
    if examples.strip():
        parts.append(f"# Examples\n{examples.strip()}")
    parts.append(f"# Output\n{output}")
    parts.append("# Quality bar\n- Be specific and correct. Mark uncertainty explicitly.\n- If the task is impossible as stated, explain why and propose the closest useful alternative.")
    prompt = "\n\n".join(parts).strip() + "\n"
    if max_tokens > 0:
        limit = max_tokens * 4
        if len(prompt) > limit:
            # Preserve the objective and constraints; trim the middle of context.
            head = prompt[: int(limit * 0.65)]
            tail = prompt[-int(limit * 0.25):]
            prompt = head + "\n\n[... context truncated to fit the token budget ...]\n\n" + tail
    return prompt


def prompt_summary(task: str, context: str = "", has_tools: bool = False,
                   has_images: bool = False) -> dict[str, Any]:
    tokens = estimate_tokens(task) + estimate_tokens(context)
    task_type, scores = classify_task(task, has_tools=has_tools, has_images=has_images,
                                      context_tokens=tokens)
    return {"task_type": task_type, "scores": scores, "tokens": tokens}

