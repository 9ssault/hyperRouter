def bench_ms(value: float | None) -> str:
    if value is None:
        return "-"
    return f"{value / 1000:.1f}s" if value >= 1000 else f"{value:.0f}ms"


def bench_label(provider: Any, model: Any) -> str:
    """`pollinations` + `pollinations/openai-fast` should not repeat the provider."""
    name = str(model or "?")
    owner = str(provider or "")
    return name if owner and name.startswith(owner + "/") else f"{owner}/{name}" if owner else name


def bench_candidate(candidate: dict[str, Any], task: str, prompt: str,
                    max_tokens: int, timeout: float) -> dict[str, Any]:
    """One streamed probe: time to first token, total time, and the failure if any."""
    model_meta = candidate.get("model") or {}
    row: dict[str, Any] = {
        "provider": model_meta.get("provider"), "model": model_meta.get("id"),
        "task": task, "ok": False, "ttft_ms": None, "total_ms": None,
        "chars": 0, "error": "",
    }
    started = time.monotonic()
    meta: dict[str, Any] = {}
    try:
        for piece in stream_route([{"role": "user", "content": prompt}],
                                  model=str(model_meta.get("id") or "auto"),
                                  task_hint=task, max_tokens=max_tokens, timeout=timeout,
                                  meta=meta):
            if row["ttft_ms"] is None:
                row["ttft_ms"] = (time.monotonic() - started) * 1000
            row["chars"] += len(piece)
        row["ok"] = row["chars"] > 0
        if not row["ok"]:
            row["error"] = "empty reply"
    except RuntimeError as exc:
        row["error"] = redact(str(exc))[:240]
    row["total_ms"] = (time.monotonic() - started) * 1000
    row["tokens_out"] = meta.get("tokens_out")
    return row


def cmd_bench(args: argparse.Namespace) -> int:
    """Measure what actually matters for an interactive agent: first token, then total."""
    task = normalize_task(args.task or "coding")
    prompt = args.prompt or "Reply with exactly: pong"
    candidates = pick_models(task, limit=200 if args.provider else max(1, args.rounds),
                             strategy=args.strategy)
    if args.provider:
        wanted = args.provider.lower()
        candidates = [c for c in candidates
                      if str((c.get("model") or {}).get("provider") or "").lower() == wanted
                      or wanted in str((c.get("model") or {}).get("provider") or "").lower()]
        candidates = candidates[: max(1, args.rounds)]
    if not candidates:
        die("no free model is available to benchmark; refresh the catalog or add a key")
    rows: list[dict[str, Any]] = []
    if not args.json:
        print(f"bench: {len(candidates)} model(s) · task {task} · prompt {prompt!r}")
        print(f"{'provider/model':<46} {'first':>7} {'total':>7} {'chars':>6}")
    for candidate in candidates:
        row = bench_candidate(candidate, task, prompt, max(1, args.max_tokens), args.timeout)
        rows.append(row)
        if not args.json:
            name = bench_label(row["provider"], row["model"])
            state = "" if row["ok"] else "  FAILED"
            print(f"{name:<46} {bench_ms(row['ttft_ms']):>7} {bench_ms(row['total_ms']):>7} "
                  f"{row['chars']:>6}{state}", flush=True)
            if row["error"]:
                print(f"  {row['error']}", flush=True)
    working = [row for row in rows if row["ok"]]
    fastest = min(working, key=lambda row: (row["ttft_ms"] or 1e9,
                                            row["total_ms"] or 1e9)) if working else None
    if args.json:
        print(json.dumps({"task": task, "prompt": prompt, "rows": rows,
                          "fastest": fastest, "generated_at": utc_now()}, indent=2))
        return 0 if working else 1
    if fastest:
        print(f"\nfastest first token: {bench_label(fastest['provider'], fastest['model'])} "
              f"({bench_ms(fastest['ttft_ms'])}, {bench_ms(fastest['total_ms'])} total)")
    else:
        print("\nno model completed the probe")
    return 0 if working else 1


def split_task(text: str) -> list[str]:
    """Split an explicit list into subtasks; otherwise treat it as one step."""
    lines = [line.rstrip() for line in text.splitlines()]
    numbered = re.compile(r"^\s*(?:\d+[.)]|[-*+])\s+(.+)$")
    items = [match.group(1).strip() for match in (numbered.match(line) for line in lines) if match]
    if len(items) >= 2:
        return [item for item in items if item]
    # Inline lists: "1. design it 2. write it 3. review it"
    inline = [part.strip(" ;,") for part in re.split(r"(?:^|\s)\d{1,2}[.)]\s+", text.strip())]
    inline = [part for part in inline if part]
    if len(inline) >= 2:
        return inline
    paragraphs = [line.strip() for line in lines if line.strip()]
    if len(paragraphs) >= 2 and all(len(line) < 90 for line in paragraphs):
        return paragraphs
    return [text.strip()]


