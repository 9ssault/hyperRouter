    if existing:
        existing.update({
            "revision": int(existing.get("revision") or 1) + 1,
            "name": PRODUCT,
            "provider": "openai-compatible",
            "model": "auto",
            "baseUrl": "http://127.0.0.1:8787/v1",
            "contextWindow": 128000,
            "maxOutputTokens": 8192,
            "credentialRef": "env:HYPERROUTER_API_KEY",
            "updatedAt": now,
        })
        actions.append(f"freebuff: {'would update' if dry_run else 'updated'} BYOK connection in {path}")
    else:
        data.append({
            "id": str(uuid.uuid4()),
            "revision": 1,
            "name": PRODUCT,
            "provider": "openai-compatible",
            "model": "auto",
            "baseUrl": "http://127.0.0.1:8787/v1",
            "contextWindow": 128000,
            "maxOutputTokens": 8192,
            "credentialRef": "env:HYPERROUTER_API_KEY",
            "createdAt": now,
            "updatedAt": now,
        })
        actions.append(f"freebuff: {'would add' if dry_run else 'added'} BYOK connection to {path}")
    if not dry_run:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        backup(path)
        write_text(path, json.dumps(data, indent=2) + "\n")
    # Freebuff reads ~/.agents.md; DSH reads ~/.agents/AGENTS.md.
    body = router_protocol()
    for target in (HOME / ".agents.md", AGENTS_GLOBAL_MD):
        existing_text = strip_legacy_blocks(read_text(target))
        updated = upsert_block(existing_text, body)
        if updated != existing_text:
            if not dry_run:
                backup(target)
                write_text(target, updated)
            actions.append(f"freebuff/dsh: {'would update' if dry_run else 'updated'} {target}")
        else:
            actions.append(f"freebuff/dsh: {target} already configured")
    return actions


def dsh_foreign_items(text: str) -> str:
    """Other tools append their DSH patches inside our managed block; keep them."""
    if DSH_BEGIN not in text or DSH_END not in text:
        return ""
    start = text.index(DSH_BEGIN)
    end = text.index(DSH_END, start)
    block = text[start:end]
    chunks = re.split(r"(?m)^(?=(?:    )?- id: )", block)
    ours = {"llm-pi-ai", "agent-default-model", "llm-pi-ai-hyperrouter",
            "llm-pi-ai-agent-router"}
    foreign: list[str] = []
    for chunk in chunks:
        match = re.match(r"(    )?- id:\s*(\S+)", chunk)
        if not match or match.group(2) in ours:
            continue
        # Items that used to sit inside our `- insert:` list are indented four
        # spaces; root items are not and must keep their indentation.
        nested = chunk.startswith("    - id:")
        lines = [(line[4:] if nested and line.startswith("    ") else line)
                 for line in chunk.rstrip().splitlines()]
        foreign.append("\n".join(lines))
    return "\n".join(foreign)


def dsh_router_block(preserve: str = "") -> str:
    aliases = ["auto", "auto-fast", "auto-quality", "auto-coding", "auto-reasoning",
               "auto-long", "auto-vision", "auto-cheap", "auto-agentic"]
    # Patch the existing llm-pi-ai entry instead of inserting a second copy: two
    # instances of that plugin make dsh reject duplicated provider defaults.
    lines = [
        DSH_BEGIN,
        "- id: llm-pi-ai",
        "  config:",
        "    providers:",
        "      hyperrouter:",
        f"        displayName: {PRODUCT} (free pool)",
        "        apiKeyEnv: HYPERROUTER_API_KEY",
        "        api: openai-completions",
        "        baseURL: http://127.0.0.1:8787/v1",
        "        defaultContextWindow: 128000",
        "        defaultMaxTokens: 8192",
        "        models:",
    ]
    for alias in aliases:
        lines.append(f"          - id: {alias}")
        lines.append(f"            name: {ALIAS_DESCRIPTIONS[alias]}")
        lines.append(f"            contextWindow: {1000000 if alias == 'auto-long' else 128000}")
        lines.append("            maxOutputTokens: 8192")
    lines.extend([
        "- id: agent-default-model",
        "  config:",
        "    provider: hyperrouter",
        "    model: auto",
    ])
    if preserve.strip():
        lines.append(preserve.rstrip())
    lines.append(DSH_END)
    return "\n".join(lines) + "\n"


def setup_dsh(dry_run: bool = False) -> list[str]:
    actions: list[str] = []
    existing = strip_patch_items(strip_legacy_blocks(read_text(DSH_PATCH)),
                                 {"llm-pi-ai-hyperrouter", "llm-pi-ai-agent-router"})
    block = dsh_router_block(dsh_foreign_items(existing))
    if DSH_BEGIN in existing and DSH_END in existing:
        start = existing.index(DSH_BEGIN)
        end = existing.index(DSH_END, start) + len(DSH_END)
        new_text = existing[:start] + block + existing[end:].lstrip("\n")
        if new_text != existing:
            if not dry_run:
                backup(DSH_PATCH)
                write_text(DSH_PATCH, new_text)
            actions.append(f"dsh: {'would update' if dry_run else 'updated'} {DSH_PATCH}")
        else:
            actions.append("dsh: router block already configured")
    else:
        new_text = existing.rstrip() + "\n\n" + block if existing.strip() else block
        if not dry_run:
            backup(DSH_PATCH)
            write_text(DSH_PATCH, new_text)
        actions.append(f"dsh: {'would write' if dry_run else 'wrote'} {DSH_PATCH}")
    agents = strip_legacy_blocks(read_text(AGENTS_GLOBAL_MD))
    updated = upsert_block(agents, router_protocol())
    if updated != agents:
        if not dry_run:
            backup(AGENTS_GLOBAL_MD)
            write_text(AGENTS_GLOBAL_MD, updated)
        actions.append(f"dsh: {'would update' if dry_run else 'updated'} {AGENTS_GLOBAL_MD}")
    else:
        actions.append("dsh: AGENTS.md already configured")
    return actions


def cmd_keys(args: argparse.Namespace) -> int:
    action = args.action
    dry_run = bool(getattr(args, "dry_run", False))
    if action == "status":
        conn = connect()
        try:
            rows = active_key_rows(conn)
        finally:
            conn.close()
        data = {
            "auth": "required" if rows else "open",
            "active_keys": len(rows),
            "source": key_source(),
            "keyring": bool(shutil.which("secret-tool")),
            "file": str(KEY_PATH),
            "env_var": "HYPERROUTER_API_KEY",
            "last_used": rows[0]["last_used"] if rows else None,
        }
        if args.json:
            print(json.dumps(data, indent=2))
        else:
            print(f"auth: {data['auth']}")
            print(f"active keys: {data['active_keys']}")
            print(f"raw key source: {data['source']}")
            print(f"keyring available: {data['keyring']}")
            print(f"file fallback: {data['file']}")
            print(f"environment variable: {data['env_var']}")
        return 0

    if action == "list":
        conn = connect()
        try:
            rows = list(conn.execute(
                "SELECT label, prefix, created_at, last_used, revoked FROM api_keys "
                "ORDER BY created_at DESC"
            ).fetchall())
        finally:
            conn.close()
        payload = [dict(row) for row in rows]
        if args.json:
            print(json.dumps(payload, indent=2))
            return 0
        if not payload:
            print("No router keys. Run: hyperrouter keys generate")
            return 0
        print(f"{'label':<16} {'prefix':<14} {'created':<22} {'last used':<22} status")
        for row in payload:
            status = "revoked" if row["revoked"] else "active"
            print(f"{row['label']:<16} {row['prefix']:<14} {row['created_at']:<22} "
                  f"{str(row['last_used'] or '-'):<22} {status}")
        return 0

    if action == "generate":
        if dry_run:
            print("DRY RUN: would generate a local router key and store it in the OS keyring "
                  "(or a 0600 file).")
            for item in (install_env_block(dry_run=True) + setup_opencode(dry_run=True)
                         + setup_freebuff(dry_run=True) + setup_dsh(dry_run=True)):
                print("DRY RUN: " + item)
            return 0
        try:
            raw = generate_api_key(label=args.label or "default", revoke_existing=False)
        except ValueError as exc:
            die(str(exc))
        actions = []
        if not args.no_wire:
            actions.extend(install_env_block(dry_run=False))
            actions.extend(setup_opencode(dry_run=False))
            actions.extend(setup_freebuff(dry_run=False))
            actions.extend(setup_dsh(dry_run=False))
        print(f"Generated hyperrouter key ({len(raw)} chars).")
        if args.show:
            print(raw)
        else:
            print("Raw key is stored in the OS keyring (or 0600 file). "
                  "Use `hyperrouter keys show` to print it.")
        for item in actions:
            print(item)
        print("Open a new shell (or `source ~/.bashrc`) so HYPERROUTER_API_KEY is set.")
        return 0

    if action == "rotate":
        if dry_run:
            print("DRY RUN: would revoke all active router keys and generate a new one.")
            for item in (install_env_block(dry_run=True) + setup_opencode(dry_run=True)
                         + setup_freebuff(dry_run=True) + setup_dsh(dry_run=True)):
                print("DRY RUN: " + item)
            return 0
        count = revoke_all_keys()
        raw = generate_api_key(label=args.label or "default", revoke_existing=True)
        actions = []
        if not args.no_wire:
            actions.extend(install_env_block(dry_run=False))
            actions.extend(setup_opencode(dry_run=False))
            actions.extend(setup_freebuff(dry_run=False))
            actions.extend(setup_dsh(dry_run=False))
        print(f"Revoked {count} key(s) and generated a new one.")
        if args.show:
            print(raw)
        for item in actions:
            print(item)
        print("New requests use the new key immediately; no restart is required.")
        return 0

    if action == "show":
        raw = load_api_key()
        if not raw:
            die("no router key found; run `hyperrouter keys generate`")
        if args.json:
            print(json.dumps({"key": raw, "source": key_source()}, indent=2))
        else:
            print(raw)
        return 0

    if action == "env":
        raw = load_api_key()
        if not raw:
            die("no router key found; run `hyperrouter keys generate`")
        print(f"export HYPERROUTER_API_KEY={shlex_join([raw])}")
        return 0

    if action == "revoke":
        count = revoke_all_keys()
        actions = remove_env_block(dry_run=args.dry_run) if args.remove_env else []
        print(f"Revoked {count} key(s). The router is now open on localhost until a new key is generated.")
        for item in actions:
            print(("DRY RUN: " if args.dry_run else "") + item)
        return 0

    die(f"unknown keys action: {action}")


def cmd_setup(args: argparse.Namespace) -> int:
    ensure_dirs()
    targets = (["opencode", "freebuff", "dsh", "claude"] if args.target == "all"
               else [args.target])
    actions: list[str] = []
    try:
        if not args.no_key:
            conn = connect()
            try:
                has_key = bool(active_key_rows(conn))
            finally:
                conn.close()
            if not has_key:
                if args.dry_run:
                    actions.append("keys: would generate a local router key for all clients")
                else:
                    generate_api_key(label="default")
                    actions.append("keys: generated a local router key for all clients")
            if args.dry_run:
                actions.extend(install_env_block(dry_run=True))
            else:
                actions.extend(install_env_block())
        for target in targets:
            if target == "opencode":
                actions.extend(setup_opencode(dry_run=args.dry_run))
            elif target == "freebuff":
                actions.extend(setup_freebuff(dry_run=args.dry_run))
            elif target == "dsh":
                actions.extend(setup_dsh(dry_run=args.dry_run))
            elif target == "claude":
                actions.extend(setup_claude(dry_run=args.dry_run))
        protocol = PROTOCOL_PATH
        existing_protocol = read_text(protocol)
        if existing_protocol.strip() != PROTOCOL_FALLBACK.strip():
            if args.dry_run:
                actions.append(f"protocol: would update {protocol}")
            else:
                write_text(protocol, PROTOCOL_FALLBACK)
                actions.append(f"protocol: {'updated' if existing_protocol else 'wrote'} {protocol}")
        else:
            actions.append(f"protocol: {protocol} already current")
        if not args.no_skills:
            if args.dry_run:
                actions.append(f"skills: would install {len(DEFAULT_SKILL_COLLECTIONS)} default collections")
            else:
                actions.extend(ensure_default_skills(verbose=False))
                if not any(line.startswith("skills:") for line in actions):
                    actions.append(f"skills: {len(DEFAULT_SKILL_COLLECTIONS)} collections already installed")
        if not args.no_mcp:
            if args.dry_run:
                actions.append("mcp: would enable the default web servers")
            else:
                actions.extend(ensure_default_mcp())
        if args.start and not args.dry_run:
            actions.append("starting router service")
            service_start("127.0.0.1", 8787)
    except ValueError as exc:
        die(str(exc))
    if args.json:
        print(json.dumps({"dry_run": args.dry_run, "targets": targets, "actions": actions}, indent=2))
    else:
        prefix = "DRY RUN: " if args.dry_run else ""
        for action in actions:
            print(prefix + action)
    return 0


