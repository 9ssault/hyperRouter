def content_to_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict):
                if item.get("type") == "text":
                    parts.append(str(item.get("text") or ""))
                elif item.get("type") == "image_url":
                    parts.append("[image]")
        return "\n".join(parts)
    return str(content or "")


def messages_to_text(messages: Any) -> str:
    if not isinstance(messages, list):
        return ""
    parts = []
    for msg in messages:
        if not isinstance(msg, dict):
            continue
        role = str(msg.get("role") or "user")
        parts.append(f"{role}: {content_to_text(msg.get('content'))}")
    return "\n".join(parts)


def has_images(messages: Any) -> bool:
    if not isinstance(messages, list):
        return False
    for msg in messages:
        content = msg.get("content") if isinstance(msg, dict) else None
        if isinstance(content, list):
            for item in content:
                if isinstance(item, dict) and item.get("type") in {"image_url", "input_image"}:
                    return True
    return False


def extract_usage(data: Any) -> tuple[int, int]:
    if not isinstance(data, dict):
        return 0, 0
    usage = data.get("usage")
    if isinstance(usage, dict):
        return int(usage.get("prompt_tokens") or usage.get("input_tokens") or 0), int(
            usage.get("completion_tokens") or usage.get("output_tokens") or 0
        )
    return 0, 0


def response_text(data: Any) -> str:
    if not isinstance(data, dict):
        return ""
    choices = data.get("choices")
    if not isinstance(choices, list) or not choices:
        return ""
    first = choices[0]
    if not isinstance(first, dict):
        return ""
    message = first.get("message")
    if isinstance(message, dict):
        return content_to_text(message.get("content"))
    return content_to_text(first.get("text"))


def upstream_headers(provider: str, account: dict[str, Any]) -> dict[str, str]:
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": f"hyperrouter/{VERSION}",
    }
    key = str(account.get("key") or "")
    if key:
        headers["Authorization"] = f"Bearer {key}"
    if provider == "openrouter":
        headers["HTTP-Referer"] = "https://github.com/cheaper-inference/OmniRoute"
        headers["X-Title"] = "hyperrouter"
    return headers


def provider_payload(body: dict[str, Any], upstream_model: str) -> dict[str, Any]:
    payload = copy.deepcopy(body)
    payload["model"] = upstream_model
    for key in ("router", "provider", "account", "x_agent_router"):
        payload.pop(key, None)
    return payload


def discover_local_model(model: dict[str, Any], account: dict[str, Any]) -> str | None:
    url = models_url(model["provider"])
    if not url:
        return None
    headers = upstream_headers(model["provider"], account)
    status, _, data = http_json("GET", url, headers=headers, timeout=10)
    if status != 200 or not isinstance(data, dict):
        return None
    items = data.get("data")
    if not isinstance(items, list):
        return None
    for item in items:
        if not isinstance(item, dict):
            continue
        mid = str(item.get("id") or "")
        if not mid:
            continue
        low = mid.lower()
        if any(x in low for x in ("embed", "whisper", "tts", "rerank")):
            continue
        return mid
    return None


def call_candidate(
    candidate: dict[str, Any],
    body: dict[str, Any],
    requested_model: str,
    task: str,
    timeout: float = 45.0,
) -> tuple[bool, Any]:
    model = candidate["model"]
    account = candidate["account"]
    provider = model["provider"]
    upstream_model = str(model.get("model") or "")
    if upstream_model == "*":
        discovered = discover_local_model(model, account)
        if not discovered:
            return False, {"status": 0, "error": f"{provider}: no local model discovered"}
        upstream_model = discovered
    url = chat_url(provider)
    if not url:
        return False, {"status": 0, "error": f"{provider}: no endpoint"}
    headers = upstream_headers(provider, account)
    payload = provider_payload(body, upstream_model)
    started = time.monotonic()
    status, hdrs, data = http_json("POST", url, headers=headers, payload=payload, timeout=timeout)
    latency = (time.monotonic() - started) * 1000
    if status != 200 or not isinstance(data, dict):
        err = data if isinstance(data, str) else json.dumps(data, ensure_ascii=False)[:800]
        if not err:
            err = f"HTTP {status}"
        record_attempt(account, model, task, "error", status, 0, 0, latency, str(err))
        return False, {"status": status, "error": redact(str(err)), "provider": provider, "model": upstream_model}
    tokens_in, tokens_out = extract_usage(data)
    if not tokens_in:
        tokens_in = estimate_tokens(messages_to_text(body.get("messages")))
    if not tokens_out:
        tokens_out = estimate_tokens(response_text(data))
    record_attempt(account, model, task, "ok", status, tokens_in, tokens_out, latency)
    data["model"] = requested_model
    if not data.get("usage"):
        data["usage"] = {"prompt_tokens": tokens_in, "completion_tokens": tokens_out,
                         "total_tokens": tokens_in + tokens_out}
    data["x_agent_router"] = {
        "provider": provider, "model": upstream_model, "task": task,
        "account": account.get("label"), "latency_ms": round(latency, 1),
    }
    return True, data


def prepare_route(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str | None = None,
    strategy: str | None = None,
    max_tokens: int | None = None,
    temperature: float | None = None,
    tools: list[dict[str, Any]] | None = None,
) -> tuple[dict[str, Any], str, str, list[dict[str, Any]]]:
    """Classify the request, apply delegation settings, and rank candidates."""
    config = load_config()
    requested = model or "auto"
    body: dict[str, Any] = {"model": requested, "messages": messages}
    cap = max_tokens or int(config.get("routing", {}).get("max_tokens") or 0)
    if cap:
        body["max_tokens"] = int(cap)
    if temperature is not None:
        body["temperature"] = float(temperature)
    task_override = TASK_ALIASES.get(requested) if requested in TASK_ALIASES else None
    if task_hint:
        task_override = task_hint
    text = messages_to_text(messages)
    needs_tools = bool(tools)
    images = has_images(messages)
    context_tokens = estimate_tokens(text)
    task = task_override or classify_task(text, has_tools=needs_tools, has_images=images,
                                         context_tokens=context_tokens)[0]
    if requested == "auto-fast":
        strategy = "speed"
    elif requested == "auto-quality":
        strategy = "quality"
    elif requested == "auto-cheap":
        strategy = "cheap"
    if tools:
        body["tools"] = tools
    explicit = None if requested in TASK_ALIASES else requested
    # Delegation: a task can be pinned to a specific model in settings.
    pinned = ((config.get("routing", {}).get("task_models") or {}).get(task)
              if isinstance(config.get("routing", {}).get("task_models"), dict) else None)
    if pinned and not explicit:
        if catalog_model(str(pinned)):
            explicit = str(pinned)
    candidates = pick_models(
        task, limit=int(config.get("routing", {}).get("max_fallbacks") or 6),
        strategy=strategy, need_tools=needs_tools, need_vision=images,
        need_context=context_tokens, explicit_model=explicit,
    )
    if not candidates and pinned and not explicit:
        candidates = pick_models(task, limit=3, strategy=strategy, need_tools=needs_tools,
                                 need_vision=images, need_context=context_tokens)
    if not candidates:
        raise RuntimeError(
            "no free model is available. Set a provider key (for example GROQ_API_KEY, "
            "MISTRAL_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY), start a local "
            "Ollama/llama.cpp server, or run `hyperrouter accounts add`."
        )
    return body, requested, task, candidates


def route_once(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str | None = None,
    strategy: str | None = None,
    max_tokens: int | None = None,
    timeout: float | None = None,
    temperature: float | None = None,
    tools: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    body, requested, task, candidates = prepare_route(
        messages, model=model, task_hint=task_hint, strategy=strategy,
        max_tokens=max_tokens, temperature=temperature, tools=tools)
    errors = []
    failed_accounts: set[str] = set()
    per_timeout = float(timeout) if timeout else routing_timeout()
    deadline = time.monotonic() + routing_timeout(total=True)
    for candidate in candidates:
        account = candidate.get("account") or {}
        if account.get("id") in failed_accounts:
            continue
        remaining = deadline - time.monotonic()
        if remaining <= 1:
            errors.append({"provider": candidate["model"].get("provider"),
                           "model": candidate["model"].get("model"),
                           "status": 0, "error": "routing deadline exceeded"})
            break
        ok, result = call_candidate(candidate, body, requested, task,
                                    timeout=min(per_timeout, remaining))
        if ok:
            return result
        errors.append(result)
        if account_wide_error(int(result.get("status") or 0)):
            failed_accounts.add(str(account.get("id")))
    raise RuntimeError("all free candidates failed: " + "; ".join(
        f"{e.get('provider')}/{e.get('model')} HTTP {e.get('status')}: {e.get('error')}" for e in errors
    ))


def stream_route(
    messages: list[dict[str, Any]],
    model: str = "auto",
    task_hint: str | None = None,
    strategy: str | None = None,
    max_tokens: int | None = None,
    temperature: float | None = None,
    meta: dict[str, Any] | None = None,
) -> Iterator[str]:
    """Stream tokens from the best free model, failing over before the first token.

    Metadata about the winning model is written into `meta` when the stream
    starts (provider/model) and again when it ends (latency, tokens).
    """
    body, requested, task, candidates = prepare_route(
        messages, model=model, task_hint=task_hint, strategy=strategy,
        max_tokens=max_tokens, temperature=temperature)
    meta = meta if meta is not None else {}
    errors: list[dict[str, Any]] = []
    failed_accounts: set[str] = set()
    per_timeout = routing_timeout()
    deadline = time.monotonic() + routing_timeout(total=True)
    for candidate in candidates:
        account = candidate.get("account") or {}
        if account.get("id") in failed_accounts:
            continue
        remaining = deadline - time.monotonic()
        if remaining <= 1:
            errors.append({"provider": candidate["model"].get("provider"),
                           "model": candidate["model"].get("model"),
                           "status": 0, "error": "routing deadline exceeded"})
            break
        model_meta = candidate["model"]
        provider = model_meta["provider"]
        upstream_model = str(model_meta.get("model") or "")
        if upstream_model == "*":
            discovered = discover_local_model(model_meta, account)
            if not discovered:
                errors.append({"provider": provider, "model": "*", "status": 0,
                               "error": "no local model discovered"})
                continue
            upstream_model = discovered
        url = chat_url(provider)
        if not url:
            errors.append({"provider": provider, "model": upstream_model, "status": 0,
                           "error": "no endpoint"})
            continue
        headers = upstream_headers(provider, account)
        headers["Accept"] = "text/event-stream"
        payload = provider_payload(body, upstream_model)
        payload["stream"] = True
        req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"),
                                     headers=headers, method="POST")
        started = time.monotonic()
        timeout = min(per_timeout, remaining)
        try:
            resp = urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError as exc:
            raw = exc.read().decode("utf-8", "replace")
            record_attempt(account, model_meta, task, "error", exc.code, 0, 0,
                           (time.monotonic() - started) * 1000, raw)
            errors.append({"provider": provider, "model": upstream_model,
                           "status": exc.code, "error": redact(raw)[:300]})
            if account_wide_error(exc.code):
                failed_accounts.add(str(account.get("id")))
            continue
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            message = str(getattr(exc, "reason", exc))
            record_attempt(account, model_meta, task, "error", 0, 0, 0,
                           (time.monotonic() - started) * 1000, message)
            errors.append({"provider": provider, "model": upstream_model,
                           "status": 0, "error": redact(message)[:300]})
            continue
        produced = 0
        usage_in = 0
        usage_out = 0
        collected: list[str] = []
        try:
            first = resp.readline()
            if not first:
                record_attempt(account, model_meta, task, "error", 0, 0, 0,
                               (time.monotonic() - started) * 1000, "empty stream")
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": "empty stream"})
                resp.close()
                continue
            if first.lstrip().startswith(b"{"):
                raw = (first + resp.read()).decode("utf-8", "replace")
                record_attempt(account, model_meta, task, "error", 0, 0, 0,
                               (time.monotonic() - started) * 1000, raw)
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": redact(raw)[:300]})
                resp.close()
                continue
            meta.update({"provider": provider, "model": upstream_model, "task": task,
                         "account": account.get("label")})
            for raw_line in itertools.chain((first,), resp):
                line = raw_line.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                chunk = line[5:].strip()
                if not chunk or chunk == "[DONE]":
                    continue
                try:
                    obj = json.loads(chunk)
                except json.JSONDecodeError:
                    continue
                tin, tout = extract_usage(obj)
                usage_in = tin or usage_in
                usage_out = tout or usage_out
                choices = obj.get("choices") if isinstance(obj, dict) else None
                if isinstance(choices, list) and choices and isinstance(choices[0], dict):
                    delta = choices[0].get("delta") or {}
                    piece = content_to_text(delta.get("content"))
                    if piece:
                        produced += len(piece)
                        collected.append(piece)
                        yield piece
            resp.close()
            latency = (time.monotonic() - started) * 1000
            if not produced:
                record_attempt(account, model_meta, task, "error", 0, 0, 0, latency,
                               "stream produced no text")
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": "stream produced no text"})
                continue
            if not usage_in:
                usage_in = estimate_tokens(messages_to_text(body.get("messages")))
            if not usage_out:
                usage_out = estimate_tokens("".join(collected))
            record_attempt(account, model_meta, task, "ok", 200, usage_in, usage_out, latency)
            meta.update({"latency_ms": round(latency, 1), "tokens_in": usage_in,
                         "tokens_out": usage_out})
            return
        except GeneratorExit:
            resp.close()
            raise
        except Exception as exc:  # noqa: BLE001 - mid-stream failures cannot fail over
            resp.close()
            record_attempt(account, model_meta, task, "error", 0, 0, 0,
                           (time.monotonic() - started) * 1000, str(exc))
            meta["error"] = redact(str(exc))
            return
    raise RuntimeError("all free candidates failed: " + "; ".join(
        f"{e.get('provider')}/{e.get('model')} HTTP {e.get('status')}: {e.get('error')}"
        for e in errors))


class RouterHandler:
    """Mixin-style handler methods; the real class is created below."""

    server_version = f"hyperrouter/{VERSION}"

    def log_message(self, fmt: str, *args: Any) -> None:
        try:
            line = f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} {fmt % args}\n"
            with LOG_PATH.open("a", encoding="utf-8") as fh:
                fh.write(line)
        except OSError:
            pass

    def send_json(self, status: int, payload: Any) -> None:
        raw = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def read_body(self) -> dict[str, Any]:
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b"{}"
        data = json.loads(raw.decode("utf-8", "replace"))
        if not isinstance(data, dict):
            raise ValueError("body must be a JSON object")
        return data

    def authorized(self) -> bool:
        if not auth_required():
            return True
        header = str(self.headers.get("Authorization") or "").strip()
        raw = header[7:].strip() if header.lower().startswith("bearer ") else ""
        if not raw:
            raw = str(self.headers.get("x-api-key") or "").strip()
        return verify_api_key(raw)

    def require_auth(self) -> bool:
        if self.authorized():
            return True
        self.send_json(401, {"error": {
            "message": "invalid or missing hyperrouter API key. Run `hyperrouter keys show` "
                       "and set HYPERROUTER_API_KEY, or `hyperrouter keys rotate`.",
            "type": "authentication_error",
        }})
        return False

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path in {"/", "/health", "/healthz"}:
            catalog = load_catalog()
            accounts = discover_accounts()
            providers = sorted({a["provider"] for a in accounts})
            self.send_json(200, {
                "ok": True, "version": VERSION, "service": "hyperrouter",
                "base_url": f"http://{self.headers.get('Host', '127.0.0.1')}/v1",
                "auth": "required" if auth_required() else "open",
                "catalog": {"models": len(catalog.get("models") or []),
                             "providers": len(catalog.get("providers") or {}),
                             "generated_at": catalog.get("generated_at")},
                "accounts": {"total": len(accounts), "providers": providers},
            })
            return
        if path == "/v1/models":
            if not self.require_auth():
                return
            catalog = load_catalog()
            data = []
            for alias, desc in ALIAS_DESCRIPTIONS.items():
                data.append({"id": alias, "object": "model", "created": 0,
                             "owned_by": "hyperrouter", "description": desc})
            seen = set()
            for model in catalog.get("models") or []:
                if not model.get("routable") or model.get("free_type") == "discontinued":
                    continue
                mid = model.get("id")
                if mid in seen:
                    continue
                seen.add(mid)
                data.append({
                    "id": mid, "object": "model", "created": 0, "owned_by": model.get("provider"),
                    "context_window": model.get("context"), "free_type": model.get("free_type"),
                    "tos": model.get("tos"), "name": model.get("name"),
                })
                if len(data) >= 80:
                    break
            self.send_json(200, {"object": "list", "data": data})
            return
        self.send_json(404, {"error": {"message": "not found", "type": "not_found"}})

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        if path not in {"/v1/chat/completions", "/v1/completions"}:
            self.send_json(404, {"error": {"message": "not found", "type": "not_found"}})
            return
        if not self.require_auth():
            return
        try:
            body = self.read_body()
        except (ValueError, json.JSONDecodeError) as exc:
            self.send_json(400, {"error": {"message": f"invalid JSON: {exc}", "type": "invalid_request_error"}})
            return
        if path == "/v1/completions":
            prompt = body.get("prompt")
            if isinstance(prompt, list):
                prompt = "\n".join(str(x) for x in prompt)
            body = {**body, "messages": [{"role": "user", "content": str(prompt or "")}]}
        try:
            self.handle_chat(body)
        except BrokenPipeError:
            return
        except Exception as exc:  # noqa: BLE001 - the proxy must not crash the server
            self.send_json(500, {"error": {"message": redact(str(exc)), "type": "router_error"}})

    def handle_chat(self, body: dict[str, Any]) -> None:
        requested = str(body.get("model") or "auto")
        messages = body.get("messages") or []
        if not isinstance(messages, list) or not messages:
            self.send_json(400, {"error": {"message": "messages must be a non-empty array",
                                            "type": "invalid_request_error"}})
            return
        task_override = TASK_ALIASES.get(requested) if requested in TASK_ALIASES else None
        text = messages_to_text(messages)
        tools = bool(body.get("tools"))
        images = has_images(messages)
        context_tokens = estimate_tokens(text)
        task = task_override or classify_task(text, has_tools=tools, has_images=images,
                                             context_tokens=context_tokens)[0]
        strategy = None
        if requested == "auto-fast":
            strategy = "speed"
        elif requested == "auto-quality":
            strategy = "quality"
        elif requested == "auto-cheap":
            strategy = "cheap"
        explicit = None if requested in TASK_ALIASES else requested
        candidates = pick_models(
            task, limit=int(load_config().get("routing", {}).get("max_fallbacks") or 6),
            strategy=strategy, need_tools=tools, need_vision=images,
            need_context=context_tokens, explicit_model=explicit,
        )
        if not candidates:
            self.send_json(503, {"error": {
                "message": "no free model is available. Configure a provider key or start a local "
                           "Ollama/llama.cpp server. Run `hyperrouter doctor` for details.",
                "type": "router_unavailable",
            }})
            return
        stream = bool(body.get("stream"))
        if stream:
            self.handle_stream(body, candidates, requested, task)
            return
        errors = []
        failed_accounts: set[str] = set()
        per_timeout = routing_timeout()
        deadline = time.monotonic() + routing_timeout(total=True)
        for candidate in candidates:
            account = candidate.get("account") or {}
            if account.get("id") in failed_accounts:
                continue
            remaining = deadline - time.monotonic()
            if remaining <= 1:
                errors.append({"provider": candidate["model"].get("provider"),
                               "model": candidate["model"].get("model"),
                               "status": 0, "error": "routing deadline exceeded"})
                break
            ok, result = call_candidate(candidate, body, requested, task,
                                        timeout=min(per_timeout, remaining))
            if ok:
                self.send_json(200, result)
                return
            errors.append(result)
            if account_wide_error(int(result.get("status") or 0)):
                failed_accounts.add(str(account.get("id")))
        self.send_json(502, {"error": {
            "message": "all free candidates failed",
            "type": "router_error",
            "details": errors,
        }})

    def handle_stream(self, body: dict[str, Any], candidates: list[dict[str, Any]],
                      requested: str, task: str) -> None:
        errors = []
        failed_accounts: set[str] = set()
        per_timeout = routing_timeout()
        deadline = time.monotonic() + routing_timeout(total=True)
        for candidate in candidates:
            account = candidate.get("account") or {}
            if account.get("id") in failed_accounts:
                continue
            remaining = deadline - time.monotonic()
            if remaining <= 1:
                errors.append({"provider": candidate["model"].get("provider"),
                               "model": candidate["model"].get("model"),
                               "status": 0, "error": "routing deadline exceeded"})
                break
            model = candidate["model"]
            account = candidate["account"]
            provider = model["provider"]
            upstream_model = str(model.get("model") or "")
            if upstream_model == "*":
                discovered = discover_local_model(model, account)
                if not discovered:
                    errors.append({"provider": provider, "model": "*", "status": 0,
                                   "error": "no local model discovered"})
                    continue
                upstream_model = discovered
            url = chat_url(provider)
            if not url:
                errors.append({"provider": provider, "model": upstream_model, "status": 0,
                               "error": "no endpoint"})
                continue
            headers = upstream_headers(provider, account)
            headers["Accept"] = "text/event-stream"
            payload = provider_payload(body, upstream_model)
            payload["stream"] = True
            req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"),
                                         headers=headers, method="POST")
            started = time.monotonic()
            try:
                resp = urllib.request.urlopen(req, timeout=min(per_timeout, remaining))
            except urllib.error.HTTPError as exc:
                raw = exc.read().decode("utf-8", "replace")
                latency = (time.monotonic() - started) * 1000
                record_attempt(account, model, task, "error", exc.code, 0, 0, latency, raw)
                errors.append({"provider": provider, "model": upstream_model,
                               "status": exc.code, "error": redact(raw)[:500]})
                if account_wide_error(exc.code):
                    failed_accounts.add(str(account.get("id")))
                continue
            except (urllib.error.URLError, TimeoutError) as exc:
                latency = (time.monotonic() - started) * 1000
                record_attempt(account, model, task, "error", 0, 0, 0, latency, str(exc))
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": redact(str(exc))})
                continue
            try:
                first = resp.readline()
                if not first:
                    record_attempt(account, model, task, "error", 0, 0, 0,
                                   (time.monotonic() - started) * 1000, "empty stream")
                    errors.append({"provider": provider, "model": upstream_model,
                                   "status": 0, "error": "empty stream"})
                    resp.close()
                    continue
                if first.lstrip().startswith(b"{"):
                    raw = first + resp.read()
                    record_attempt(account, model, task, "error", 0, 0, 0,
                                   (time.monotonic() - started) * 1000, raw.decode("utf-8", "replace"))
                    errors.append({"provider": provider, "model": upstream_model,
                                   "status": 0, "error": redact(raw.decode("utf-8", "replace"))[:500]})
                    resp.close()
                    continue
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream; charset=utf-8")
                self.send_header("Cache-Control", "no-cache")
                self.send_header("Connection", "keep-alive")
                self.send_header("X-Accel-Buffering", "no")
                self.end_headers()
                self.wfile.write(first)
                self.wfile.flush()
                usage_in = 0
                usage_out = 0
                collected: list[str] = []
                for raw_line in resp:
                    self.wfile.write(raw_line)
                    self.wfile.flush()
                    line = raw_line.decode("utf-8", "replace").strip()
                    if line.startswith("data:"):
                        chunk = line[5:].strip()
                        if chunk and chunk != "[DONE]":
                            try:
                                obj = json.loads(chunk)
                            except json.JSONDecodeError:
                                continue
                            tin, tout = extract_usage(obj)
                            usage_in = tin or usage_in
                            usage_out = tout or usage_out
                            choices = obj.get("choices") if isinstance(obj, dict) else None
                            if isinstance(choices, list) and choices:
                                delta = choices[0].get("delta") if isinstance(choices[0], dict) else None
                                if isinstance(delta, dict):
                                    collected.append(content_to_text(delta.get("content")))
                resp.close()
                if not usage_in:
                    usage_in = estimate_tokens(messages_to_text(body.get("messages")))
                if not usage_out:
                    usage_out = estimate_tokens("".join(collected))
                record_attempt(account, model, task, "ok", 200, usage_in, usage_out,
                               (time.monotonic() - started) * 1000)
                return
            except BrokenPipeError:
                try:
                    resp.close()
                except Exception:
                    pass
                record_attempt(account, model, task, "ok", 200, 0, 0,
                               (time.monotonic() - started) * 1000)
                return
            except Exception as exc:  # noqa: BLE001
                try:
                    resp.close()
                except Exception:
                    pass
                record_attempt(account, model, task, "error", 0, 0, 0,
                               (time.monotonic() - started) * 1000, str(exc))
                errors.append({"provider": provider, "model": upstream_model,
                               "status": 0, "error": redact(str(exc))})
                # Headers may already be sent; cannot fail over cleanly.
                try:
                    self.wfile.write(b"data: {\"error\":{\"message\":\"upstream stream failed\"}}\n\n")
                    self.wfile.flush()
                except Exception:
                    pass
                return
        self.send_json(502, {"error": {"message": "all free candidates failed",
                                        "type": "router_error", "details": errors}})


def make_handler() -> type:
    from http.server import BaseHTTPRequestHandler

    class Handler(RouterHandler, BaseHTTPRequestHandler):
        pass

    return Handler


def serve(host: str, port: int) -> int:
    from http.server import ThreadingHTTPServer

    ensure_dirs()
    load_catalog()
    handler = make_handler()
    httpd = ThreadingHTTPServer((host, port), handler)
    eprint(f"hyperrouter {VERSION} listening on http://{host}:{port}/v1")
    eprint(f"catalog: {CATALOG_PATH}")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
    return 0


# ---------------------------------------------------------------------------
# Service management
# ---------------------------------------------------------------------------


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def read_pid() -> int | None:
    try:
        return int(PID_PATH.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, ValueError):
        return None


def health_check(host: str, port: int) -> dict[str, Any] | None:
    status, _, data = http_json("GET", f"http://{host}:{port}/health", timeout=2)
    if status == 200 and isinstance(data, dict):
        return data
    return None


def service_start(host: str, port: int) -> int:
    ensure_dirs()
    pid = read_pid()
    if pid and pid_alive(pid):
        print(f"hyperrouter already running (pid {pid})")
        return 0
    log = LOG_PATH.open("ab")
    try:
        proc = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "serve", "--host", host, "--port", str(port)],
            stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
            start_new_session=True, close_fds=True,
        )
    finally:
        log.close()
    PID_PATH.write_text(str(proc.pid), encoding="utf-8")
    try:
        os.chmod(PID_PATH, 0o600)
    except OSError:
        pass
    for _ in range(30):
        if health_check(host, port):
            print(f"hyperrouter started (pid {proc.pid}) at http://{host}:{port}/v1")
            return 0
        time.sleep(0.1)
    print(f"hyperrouter started (pid {proc.pid}), but health check is not ready yet")
    print(f"log: {LOG_PATH}")
    return 0


def service_stop() -> int:
    pid = read_pid()
    if not pid:
        print("hyperrouter is not running")
        return 0
    if not pid_alive(pid):
        PID_PATH.unlink(missing_ok=True)
        print("hyperrouter is not running (stale pid removed)")
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    for _ in range(30):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    if pid_alive(pid):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    PID_PATH.unlink(missing_ok=True)
    print("hyperrouter stopped")
    return 0


def service_status(host: str, port: int, as_json: bool = False) -> int:
    pid = read_pid()
    alive = bool(pid and pid_alive(pid))
    health = health_check(host, port)
    data = {"running": alive, "pid": pid, "health": health,
            "base_url": f"http://{host}:{port}/v1", "log": str(LOG_PATH)}
    if as_json:
        print(json.dumps(data, indent=2))
    else:
        print(f"running: {alive}")
        print(f"pid: {pid}")
        print(f"base_url: http://{host}:{port}/v1")
        print(f"health: {'ok' if health else 'unreachable'}")
        if health:
            print(f"catalog: {health.get('catalog')}")
            print(f"accounts: {health.get('accounts')}")
    return 0 if alive else 1


# ---------------------------------------------------------------------------
# Local API keys
# ---------------------------------------------------------------------------


def hash_api_key(raw: str) -> str:
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def _secret_tool(args: list[str], payload: bytes | None = None) -> subprocess.CompletedProcess[bytes] | None:
    binary = shutil.which("secret-tool")
    if not binary:
        return None
    try:
        return subprocess.run(
            [binary, *args],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None


def keyring_enabled() -> bool:
    return os.environ.get("HYPERROUTER_NO_KEYRING", "").lower() not in {"1", "true", "yes", "on"}


def keyring_store(raw: str) -> bool:
    if not keyring_enabled():
        return False
    result = _secret_tool(
        ["store", "--label=hyperrouter local key", "service", KEYRING_SERVICE,
         KEYRING_ATTR, KEYRING_VALUE],
        payload=raw.encode("utf-8"),
    )
    if result is None or result.returncode != 0:
        return False
    check = _secret_tool(["lookup", "service", KEYRING_SERVICE, KEYRING_ATTR, KEYRING_VALUE])
    return bool(check and check.returncode == 0 and check.stdout.decode("utf-8", "replace").strip() == raw)


def keyring_load() -> str:
    if not keyring_enabled():
        return ""
    for service in (KEYRING_SERVICE, "agent-router"):
        result = _secret_tool(["lookup", "service", service, KEYRING_ATTR, KEYRING_VALUE])
        if result and result.returncode == 0:
            value = result.stdout.decode("utf-8", "replace").strip()
            if value:
                return value
    return ""


def keyring_clear() -> None:
    if not keyring_enabled():
        return
    _secret_tool(["clear", "service", KEYRING_SERVICE, KEYRING_ATTR, KEYRING_VALUE])


def store_api_key(raw: str) -> str:
    """Store the raw local key. Prefer the OS keyring; fall back to a 0600 file."""
    if keyring_store(raw):
        KEY_PATH.unlink(missing_ok=True)
        return "keyring"
    write_text(KEY_PATH, raw + "\n")
    return "file"


def load_api_key() -> str:
    value = keyring_load()
    if value:
        return value
    if KEY_PATH.is_file():
        try:
            return KEY_PATH.read_text(encoding="utf-8").strip()
        except OSError:
            return ""
    return ""


def clear_api_key() -> None:
    keyring_clear()
    KEY_PATH.unlink(missing_ok=True)


def key_source() -> str:
    if keyring_load():
        return "keyring"
    if KEY_PATH.is_file():
        return "file"
    if os.environ.get("HYPERROUTER_API_KEY") or os.environ.get("AGENT_ROUTER_API_KEY"):
        return "env"
    return "none"


def active_key_rows(conn: sqlite3.Connection) -> list[sqlite3.Row]:
    return list(conn.execute(
        "SELECT * FROM api_keys WHERE revoked=0 ORDER BY created_at DESC"
    ).fetchall())


def auth_required() -> bool:
    conn = connect()
    try:
        return bool(active_key_rows(conn))
    finally:
        conn.close()


def generate_api_key(label: str = "default", revoke_existing: bool = False) -> str:
    ensure_dirs()
    raw = KEY_PREFIX + secrets.token_urlsafe(32)
    digest = hash_api_key(raw)
    conn = connect()
    try:
        if revoke_existing:
            conn.execute("UPDATE api_keys SET revoked=1 WHERE revoked=0")
        else:
            active = active_key_rows(conn)
            if active:
                raise ValueError("an active router key already exists; use `hyperrouter keys rotate`")
        conn.execute(
            "INSERT INTO api_keys(id, label, key_hash, prefix, created_at, revoked) VALUES(?,?,?,?,?,0)",
            (str(uuid.uuid4()), label, digest, raw[:12], utc_now()),
        )
        conn.commit()
    finally:
        conn.close()
    store_api_key(raw)
    return raw


def verify_api_key(raw: str) -> bool:
    if not raw:
        return False
    digest = hash_api_key(raw)
    conn = connect()
    try:
        rows = active_key_rows(conn)
        if not rows:
            return True
        for row in rows:
            if hmac.compare_digest(str(row["key_hash"]), digest):
                conn.execute("UPDATE api_keys SET last_used=? WHERE id=?", (utc_now(), row["id"]))
                conn.commit()
                return True
        return False
    finally:
        conn.close()


def revoke_all_keys() -> int:
    conn = connect()
    try:
        rows = active_key_rows(conn)
        conn.execute("UPDATE api_keys SET revoked=1 WHERE revoked=0")
        conn.commit()
        count = len(rows)
    finally:
        conn.close()
    clear_api_key()
    return count


def upsert_marked_block(text: str, begin: str, end: str, body: str) -> str:
    block = f"{begin}\n{body.strip()}\n{end}"
    if begin in text and end in text:
        start = text.index(begin)
        stop = text.index(end, start) + len(end)
        tail = text[stop:]
        if tail.startswith("\n"):
            tail = tail[1:]
        return text[:start] + block + "\n" + tail
    if not text.strip():
        return block + "\n"
    return text.rstrip() + "\n\n" + block + "\n"


LEGACY_BLOCKS = (
    ("<!-- BEGIN agent-router (managed) -->", "<!-- END agent-router (managed) -->"),
    ("# BEGIN agent-router (managed)", "# END agent-router (managed)"),
)


def strip_legacy_blocks(text: str) -> str:
    """Drop managed blocks written before the hyperRouter rename."""
    for begin, end in LEGACY_BLOCKS:
        while True:
            start = text.find(begin)
            if start < 0:
                break
            stop = text.find(end, start)
            if stop < 0:
                break
            stop += len(end)
            while stop < len(text) and text[stop] == "\n":
                stop += 1
            text = text[:start] + text[stop:]
    return text


def strip_patch_items(text: str, item_ids: set[str]) -> str:
    """Remove top-level patch entries by id (used to retire the pre-rename DSH id)."""
    out: list[str] = []
    skip = False
    base_indent = 0
    for line in text.splitlines(keepends=True):
        match = re.match(r"^(\s*)- id:\s*(\S+)", line)
        if match:
            indent = len(match.group(1))
            if skip and indent > base_indent:
                continue
            skip = match.group(2) in item_ids
            if skip:
                base_indent = indent
                continue
        if skip:
            stripped = line.lstrip()
            if not stripped or stripped.startswith("#") or line.startswith(" " * (base_indent + 1)):
                if stripped.startswith(("# BEGIN", "# END")):
                    skip = False
                    out.append(line)
                continue
            skip = False
        out.append(line)
    return "".join(out)


def env_block() -> str:
    return """\
# Loads the hyperrouter local key from the OS keyring (or a 0600 file).
if [ -z "${HYPERROUTER_API_KEY:-}" ]; then
  if command -v secret-tool >/dev/null 2>&1; then
    HYPERROUTER_API_KEY="$(secret-tool lookup service hyperrouter key default 2>/dev/null)"
  fi
  if [ -z "${HYPERROUTER_API_KEY:-}" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/hyperrouter/api-key" ]; then
    HYPERROUTER_API_KEY="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/hyperrouter/api-key" 2>/dev/null)"
  fi
  export HYPERROUTER_API_KEY
fi
"""


def install_env_block(dry_run: bool = False) -> list[str]:
    actions: list[str] = []
    existing = strip_legacy_blocks(read_text(BASHRC_PATH))
    updated = upsert_marked_block(existing, ENV_BEGIN, ENV_END, env_block())
    if updated == existing:
        actions.append(f"shell: {BASHRC_PATH} already loads HYPERROUTER_API_KEY")
        return actions
    if not dry_run:
        backup(BASHRC_PATH)
        write_text(BASHRC_PATH, updated)
    actions.append(f"shell: {'would update' if dry_run else 'updated'} {BASHRC_PATH} (HYPERROUTER_API_KEY)")
    return actions


def remove_env_block(dry_run: bool = False) -> list[str]:
    existing = read_text(BASHRC_PATH)
    if ENV_BEGIN not in existing or ENV_END not in existing:
        return []
    start = existing.index(ENV_BEGIN)
    stop = existing.index(ENV_END, start) + len(ENV_END)
    head = existing[:start].rstrip()
    tail = existing[stop:]
    if tail.startswith("\n"):
        tail = tail[1:]
    updated = (head + "\n" + tail).lstrip("\n") if head else tail.lstrip("\n")
    if not dry_run:
        backup(BASHRC_PATH)
        write_text(BASHRC_PATH, updated)
    return [f"shell: {'would remove' if dry_run else 'removed'} HYPERROUTER_API_KEY block from {BASHRC_PATH}"]


