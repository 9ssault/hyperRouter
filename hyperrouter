def main(argv: Sequence[str] | None = None) -> int:
    os.umask(0o077)
    raw = list(sys.argv[1:] if argv is None else argv)
    if not raw:
        # Bare `hyperrouter` opens the agent TUI, the way freebuff/opencode do.
        raw = ["tui"]
    parser = build_parser()
    args = parser.parse_args(raw)
    if args.command == "serve":
        config = load_config()
        args.host = args.host or str(config.get("server", {}).get("host") or "127.0.0.1")
        args.port = args.port or int(config.get("server", {}).get("port") or 8787)
    try:
        return int(args.func(args))
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130
    except (ValueError, sqlite3.Error) as exc:
        die(str(exc))


if __name__ == "__main__":
    raise SystemExit(main())
