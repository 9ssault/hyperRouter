# Enabled by `setup` and `skills`-style bootstrap. Keyless servers come up working;
# keyed ones are registered but off until the named variable is exported.
DEFAULT_MCP_SERVERS = ["ddg", "playwright", "brave", "tavily", "exa", "firecrawl"]


def ensure_default_mcp() -> list[str]:
    config = load_config()
    block = config.setdefault("mcp", {"servers": {}, "timeout_seconds": 30,
                                      "max_tool_rounds": 3})
    servers = block.setdefault("servers", {})
    actions: list[str] = []
    for name in DEFAULT_MCP_SERVERS:
        preset = MCP_PRESETS.get(name) or {}
        requires = str(preset.get("requires") or "")
        enabled = not requires
        entry = {key: copy.deepcopy(value) for key, value in preset.items()
                 if key not in {"requires", "description"}}
        entry["enabled"] = enabled
        if name not in servers:
            servers[name] = entry
            actions.append(f"mcp: registered {name} ({'enabled' if enabled else 'off, needs ' + requires})")
        else:
            if "agent" in preset and servers[name].get("agent") != preset["agent"]:
                servers[name]["agent"] = preset["agent"]
                actions.append(f"mcp: {name} tools {'in' if preset['agent'] else 'out of'} the agent loop")
            if requires and not servers[name].get("enabled") and os.environ.get(requires):
                servers[name]["enabled"] = True
                actions.append(f"mcp: enabled {name} ({requires} is set)")
    save_config(config)
    if not actions:
        actions.append(f"mcp: {len(DEFAULT_MCP_SERVERS)} default servers already registered")
    return actions


class McpError(RuntimeError):
    pass


class McpClient:
    """Minimal stdio MCP client: initialize, tools/list, tools/call."""

    def __init__(self, config: dict[str, Any], timeout: float = 30.0):
        command = str(config.get("command") or "").strip()
        if not command:
            raise McpError("mcp server has no command")
        argv = [command, *[str(x) for x in (config.get("args") or [])]]
        env = os.environ.copy()
        env.update({str(k): str(v) for k, v in (config.get("env") or {}).items()})
        self.timeout = timeout
        self._id = 0
        try:
            self.proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, env=env, text=True,
                                         bufsize=1, cwd=str(Path.home()))
        except OSError as exc:
            raise McpError(f"could not start {argv[0]}: {exc}") from exc

    def _send(self, payload: dict[str, Any]) -> None:
        assert self.proc.stdin is not None
        self.proc.stdin.write(json.dumps(payload) + "\n")
        self.proc.stdin.flush()

    def _read(self) -> dict[str, Any]:
        assert self.proc.stdout is not None
        import select
        ready, _, _ = select.select([self.proc.stdout], [], [], self.timeout)
        if not ready:
            raise McpError(f"timed out after {self.timeout:.0f}s")
        line = self.proc.stdout.readline()
        if not line:
            raise McpError("server closed the connection")
        try:
            return json.loads(line)
        except json.JSONDecodeError as exc:
            raise McpError(f"invalid JSON from server: {line[:200]}") from exc

    def request(self, method: str, params: dict[str, Any] | None = None) -> Any:
        self._id += 1
        request_id = self._id
        self._send({"jsonrpc": "2.0", "id": request_id, "method": method,
                    "params": params or {}})
        while True:
            message = self._read()
            if message.get("id") != request_id:
                continue
            if "error" in message:
                error = message["error"] or {}
                raise McpError(f"{error.get('message') or error}")
            return message.get("result")

    def notify(self, method: str, params: dict[str, Any] | None = None) -> None:
        self._send({"jsonrpc": "2.0", "method": method, "params": params or {}})

    def initialize(self) -> dict[str, Any]:
        result = self.request("initialize", {
            "protocolVersion": MCP_PROTOCOL_VERSION,
            "capabilities": {},
            "clientInfo": {"name": PRODUCT, "version": VERSION},
        }) or {}
        self.notify("notifications/initialized")
        return result

    def list_tools(self) -> list[dict[str, Any]]:
        result = self.request("tools/list", {}) or {}
        return list(result.get("tools") or [])

    def call_tool(self, name: str, arguments: dict[str, Any]) -> Any:
        return self.request("tools/call", {"name": name, "arguments": arguments})

    def close(self) -> None:
        try:
            if self.proc.stdin:
                self.proc.stdin.close()
            self.proc.terminate()
            self.proc.wait(timeout=5)
        except (OSError, subprocess.SubprocessError):
            try:
                self.proc.kill()
            except OSError:
                pass

    def __enter__(self) -> "McpClient":
        self.initialize()
        return self

    def __exit__(self, *exc: Any) -> None:
        self.close()


def mcp_servers(config: dict[str, Any] | None = None) -> dict[str, dict[str, Any]]:
    config = config or load_config()
    servers = config.get("mcp", {}).get("servers") or {}
    return {str(k): dict(v) for k, v in servers.items() if isinstance(v, dict)}


MCP_SESSIONS: dict[str, McpClient] = {}
MCP_SESSION_USED: dict[str, float] = {}
MCP_SESSION_IDLE = 900.0
MCP_SESSION_LOCK = threading.RLock()


def mcp_call(server_name: str, tool: str, arguments: dict[str, Any],
             timeout: float = 60.0, persistent: bool = False) -> Any:
    servers = mcp_servers()
    server = servers.get(server_name)
    if not server:
        raise McpError(f"unknown MCP server: {server_name}")
    if not persistent:
        with McpClient(server, timeout=timeout) as client:
            return client.call_tool(tool, arguments)
    # A browser server keeps its page between calls, so reuse one process per turn.
    with MCP_SESSION_LOCK:
        client = MCP_SESSIONS.get(server_name)
        stale = time.monotonic() - MCP_SESSION_USED.get(server_name, 0.0) > MCP_SESSION_IDLE
        if client is not None and (client.proc.poll() is not None or stale):
            client.close()
            client = None
        if client is None:
            client = McpClient(server, timeout=timeout)
            MCP_SESSIONS[server_name] = client
        MCP_SESSION_USED[server_name] = time.monotonic()
        return client.call_tool(tool, arguments)


def close_mcp_sessions() -> None:
    with MCP_SESSION_LOCK:
        for client in MCP_SESSIONS.values():
            try:
                client.close()
            except Exception:  # noqa: BLE001
                pass
        MCP_SESSIONS.clear()
        MCP_SESSION_USED.clear()


def restart_mcp_sessions() -> None:
    close_mcp_sessions()
    MCP_AGENT_CACHE.update({"key": None, "ts": 0.0, "specs": [], "map": {}})


MCP_AGENT_CACHE: dict[str, Any] = {"key": None, "ts": 0.0, "specs": [], "map": {}}
MCP_CACHE_TTL = 300.0


def _mcp_tool_name(server: str, tool: str) -> str:
    raw = f"mcp__{server}__{tool}"
    cleaned = re.sub(r"[^A-Za-z0-9_-]", "_", raw)
    return cleaned[:64]


def mcp_agent_specs(config: dict[str, Any] | None = None,
                    force: bool = False) -> list[dict[str, Any]]:
    """Function specs for the tools of every enabled MCP server."""
    if os.environ.get("HYPERROUTER_NO_MCP"):
        return []
    config = config or load_config()
    mcp_cfg = config.get("mcp") or {}
    if not bool(mcp_cfg.get("agent", True)):
        return []
    servers = {name: server for name, server in mcp_servers(config).items()
               if server.get("enabled", True)
               and server.get("agent", (MCP_PRESETS.get(name) or {}).get("agent", True))}
    key = tuple(sorted(servers))
    now = time.time()
    if (not force and MCP_AGENT_CACHE.get("key") == key
            and now - float(MCP_AGENT_CACHE.get("ts") or 0) < MCP_CACHE_TTL):
        return list(MCP_AGENT_CACHE.get("specs") or [])

    def discover(name: str, server: dict[str, Any]) -> tuple[str, list[dict[str, Any]], str]:
        try:
            with McpClient(server, timeout=25.0) as client:
                listed = client.request("tools/list").get("tools") or []
            return name, [tool for tool in listed if isinstance(tool, dict)], ""
        except Exception as exc:  # noqa: BLE001 - a broken server must not block the loop
            return name, [], str(exc)

    specs: list[dict[str, Any]] = []
    mapping: dict[str, dict[str, Any]] = {}
    if servers:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(6, len(servers))) as pool:
            futures = [pool.submit(discover, name, server)
                       for name, server in servers.items()]
            for future in concurrent.futures.as_completed(futures, timeout=180):
                try:
                    name, tools, error = future.result()
                except Exception:  # noqa: BLE001
                    continue
                if error:
                    continue
                for tool in tools:
                    tool_name = str(tool.get("name") or "").strip()
                    if not tool_name:
                        continue
                    exposed = _mcp_tool_name(name, tool_name)
                    annotations = tool.get("annotations") or {}
                    readonly = bool(annotations.get("readOnlyHint", False)) if isinstance(
                        annotations, dict) else False
                    mapping[exposed] = {"server": name, "tool": tool_name,
                                       "readonly": readonly}
                    schema = tool.get("inputSchema")
                    if not isinstance(schema, dict):
                        schema = {"type": "object", "properties": {}}
                    description = str(tool.get("description") or "").strip()
                    specs.append({"type": "function", "function": {
                        "name": exposed,
                        "description": f"[{name}] {description[:700]}".strip(),
                        "parameters": schema,
                    }})
    MCP_AGENT_CACHE.update({"key": key, "ts": now, "specs": specs, "map": mapping})
    return specs


def _mcp_text(result: Any) -> str:
    if not isinstance(result, dict):
        return json.dumps(result, ensure_ascii=False, indent=2)
    items = result.get("content")
    if isinstance(items, list):
        parts = []
        for item in items:
            if isinstance(item, dict) and item.get("type") == "text":
                parts.append(str(item.get("text") or ""))
        if parts:
            return "\n".join(parts)
    return json.dumps(result, ensure_ascii=False, indent=2)


def cmd_mcp(args: argparse.Namespace) -> int:
    config = load_config()
    block = config.setdefault("mcp", {"servers": {}, "timeout_seconds": 30, "max_tool_rounds": 3})
    servers = block.setdefault("servers", {})
    action = args.action or "list"
    if action == "add-rea":
        servers["rea"] = copy.deepcopy(MCP_PRESETS["rea"])
        save_config(config)
        print(f"registered MCP server 'rea' -> {' '.join(MCP_PRESETS['rea']['args'])}")
        print(f"check it: {PROG} mcp tools rea")
        return 0
    if action == "defaults":
        for line in ensure_default_mcp():
            print(line)
        print(f"check them: {PROG} mcp list && {PROG} mcp tools ddg")
        return 0
    if action in {"restart", "update"}:
        restart_mcp_sessions()
        print("MCP sessions closed; tool schemas will be rediscovered on the next turn")
        if action == "update":
            print("npx packages are fetched with @latest on the next start, so this "
                  "also picks up server updates")
        return 0
    if action == "add":
        if not args.name:
            die("usage: hyperrouter mcp add <name|preset> [--command <cmd>] [--args \"...\"]")
        preset = {key: copy.deepcopy(value) for key, value in
                  (MCP_PRESETS.get(args.name, {}) or {}).items()
                  if key not in {"requires", "description"}}
        command = args.command or preset.get("command")
        if not command:
            die("--command is required (or use a preset name like 'ddg', 'playwright')")
        argv = args.args.split() if getattr(args, "args", None) else list(preset.get("args") or [])
        servers[args.name] = {"command": command, "args": argv,
                              "env": preset.get("env") or {},
                              "enabled": True}
        save_config(config)
        print(f"registered MCP server '{args.name}' -> {command} {' '.join(argv)}")
        requires = str((MCP_PRESETS.get(args.name) or {}).get("requires") or "")
        if requires:
            print(f"needs {requires} in the environment for its tools to work")
        return 0
    if action in {"remove", "enable", "disable"}:
        if not args.name:
            die(f"usage: hyperrouter mcp {action} <name>")
        if args.name not in servers:
            die(f"unknown MCP server: {args.name}")
        if action == "remove":
            servers.pop(args.name)
            save_config(config)
            print(f"removed MCP server '{args.name}'")
        else:
            servers[args.name]["enabled"] = action == "enable"
            save_config(config)
            print(f"{action}d MCP server '{args.name}'")
        return 0
    if not servers:
        print("No MCP servers configured.")
        print(f"Add REA:  {PROG} mcp add-rea")
        print(f"Or:       {PROG} mcp add <name> --command <cmd> --args \"...\"")
        return 0
    if action == "list":
        rows = []
        for name, server in sorted(servers.items()):
            rows.append({"name": name, "command": server.get("command"),
                         "args": server.get("args") or [],
                         "enabled": bool(server.get("enabled", True))})
        if args.json:
            print(json.dumps(rows, indent=2))
            return 0
        print(f"{'name':<14} {'on':<4} command")
        for row in rows:
            print(f"{row['name']:<14} {'yes' if row['enabled'] else 'no':<4} "
                  f"{row['command']} {' '.join(str(x) for x in row['args'])}")
        return 0
    target = args.name
    if not target:
        die("which server? e.g. hyperrouter mcp tools rea")
    server = servers.get(target)
    if not server:
        die(f"unknown MCP server: {target}")
    try:
        with McpClient(server, timeout=float(block.get("timeout_seconds") or 30)) as client:
            if action == "test":
                info = client.initialize()
                tools = client.list_tools()
                print(f"OK {target}: {len(tools)} tools, server={info.get('serverInfo')}")
                return 0
            if action == "tools":
                tools = client.list_tools()
                if args.json:
                    print(json.dumps(tools, indent=2))
                    return 0
                print(f"{'tool':<36} description")
                for tool in tools:
                    print(f"{str(tool.get('name'))[:36]:<36} {str(tool.get('description') or '')[:88]}")
                print(f"\n{len(tools)} tool(s) on {target}")
                return 0
            if action == "call":
                if not args.tool:
                    die("usage: hyperrouter mcp call <server> <tool> [--json '{}']")
                raw = args.json_args or "{}"
                try:
                    arguments = json.loads(raw)
                except json.JSONDecodeError as exc:
                    die(f"--json must be a JSON object: {exc}")
                result = client.call_tool(args.tool, arguments)
                print(_mcp_text(result))
                return 0
    except McpError as exc:
        die(f"mcp {target}: {exc}")
    die(f"unknown mcp action: {action}")


